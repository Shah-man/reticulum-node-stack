# Редактирование базы знаний бота
menu_knowledge_base() {
    local kb_dir="${BOT_HOME}/knowledge"
    local topics_file="$kb_dir/topics.json"
    local DEF=""

    while true; do
        # Собираем список файлов тем динамически
        local files=()
        local items=()
        local i=1
        for f in "$kb_dir"/*.txt; do
            if [ -f "$f" ]; then
                local fname=$(basename "$f")
                local fsize=$(du -h "$f" 2>/dev/null | cut -f1)
                local flines=$(wc -l < "$f" 2>/dev/null)
                files+=("$f")
                items+=( "$i" "${C_RETICULUM}${fname}\Zn  \Z7(${flines} строк, ${fsize})\Zn" )
                ((i++))
            fi
        done

        # Действия (буквы как в оригинале)
        items+=( "+" "${C_START}Добавить новую тему\Zn" )
        items+=( "k" "${C_GROUP}Ключевые слова (topics.json)\Zn" )
        items+=( "d" "${C_STOP}Удалить тему\Zn" )

        local STATUS
        if [ ${#files[@]} -eq 0 ]; then
            STATUS="\Z3Нет файлов тем\Zn"
        else
            STATUS="\Z4Файлов тем: ${#files[@]}\Zn"
        fi

        dlg_menu "БАЗА ЗНАНИЙ" "$STATUS" "$DEF" "${items[@]}"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"
        local choice="$DLG_CHOICE"

        clear
        case "$choice" in
            +)
                echo ""
                echo -e "${GRAY}(Enter или 0 = отмена)${NC}"
                echo -ne "${CYAN}Имя файла (без .txt): ${NC}"
                read -r newname
                if [ -z "$newname" ] || [ "$newname" == "0" ]; then
                    echo -e "${GRAY}Отменено${NC}"
                    sleep 1
                    continue
                fi
                local newfile="$kb_dir/${newname}.txt"
                echo "=== $(echo "$newname" | tr '[:lower:]' '[:upper:]') ===" > "$newfile"
                echo "" >> "$newfile"
                sudo nano "$newfile"
                echo -e "${GREEN}✓ Файл создан: ${newname}.txt${NC}"
                echo -e "${YELLOW}⚠ Не забудь добавить ключевые слова в topics.json!${NC}"
                sleep 2
                ;;
            k)
                echo ""
                echo -e "${CYAN}═══ КЛЮЧЕВЫЕ СЛОВА ═══${NC}"
                echo ""
                if [ -f "$topics_file" ]; then
                    cat "$topics_file" | python3 -m json.tool 2>/dev/null || cat "$topics_file"
                else
                    echo -e "${YELLOW}Файл topics.json не найден${NC}"
                fi
                echo ""
                echo -ne "${CYAN}Редактировать? (y/n): ${NC}"
                read -r edit_confirm
                if [[ "$edit_confirm" =~ ^[yYдД]$ ]]; then
                    sudo nano "$topics_file"
                    echo -e "${GREEN}✓ Сохранено${NC}"
                fi
                sleep 1
                ;;
            d)
                echo ""
                echo -ne "${RED}Номер файла для удаления (0=отмена): ${NC}"
                read -r del_num
                if [[ "$del_num" =~ ^[0-9]+$ ]] && [ "$del_num" -ge 1 ] && [ "$del_num" -le "${#files[@]}" ]; then
                    local del_file="${files[$((del_num-1))]}"
                    local del_name=$(basename "$del_file")
                    echo -ne "${RED}Удалить $del_name? (y/n): ${NC}"
                    read -r confirm
                    if [[ "$confirm" =~ ^[yYдД]$ ]]; then
                        rm -f "$del_file"
                        echo -e "${GREEN}✓ Удалено${NC}"
                        echo -e "${YELLOW}⚠ Не забудь убрать из topics.json!${NC}"
                        sleep 2
                    fi
                fi
                ;;
            *)
                # Редактирование выбранного файла
                if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#files[@]}" ]; then
                    local selected="${files[$((choice-1))]}"
                    sudo nano "$selected"
                    echo -e "${GREEN}✓ Сохранено${NC}"
                    sleep 1
                fi
                ;;
        esac
    done
}

# Редактирование кода бота (промпт и логика AI)
edit_bot_code() {
    local bot_file="${BOT_HOME}/cogs/ai.py"
    
    echo ""
    echo -e "${CYAN}═══ ПРОМПТ И ЛОГИКА БОТА ═══${NC}"
    echo ""
    
    if [ -f "$bot_file" ]; then
        local lines=$(wc -l < "$bot_file")
        local size=$(du -h "$bot_file" | cut -f1)
        echo -e "  📄 Файл: ${WHITE}$bot_file${NC}"
        echo -e "  📊 Строк: ${WHITE}$lines${NC}  Размер: ${WHITE}$size${NC}"
        echo ""
    else
        echo -e "  ${RED}✗ Файл не найден!${NC}"
        press_enter
        return
    fi
    
    echo -e "${YELLOW}⚠ Внимание: изменение кода может сломать бота!${NC}"
    echo -e "${GRAY}Открываю nano для редактирования...${NC}"
    echo -e "${GRAY}(Ctrl+O сохранить, Ctrl+X выход)${NC}"
    sleep 1
    
    sudo nano "$bot_file"
    
    echo ""
    echo -e "${GREEN}✓ Редактирование завершено${NC}"
    echo -e "${YELLOW}Не забудь перезапустить бота для применения изменений!${NC}"
    press_enter
}

# Редактирование настроек бота (.env)
edit_bot_settings() {
    local env_file="${BOT_HOME}/.env"
    
    echo ""
    echo -e "${CYAN}═══ НАСТРОЙКИ БОТА (.env) ═══${NC}"
    echo ""
    
    if [ -f "$env_file" ]; then
        echo -e "${WHITE}Текущие настройки:${NC}"
        echo ""
        while IFS='=' read -r key value; do
            [[ -z "$key" || "$key" =~ ^# ]] && continue
            case "$key" in
                BOT_NAME) echo -e "  📛 Имя бота: ${WHITE}$value${NC}" ;;
                ADMIN_HASHES) echo -e "  👑 Админ: ${WHITE}${value:0:16}...${NC}" ;;
                OLLAMA_MODEL) echo -e "  🤖 Модель: ${WHITE}$value${NC}" ;;
                MAX_HISTORY) echo -e "  💾 Память: ${WHITE}$value сообщений${NC}" ;;
                ANNOUNCE_INTERVAL) echo -e "  📢 Анонс: ${WHITE}$((value/60)) мин${NC}" ;;
                RATE_LIMIT) echo -e "  ⏱️ Лимит: ${WHITE}$value сообщ/мин${NC}" ;;
                COOLDOWN) echo -e "  ⏳ Кулдаун: ${WHITE}$value сек${NC}" ;;
                PROPAGATION_NODE) echo -e "  📡 Propagation: ${WHITE}${value:0:16}...${NC}" ;;
            esac
        done < "$env_file"
        echo ""
    else
        echo -e "  ${RED}✗ Файл не найден!${NC}"
        press_enter
        return
    fi
    
    echo -e "${GRAY}Открываю nano для редактирования...${NC}"
    echo -e "${GRAY}(Ctrl+O сохранить, Ctrl+X выход)${NC}"
    sleep 1
    
    sudo nano "$env_file"
    
    echo ""
    echo -e "${GREEN}✓ Редактирование завершено${NC}"
    echo -e "${YELLOW}Не забудь перезапустить бота для применения изменений!${NC}"
    press_enter
}

# ══════════════════════════════════════════════════════════════════
# УПРАВЛЕНИЕ ДОВЕРЕННЫМИ ПОЛЬЗОВАТЕЛЯМИ
# ══════════════════════════════════════════════════════════════════

# Меню логов сообщений бота (УЛУЧШЕННАЯ ВЕРСИЯ)
menu_bot_logs() {
    local logs_dir="${BOT_HOME}/logs"
    local msg_log="$logs_dir/messages.log"
    local DEF=""

    while true; do
        # Статистика логов в шапку (без эмодзи, с \Z-цветами)
        local STATUS=""
        if [ -d "$logs_dir" ]; then
            if [ -f "$logs_dir/admin.log" ]; then
                local admin_size=$(du -h "$logs_dir/admin.log" 2>/dev/null | cut -f1)
                local admin_lines=$(wc -l < "$logs_dir/admin.log" 2>/dev/null || echo "0")
                STATUS="${STATUS}\Z7admin.log:\Zn ${admin_lines} строк (${admin_size})\n"
            else
                STATUS="${STATUS}\Z7admin.log:\Zn \Z3не создан\Zn\n"
            fi
            if [ -f "$msg_log" ]; then
                local msg_size=$(du -h "$msg_log" 2>/dev/null | cut -f1)
                local msg_lines=$(wc -l < "$msg_log" 2>/dev/null || echo "0")
                local unique_users=$(cut -d'|' -f3 "$msg_log" 2>/dev/null | tr -d ' ' | sort -u | wc -l)
                STATUS="${STATUS}\Z7messages.log:\Zn ${msg_lines} строк (${msg_size})\n"
                STATUS="${STATUS}\Z7Уникальных пользователей:\Zn ${unique_users}\n"
            else
                STATUS="${STATUS}\Z7messages.log:\Zn \Z3не создан\Zn\n"
            fi
            STATUS="${STATUS}\Z7Хранение: 19 дней, затем автоочистка\Zn"
        else
            STATUS="\Z3Директория логов не создана\Zn\nЛоги появятся после первого сообщения боту"
        fi

        dlg_menu "ЛОГИ СООБЩЕНИЙ" "$STATUS" "$DEF" \
            "1" "${C_RETICULUM}Логи админа (мои)\Zn" \
            "2" "${C_START}Список пользователей\Zn" \
            "3" "${C_GROUP}Поиск по нику\Zn" \
            "4" "${C_NOMADNET}Поиск по адресу\Zn" \
            "5" "${C_ENV}Все сообщения\Zn" \
            "6" "${C_STOP}Очистить все логи\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) view_admin_logs ;;
            2) show_users_list ;;
            3) search_by_nick ;;
            4) search_by_address ;;
            5) show_last_messages ;;
            6)
                if verify_pin "очистить логи"; then
                    if dlg_confirm "\nУдалить все логи сообщений?"; then
                        rm -f "$logs_dir/admin.log" "$logs_dir/messages.log" 2>/dev/null
                        dlg_msg "\n\Z2✓ Логи очищены\Zn"
                    fi
                fi
                ;;
            *) ;;
        esac
    done
}

# Показать список пользователей
show_users_list() {
    local msg_log="${BOT_HOME}/logs/messages.log"
    
    while true; do
        print_header
        echo -e "${WHITE}${BOLD}  👥 СПИСОК ПОЛЬЗОВАТЕЛЕЙ${NC}"
        print_line
        echo ""
        
        if [ ! -f "$msg_log" ]; then
            echo -e "  ${YELLOW}Лог не найден${NC}"
            press_enter
            return
        fi
        
        # Получаем уникальные адреса с количеством сообщений
        local users=()
        local i=1
        
        # Читаем в массив без подпроцесса
        while IFS= read -r line; do
            local hash=$(echo "$line" | cut -d' ' -f1)
            local count=$(echo "$line" | cut -d' ' -f2)
            local nick=$(get_user_nick "$hash")
            users+=("$hash")
            
            # Цветовая индикация активности
            local color="${GRAY}"
            if [ "$count" -gt 100 ]; then
                color="${LIGHT_GREEN}"
            elif [ "$count" -gt 50 ]; then
                color="${LIGHT_CYAN}"
            elif [ "$count" -gt 10 ]; then
                color="${WHITE}"
            fi
            
            printf "  ${LIGHT_CYAN}[%2d]${NC} ${WHITE}%s${NC} ${GRAY}[%s]${NC} ${color}%d сообщ.${NC}\n" "$i" "$nick" "$hash" "$count"
            ((i++))
        done < <(cut -d'|' -f3 "$msg_log" 2>/dev/null | tr -d ' ' | sort | uniq -c | sort -rn | awk '{print $2, $1}')
        
        if [ ${#users[@]} -eq 0 ]; then
            echo -e "  ${YELLOW}Пользователей не найдено${NC}"
            press_enter
            return
        fi
        
        echo ""
        print_line
        echo -e "  ${GRAY}Введи номер для просмотра переписки${NC}"
        echo -e "  ${GRAY}[0/Enter/ESC]${NC} ${GRAY}← Назад${NC}"
        echo ""
        
        echo -ne "${CYAN}Номер: ${NC}"
        local choice=$(read_number_or_esc)
        echo ""
        
        if [[ "$choice" == "ESC" ]] || [[ "$choice" == "0" ]] || [[ -z "$choice" ]]; then
            return
        fi
        
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#users[@]}" ]; then
            local selected_hash="${users[$((choice-1))]}"
            view_user_messages "$selected_hash"
        fi
    done
}

# Просмотр сообщений пользователя с пагинацией
view_user_messages() {
    local user_hash="$1"
    local msg_log="${BOT_HOME}/logs/messages.log"
    local nick=$(get_user_nick "$user_hash")
    local page_size=20
    
    if [ ! -f "$msg_log" ]; then
        echo -e "  ${YELLOW}Лог не найден${NC}"
        press_enter
        return
    fi
    
    # Создаём временный файл с сообщениями пользователя
    local tmp_file="/tmp/user_messages_$$"
    grep "$user_hash" "$msg_log" > "$tmp_file"
    
    local total_lines=$(wc -l < "$tmp_file")
    if [ "$total_lines" -eq 0 ]; then
        echo -e "  ${YELLOW}Сообщений не найдено${NC}"
        rm -f "$tmp_file"
        press_enter
        return
    fi
    
    local total_pages=$(( (total_lines + page_size - 1) / page_size ))
    local current_page=$total_pages  # Начинаем с последней страницы (новые сообщения)
    
    while true; do
        clear
        echo ""
        echo -e "${CYAN}═══ 💬 ПЕРЕПИСКА С ${WHITE}${nick}${CYAN} ═══${NC}"
        echo -e "${GRAY}Адрес: ${user_hash}${NC}"
        echo -e "${GRAY}Всего: $total_lines сообщений | Страница $current_page/$total_pages${NC}"
        echo -e "${GRAY}[n] след. | [p] пред. | [f] первая | [l] последняя | [q/0/ESC] выход${NC}"
        print_line
        echo ""
        
        local start_line=$(( (current_page - 1) * page_size + 1 ))
        local today=$(date '+%Y-%m-%d')
        
        sed -n "${start_line},+$((page_size - 1))p" "$tmp_file" | while IFS='|' read -r datetime direction hash message; do
            datetime=$(echo "$datetime" | xargs)
            direction=$(echo "$direction" | xargs)
            message=$(echo "$message" | xargs)
            
            # Форматируем дату
            local msg_date=$(echo "$datetime" | cut -d' ' -f1)
            local msg_time=$(echo "$datetime" | cut -d' ' -f2)
            
            if [ "$msg_date" == "$today" ]; then
                local time_display="      $msg_time"
            else
                local time_display="$msg_date $msg_time"
            fi
            
            if [ "$direction" == "IN" ]; then
                echo -e "${GRAY}$time_display${NC}"
                echo -e "  ${LIGHT_BLUE}👤 $nick:${NC} $message"
            else
                echo -e "${GRAY}$time_display${NC}"
                echo -e "  ${LIGHT_GREEN}🤖 Bot:${NC} $message"
            fi
            echo ""
        done
        
        echo ""
        print_line
        echo -ne "${CYAN}Выбор: ${NC}"
        local choice=$(read_key)
        
        if [[ "$choice" == "ESC" ]] || [[ "$choice" == "0" ]] || [[ "$choice" == "q" ]] || [[ "$choice" == "Q" ]]; then
            rm -f "$tmp_file"
            return
        fi
        
        choice=$(convert_ru_to_en "$choice")
        
        case $choice in
            n|N) 
                if [ "$current_page" -lt "$total_pages" ]; then
                    ((current_page++))
                fi
                ;;
            p|P)
                if [ "$current_page" -gt 1 ]; then
                    ((current_page--))
                fi
                ;;
            f|F) current_page=1 ;;
            l|L) current_page=$total_pages ;;
            *) ;;
        esac
    done
}

# Поиск по нику
search_by_nick() {
    local msg_log="${BOT_HOME}/logs/messages.log"

    local search_nick
    search_nick=$(dialog --colors \
        --backtitle "RETICULUM CONTROL" \
        --title " ПОИСК ПО НИКУ " \
        --inputbox "\nВведите ник для поиска:" 9 50 \
        3>&1 1>&2 2>&3)
    local rc=$?
    clear
    [ $rc -ne 0 ] && return          # отмена
    [ -z "$search_nick" ] && return

    print_header
    echo -e "${WHITE}${BOLD}  РЕЗУЛЬТАТЫ ПОИСКА: '$search_nick'${NC}"
    print_line
    echo ""
    
    # Ищем адреса по нику в data.cfg
    local found=0
    while IFS='=' read -r hash nick_found; do
        hash=$(echo "$hash" | xargs)
        nick_found=$(echo "$nick_found" | xargs)
        
        if echo "$nick_found" | grep -qi "$search_nick"; then
            echo -e "${WHITE}Найден: ${LIGHT_CYAN}$nick_found${NC} ${GRAY}[$hash]${NC}"
            echo ""
            
            # Показываем последние сообщения
            if [ -f "$msg_log" ]; then
                local count=$(grep -c "$hash" "$msg_log" 2>/dev/null || echo "0")
                echo -e "${GRAY}Сообщений: $count${NC}"
                echo ""
                
                grep "$hash" "$msg_log" | tail -10 | while IFS='|' read -r datetime direction h message; do
                    datetime=$(echo "$datetime" | xargs)
                    direction=$(echo "$direction" | xargs)
                    message=$(echo "$message" | xargs | cut -c1-60)
                    
                    if [ "$direction" == "IN" ]; then
                        echo -e "  ${LIGHT_BLUE}→${NC} $datetime: $message"
                    else
                        echo -e "  ${LIGHT_GREEN}←${NC} $datetime: $message"
                    fi
                done
            fi
            
            echo ""
            print_line
            found=1
        fi
    done < <(grep -v '^\[' /root/.config/lxmf_distribution_group_extended/data.cfg 2>/dev/null | grep '=')
    
    if [ $found -eq 0 ]; then
        echo -e "${YELLOW}Ничего не найдено по запросу '$search_nick'${NC}"
    fi
    
    press_enter
}

# Поиск по адресу
search_by_address() {
    local msg_log="${BOT_HOME}/logs/messages.log"

    local search_addr
    search_addr=$(dialog --colors \
        --backtitle "RETICULUM CONTROL" \
        --title " ПОИСК ПО АДРЕСУ " \
        --inputbox "\nВведите полный адрес или часть (минимум 8 символов):" 10 56 \
        3>&1 1>&2 2>&3)
    local rc=$?
    clear
    [ $rc -ne 0 ] && return          # отмена
    [ -z "$search_addr" ] && return

    if [ ${#search_addr} -lt 8 ]; then
        dlg_msg "\n\Z1Минимум 8 символов!\Zn"
        return
    fi

    print_header
    echo -e "${WHITE}${BOLD}  РЕЗУЛЬТАТЫ ПОИСКА: '$search_addr'${NC}"
    print_line
    echo ""
    
    if [ ! -f "$msg_log" ]; then
        echo -e "${YELLOW}Лог не найден${NC}"
        press_enter
        return
    fi
    
    # Ищем по адресу
    local matches=$(grep -i "$search_addr" "$msg_log" 2>/dev/null | head -1 | cut -d'|' -f3 | xargs)
    
    if [ -n "$matches" ]; then
        local nick=$(get_user_nick "$matches")
        local count=$(grep -c "$matches" "$msg_log" 2>/dev/null || echo "0")
        
        echo -e "${WHITE}Найден: ${LIGHT_CYAN}$nick${NC}"
        echo -e "${GRAY}Адрес: $matches${NC}"
        echo -e "${GRAY}Сообщений: $count${NC}"
        echo ""
        print_line
        echo ""
        
        # Показываем последние сообщения
        grep "$matches" "$msg_log" | tail -20 | while IFS='|' read -r datetime direction hash message; do
            datetime=$(echo "$datetime" | xargs)
            direction=$(echo "$direction" | xargs)
            message=$(echo "$message" | xargs)
            
            if [ "$direction" == "IN" ]; then
                echo -e "${GRAY}$datetime${NC}"
                echo -e "  ${LIGHT_BLUE}👤 $nick:${NC} $message"
            else
                echo -e "${GRAY}$datetime${NC}"
                echo -e "  ${LIGHT_GREEN}🤖 Bot:${NC} $message"
            fi
            echo ""
        done
    else
        echo -e "${YELLOW}Ничего не найдено по адресу '$search_addr'${NC}"
    fi
    
    press_enter
}

# Показать все сообщения с пагинацией
show_last_messages() {
    local msg_log="${BOT_HOME}/logs/messages.log"
    local page_size=20
    
    if [ ! -f "$msg_log" ]; then
        echo -e "${YELLOW}Лог не найден${NC}"
        press_enter
        return
    fi
    
    local total_lines=$(wc -l < "$msg_log")
    if [ "$total_lines" -eq 0 ]; then
        echo -e "${YELLOW}Лог пуст${NC}"
        press_enter
        return
    fi
    
    local total_pages=$(( (total_lines + page_size - 1) / page_size ))
    local current_page=$total_pages  # Начинаем с последней страницы
    
    while true; do
        clear
        echo ""
        echo -e "${CYAN}═══ 📜 ВСЕ СООБЩЕНИЯ ═══${NC}"
        echo -e "${GRAY}Всего: $total_lines сообщений | Страница $current_page/$total_pages${NC}"
        echo -e "${GRAY}[n] след. | [p] пред. | [f] первая | [l] последняя | [0] выход${NC}"
        print_line
        echo ""
        
        local start_line=$(( (current_page - 1) * page_size + 1 ))
        
        sed -n "${start_line},+$((page_size - 1))p" "$msg_log" | while IFS='|' read -r datetime direction hash message; do
            datetime=$(echo "$datetime" | xargs)
            direction=$(echo "$direction" | xargs)
            hash=$(echo "$hash" | xargs)
            message=$(echo "$message" | xargs)
            
            local nick=$(get_user_nick "$hash")
            
            # Форматируем дату
            local msg_date=$(echo "$datetime" | cut -d' ' -f1)
            local msg_time=$(echo "$datetime" | cut -d' ' -f2 | cut -c1-5)
            
            if [ "$direction" == "IN" ]; then
                echo -e "${GRAY}$msg_date $msg_time${NC} ${LIGHT_BLUE}$nick${NC} ${GRAY}[$hash]${NC}"
                echo -e "  ${GRAY}→${NC} $message"
            else
                echo -e "${GRAY}$msg_date $msg_time${NC} ${LIGHT_GREEN}Bot${NC} ${GRAY}→ $nick${NC}"
                echo -e "  ${GRAY}←${NC} $message"
            fi
            echo ""
        done
        
        echo ""
        print_line
        echo -ne "${CYAN}Выбор: ${NC}"
        local choice=$(read_key)
        
        if [[ "$choice" == "ESC" ]] || [[ "$choice" == "0" ]]; then
            return
        fi
        
        choice=$(convert_ru_to_en "$choice")
        
        case $choice in
            n|N) 
                if [ "$current_page" -lt "$total_pages" ]; then
                    ((current_page++))
                fi
                ;;
            p|P)
                if [ "$current_page" -gt 1 ]; then
                    ((current_page--))
                fi
                ;;
            f|F) current_page=1 ;;
            l|L) current_page=$total_pages ;;
            *) ;;
        esac
    done
}

