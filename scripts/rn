}

menu_group() {
    local service="$GROUP_SERVICE"
    local name="${SERVICE_NAMES[$service]}"
    local clean_name=$(printf '%s' "$name" | sed -E 's/^[^[:alnum:]A-Za-zА-Яа-я]+[[:space:]]*//')
    local config_path="/root/.config/lxmf_distribution_group_extended"
    local DEF=""

    while true; do
        local st=$(get_service_status "$service")
        local STATUS
        if [ "$st" = "active" ]; then
            STATUS="\Z2● ${clean_name} [работает]\Zn"
        else
            STATUS="\Z1● ${clean_name} [остановлен]\Zn"
        fi

        dlg_menu "$clean_name" "$STATUS" "$DEF" \
            "1"  "${C_START}Запустить\Zn" \
            "2"  "${C_STOP}Остановить\Zn" \
            "3"  "${C_RESTART}Перезапустить\Zn" \
            "4"  "${C_MON}Показать логи\Zn" \
            "5"  "${C_NOMADNET}Подробный статус\Zn" \
            "6"  "${C_GROUP}Участники группы\Zn" \
            "7"  "${C_BOARD}Закреплённое сообщение\Zn" \
            "8"  "${C_ENV}Статистика группы\Zn" \
            "9"  "${C_START}Отправить сообщение\Zn" \
            "d"  "${C_STOP}Редактировать data.cfg\Zn" \
            "c"  "${C_GROUP}Редактировать config.cfg\Zn" \
            "o"  "${C_RESTART}Редактировать config.cfg.owr\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) start_service "$service"; press_enter ;;
            2) 
                if verify_pin "остановить группу"; then
                    stop_service "$service"
                    press_enter
                fi
                ;;
            3) restart_service "$service"; press_enter ;;
            4)
                echo ""
                echo -e "${CYAN}═══ ЛОГИ: $clean_name (Ctrl+C для выхода) ═══${NC}"
                sudo journalctl -u "$service" -f --no-pager -n 50
                ;;
            5)
                echo ""
                sudo systemctl status "$service"
                press_enter
                ;;
            6) show_group_members ;;
            7) show_group_pin ;;
            8) show_group_stats ;;
            9) send_message_menu ;;
            d)
                if verify_pin "редактировать data.cfg"; then
                    edit_group_config
                fi
                ;;
            c)
                if verify_pin "редактировать config.cfg"; then
                    edit_surgut_config_cfg
                fi
                ;;
            o)
                if verify_pin "редактировать config.cfg.owr"; then
                    edit_group_settings
                fi
                ;;
            *) ;;
        esac
    done
}

# ══════════════════════════════════════════════════════════════════
# ПОДМЕНЮ: ОТПРАВКА СООБЩЕНИЯ / ВЕЩАТЕЛЬ
# ══════════════════════════════════════════════════════════════════

# Получить LXMF-хеш вещателя из его identity-файла
get_broadcaster_hash() {
    "$VENV_PATH/bin/rnid" -i "$BROADCASTER_IDENTITY" -H lxmf.delivery 2>/dev/null \
        | grep -oiE "is <[0-9a-f]{32}>" | grep -oiE "[0-9a-f]{32}" | head -1
}

# Подменю «Отправить сообщение»
send_message_menu() {
    while true; do
        clear
        echo ""
        echo -e "${CYAN}═══ ОТПРАВКА СООБЩЕНИЯ В ГРУППУ ═══${NC}"
        echo ""

        # Краткий статус вещателя
        if [ -f "$BROADCASTER_IDENTITY" ]; then
            local b_hash=$(get_broadcaster_hash)
            echo -e "  Вещатель: ${GREEN}${BROADCASTER_NAME}${NC}"
            echo -e "  Адрес:    ${GRAY}${b_hash}${NC}"
        else
            echo -e "  Вещатель: ${RED}не найден${NC} ${GRAY}(нужно пересоздать)${NC}"
        fi
        echo ""
        print_line
        echo -e "  ${LIGHT_GREEN}[1]${NC} ✉️  ${LIGHT_GREEN}Отправить сообщение${NC}"
        echo -e "  ${YELLOW}[2]${NC} ♻️  ${YELLOW}Пересоздать вещателя${NC}"
        echo -e "  ${LIGHT_BLUE}[3]${NC} 💾 ${LIGHT_BLUE}Бэкап identity вещателя${NC}"
        echo -e "  ${LIGHT_PURPLE}[4]${NC} ⏮️  ${LIGHT_PURPLE}Восстановить из бэкапа${NC}"
        print_line
        echo -e "  ${GRAY}[0]${NC} ${GRAY}← Назад / Enter / ESC${NC}"
        echo ""

        echo -ne "${CYAN}Выбор: ${NC}"
        local choice=$(read_key)
        echo "$choice"

        # ESC или Enter (пустой ввод) — назад, ДО конвертации раскладки
        if [[ "$choice" == "ESC" ]] || [[ -z "$choice" ]]; then
            return
        fi

        choice=$(convert_ru_to_en "$choice" 2>/dev/null)

        case $choice in
            1)
                if verify_pin "отправить сообщение"; then
                    send_group_message
                fi
                ;;
            2)
                if verify_pin "пересоздать вещателя"; then
                    recreate_broadcaster
                    press_enter
                fi
                ;;
            3)
                backup_broadcaster_identity
                press_enter
                ;;
            4)
                if verify_pin "восстановить вещателя из бэкапа"; then
                    restore_broadcaster
                    press_enter
                fi
                ;;
            0) return ;;
            q|Q) echo -e "\n${CYAN}Скрипт завершён.${NC}\n"; exit 0 ;;
            *) ;;
        esac
    done
}

# Бэкап identity вещателя (с показом существующих + ротация)
backup_broadcaster_identity() {
    echo ""
    echo -e "${CYAN}═══ БЭКАП IDENTITY ВЕЩАТЕЛЯ ═══${NC}"
    echo ""

    if [ ! -f "$BROADCASTER_IDENTITY" ]; then
        echo -e "${RED}✗ Файл вещателя не найден:${NC} $BROADCASTER_IDENTITY"
        echo -e "${GRAY}Сначала создай вещателя через «Пересоздать вещателя».${NC}"
        return
    fi

    # Показываем существующие бэкапы
    local existing=$(ls -1t "$BROADCASTER_DIR"/broadcaster.identity.bak-* 2>/dev/null)
    if [ -n "$existing" ]; then
        echo -e "${WHITE}Существующие бэкапы:${NC}"
        while IFS= read -r f; do
            echo -e "  ${GRAY}$(basename "$f")${NC}"
        done <<< "$existing"
    else
        echo -e "${GRAY}Бэкапов пока нет.${NC}"
    fi
    echo ""

    echo -ne "${WHITE}Создать новый бэкап? (Enter = да, n = нет): ${NC}"
    local ans
    read -r ans
    if [[ "$ans" =~ ^[nNтТ] ]]; then
        echo -e "${GRAY}Отменено.${NC}"
        return
    fi

    # Создаём бэкап с датой и временем
    local stamp=$(date +%Y-%m-%d_%H-%M-%S)
    local backup_file="${BROADCASTER_DIR}/broadcaster.identity.bak-${stamp}"
    if cp "$BROADCASTER_IDENTITY" "$backup_file" 2>/dev/null; then
        echo ""
        echo -e "${GREEN}✓ Бэкап создан:${NC}"
        echo -e "  Путь: ${GRAY}${BROADCASTER_DIR}/${NC}"
        echo -e "  Файл: ${WHITE}broadcaster.identity.bak-${stamp}${NC}"
    else
        echo -e "${RED}✗ Не удалось создать бэкап${NC}"
        return
    fi

    # Ротация: оставляем последние BROADCASTER_BACKUP_KEEP
    local count=$(ls -1 "$BROADCASTER_DIR"/broadcaster.identity.bak-* 2>/dev/null | wc -l)
    if [ "$count" -gt "$BROADCASTER_BACKUP_KEEP" ]; then
        local to_delete=$(ls -1t "$BROADCASTER_DIR"/broadcaster.identity.bak-* 2>/dev/null | tail -n +$((BROADCASTER_BACKUP_KEEP + 1)))
        while IFS= read -r f; do
            rm -f "$f" 2>/dev/null
            echo -e "${GRAY}  Удалён старый бэкап: $(basename "$f")${NC}"
        done <<< "$to_delete"
    fi
}

# Пересоздать вещателя (самоналаживающая процедура)
# Генерит новый identity, прописывает роль broadcaster в config.cfg
# Прописать хеш вещателя в группу: роль broadcaster в config.cfg +
# секция [broadcaster] в data.cfg. Вызывается из пересоздания и восстановления.
# Аргумент: $1 = LXMF-хеш вещателя
apply_broadcaster_to_group() {
    local b_hash="$1"
    local config_file="${GROUP_CONFIG}/config.cfg"
    local data_file="${GROUP_CONFIG}/data.cfg"

    # Роль broadcaster в config.cfg (если её нет)
    if grep -qE "^broadcaster\s*=" "$config_file"; then
        echo -e "${GRAY}→ Роль broadcaster уже есть в config.cfg${NC}"
    else
        echo -e "${YELLOW}→ Добавляю роль broadcaster в config.cfg...${NC}"
        local admin_line=$(grep -nE "^admin\s*=\s*interface" "$config_file" | head -1 | cut -d: -f1)
        if [ -n "$admin_line" ]; then
            sed -i "${admin_line}a broadcaster = send_local,anonymous" "$config_file"
        else
            sed -i "/^\[rights\]/a broadcaster = send_local,anonymous" "$config_file"
        fi
    fi

    # Секция [broadcaster] в data.cfg с нужным хешем
    echo -e "${YELLOW}→ Обновляю секцию [broadcaster] в data.cfg...${NC}"
    python3 - "$data_file" "$b_hash" "$BROADCASTER_NAME" << 'PYEOF'
import sys, re
data_file, new_hash, name = sys.argv[1], sys.argv[2], sys.argv[3]
with open(data_file, "r", encoding="utf-8") as f:
    text = f.read()

new_section = "[broadcaster]\n{} = {}\n\n".format(new_hash, name)

# Находим существующую секцию [broadcaster] и заменяем её содержимое целиком
pattern = re.compile(r"\[broadcaster\]\s*\n(?:(?!\[).*\n?)*", re.MULTILINE)
if pattern.search(text):
    text = pattern.sub(new_section, text, count=1)
else:
    # Секции нет — добавляем после [admin]-блока, либо в конец файла
    m = re.search(r"\[admin\]\s*\n(?:(?!\[).*\n?)*", text)
    if m:
        insert_at = m.end()
        text = text[:insert_at] + "\n" + new_section + text[insert_at:]
    else:
        if not text.endswith("\n"):
            text += "\n"
        text += "\n" + new_section

# Убираем случайные тройные переводы строк
text = re.sub(r"\n{3,}", "\n\n", text)

with open(data_file, "w", encoding="utf-8") as f:
    f.write(text)
print("OK")
PYEOF
}

# Ротация бэкапов вещателя (оставляем последние BROADCASTER_BACKUP_KEEP)
rotate_broadcaster_backups() {
    local count=$(ls -1 "$BROADCASTER_DIR"/broadcaster.identity.bak-* 2>/dev/null | wc -l)
    if [ "$count" -gt "$BROADCASTER_BACKUP_KEEP" ]; then
        ls -1t "$BROADCASTER_DIR"/broadcaster.identity.bak-* 2>/dev/null | tail -n +$((BROADCASTER_BACKUP_KEEP + 1)) | while IFS= read -r f; do
            rm -f "$f" 2>/dev/null
        done
    fi
}

# и секцию [broadcaster] в data.cfg, перезапускает группу.
recreate_broadcaster() {
    echo ""
    echo -e "${CYAN}═══ ПЕРЕСОЗДАНИЕ ВЕЩАТЕЛЯ ═══${NC}"
    echo ""
    echo -e "${GRAY}Процедура заново создаёт служебного отправителя и прописывает${NC}"
    echo -e "${GRAY}его в группу. Используй, если отправка перестала работать.${NC}"
    echo ""

    # Показываем текущий адрес и просим подтверждение
    if [ -f "$BROADCASTER_IDENTITY" ]; then
        local cur_hash=$(get_broadcaster_hash)
        echo -e "${WHITE}Текущий вещатель:${NC} ${GRAY}${cur_hash}${NC}"
        echo -e "${RED}Внимание: текущий адрес будет заменён новым.${NC}"
    fi
    echo ""
    echo -ne "${WHITE}Точно пересоздать вещателя? (y = да, n/Enter = нет): ${NC}"
    local confirm
    read -r confirm
    if [[ ! "$confirm" =~ ^[yYнН] ]]; then
        echo -e "${GRAY}Отменено.${NC}"
        return
    fi
    echo ""

    local config_file="${GROUP_CONFIG}/config.cfg"
    local data_file="${GROUP_CONFIG}/data.cfg"

    # Проверка наличия конфигов группы
    if [ ! -f "$config_file" ] || [ ! -f "$data_file" ]; then
        echo -e "${RED}✗ Конфиги группы не найдены в ${GROUP_CONFIG}${NC}"
        return 1
    fi

    # 1. Останавливаем группу
    echo -e "${YELLOW}→ Останавливаю группу...${NC}"
    systemctl stop "$GROUP_SERVICE"
    sleep 1

    # 2. Бэкап старого identity вещателя (если был)
    if [ -f "$BROADCASTER_IDENTITY" ]; then
        local stamp=$(date +%Y-%m-%d_%H-%M-%S)
        cp "$BROADCASTER_IDENTITY" "${BROADCASTER_DIR}/broadcaster.identity.bak-${stamp}" 2>/dev/null \
            && echo -e "${GRAY}→ Бэкап старого identity: broadcaster.identity.bak-${stamp}${NC}"
    fi

    # 3. Генерируем новый identity вещателя
    echo -e "${YELLOW}→ Генерирую новый identity вещателя...${NC}"
    mkdir -p "$BROADCASTER_DIR"
    # rnid -g не перезаписывает существующий файл — удаляем старый
    # (бэкап уже сделан выше)
    rm -f "$BROADCASTER_IDENTITY"
    if ! "$VENV_PATH/bin/rnid" -g "$BROADCASTER_IDENTITY" >/dev/null 2>&1; then
        echo -e "${RED}✗ Не удалось сгенерировать identity${NC}"
        systemctl start "$GROUP_SERVICE"
        return 1
    fi

    # 4. Берём LXMF-хеш нового вещателя
    local new_hash=$(get_broadcaster_hash)
    if [ -z "$new_hash" ]; then
        echo -e "${RED}✗ Не удалось получить хеш вещателя${NC}"
        systemctl start "$GROUP_SERVICE"
        return 1
    fi
    echo -e "${GREEN}→ Новый хеш вещателя: ${new_hash}${NC}"

    # 5-6. Прописываем вещателя в группу (роль + секция)
    apply_broadcaster_to_group "$new_hash"

    # 7. Запускаем группу обратно
    echo -e "${YELLOW}→ Запускаю группу...${NC}"
    systemctl start "$GROUP_SERVICE"
    sleep 1

    # 8. Ротация бэкапов вещателя
    rotate_broadcaster_backups

    echo ""
    if systemctl is-active --quiet "$GROUP_SERVICE"; then
        echo -e "${GREEN}✓ Вещатель пересоздан и готов к работе${NC}"
        echo -e "  ${GRAY}Имя:${NC} ${BROADCASTER_NAME}"
        echo -e "  ${GRAY}Хеш:${NC} ${new_hash}"
    else
        echo -e "${RED}⚠ Вещатель пересоздан, но группа не поднялась${NC}"
        echo -e "${GRAY}Проверь: journalctl -u ${GROUP_SERVICE} -n 30${NC}"
    fi
}

# Восстановить вещателя из выбранного бэкапа:
# подменяет identity файлом из бэкапа + прописывает его хеш в группу + рестарт.
restore_broadcaster() {
    echo ""
    echo -e "${CYAN}═══ ВОССТАНОВЛЕНИЕ ВЕЩАТЕЛЯ ИЗ БЭКАПА ═══${NC}"
    echo ""

    # Собираем список бэкапов (новые сверху)
    local backups=()
    while IFS= read -r f; do
        [ -n "$f" ] && backups+=("$f")
    done < <(ls -1t "$BROADCASTER_DIR"/broadcaster.identity.bak-* 2>/dev/null)

    if [ ${#backups[@]} -eq 0 ]; then
        echo -e "${GRAY}Бэкапов нет — восстанавливать не из чего.${NC}"
        return
    fi

    # Показываем пронумерованный список
    echo -e "${WHITE}Доступные бэкапы:${NC}"
    local i=1
    for f in "${backups[@]}"; do
        echo -e "  ${LIGHT_GREEN}[$i]${NC} $(basename "$f")"
        i=$((i + 1))
    done
    echo -e "  ${GRAY}[0]${NC} ${GRAY}← Отмена${NC}"
    echo ""

    echo -ne "${WHITE}Выбери номер бэкапа: ${NC}"
    local num
    read -r num

    # Отмена / некорректный ввод
    if [[ "$num" == "0" ]] || [ -z "$num" ]; then
        echo -e "${GRAY}Отменено.${NC}"
        return
    fi
    if ! [[ "$num" =~ ^[0-9]+$ ]] || [ "$num" -lt 1 ] || [ "$num" -gt ${#backups[@]} ]; then
        echo -e "${RED}✗ Неверный номер.${NC}"
        return
    fi

    local chosen="${backups[$((num - 1))]}"
    echo ""
    echo -e "${WHITE}Выбран:${NC} $(basename "$chosen")"

    # Подтверждение
    echo -e "${RED}Внимание: текущий вещатель будет заменён этим бэкапом.${NC}"
    echo -ne "${WHITE}Восстановить? (y = да, n/Enter = нет): ${NC}"
    local confirm
    read -r confirm
    if [[ ! "$confirm" =~ ^[yYнН] ]]; then
        echo -e "${GRAY}Отменено.${NC}"
        return
    fi
    echo ""

    local config_file="${GROUP_CONFIG}/config.cfg"
    local data_file="${GROUP_CONFIG}/data.cfg"
    if [ ! -f "$config_file" ] || [ ! -f "$data_file" ]; then
        echo -e "${RED}✗ Конфиги группы не найдены в ${GROUP_CONFIG}${NC}"
        return 1
    fi

    # 1. Останавливаем группу
    echo -e "${YELLOW}→ Останавливаю группу...${NC}"
    systemctl stop "$GROUP_SERVICE"
    sleep 1

    # 2. Бэкап текущего identity (на случай отката) + подмена из выбранного бэкапа
    if [ -f "$BROADCASTER_IDENTITY" ]; then
        local stamp=$(date +%Y-%m-%d_%H-%M-%S)
        cp "$BROADCASTER_IDENTITY" "${BROADCASTER_DIR}/broadcaster.identity.bak-${stamp}" 2>/dev/null \
            && echo -e "${GRAY}→ Бэкап текущего identity: broadcaster.identity.bak-${stamp}${NC}"
    fi

    echo -e "${YELLOW}→ Восстанавливаю identity из бэкапа...${NC}"
    if ! cp "$chosen" "$BROADCASTER_IDENTITY" 2>/dev/null; then
        echo -e "${RED}✗ Не удалось скопировать бэкап${NC}"
        systemctl start "$GROUP_SERVICE"
        return 1
    fi

    # 3. Берём хеш восстановленного вещателя
    local r_hash=$(get_broadcaster_hash)
    if [ -z "$r_hash" ]; then
        echo -e "${RED}✗ Не удалось получить хеш восстановленного вещателя${NC}"
        systemctl start "$GROUP_SERVICE"
        return 1
    fi
    echo -e "${GREEN}→ Хеш восстановленного вещателя: ${r_hash}${NC}"

    # 4. Прописываем его в группу
    apply_broadcaster_to_group "$r_hash"

    # 5. Запускаем группу
    echo -e "${YELLOW}→ Запускаю группу...${NC}"
    systemctl start "$GROUP_SERVICE"
    sleep 1

    # 6. Ротация бэкапов
    rotate_broadcaster_backups

    echo ""
    if systemctl is-active --quiet "$GROUP_SERVICE"; then
        echo -e "${GREEN}✓ Вещатель восстановлен и готов к работе${NC}"
        echo -e "  ${GRAY}Имя:${NC} ${BROADCASTER_NAME}"
        echo -e "  ${GRAY}Хеш:${NC} ${r_hash}"
    else
        echo -e "${RED}⚠ Вещатель восстановлен, но группа не поднялась${NC}"
        echo -e "${GRAY}Проверь: journalctl -u ${GROUP_SERVICE} -n 30${NC}"
    fi
}

# Отправка сообщения в группу
send_group_message() {
    while true; do
        echo ""
        echo -e "${CYAN}═══ ОТПРАВКА СООБЩЕНИЯ В ГРУППУ ═══${NC}"
        echo ""
        echo -e "${GRAY}Сообщение будет отправлено всем участникам от имени группы${NC}"
        echo -e "${GRAY}Сейчас откроется редактор — впиши или вставь текст новости.${NC}"
        echo -e "${GRAY}Можно с абзацами. Сохрани (Ctrl+O, Enter) и выйди (Ctrl+X).${NC}"
        echo -e "${GRAY}Пустой текст = отмена.${NC}"
        echo ""
        echo -ne "${WHITE}Нажми Enter чтобы открыть редактор...${NC}"
        read -r _
        
        # Открываем редактор для ввода текста новости
        local edit_file="/tmp/group_message_edit.txt"
        : > "$edit_file"
        ${EDITOR:-nano} "$edit_file"

        # Читаем введённый текст (абзацы сохраняются как есть)
        message=$(cat "$edit_file" 2>/dev/null)
        rm -f "$edit_file" 2>/dev/null
        
        if [ -z "$message" ]; then
            return
        fi
        
        # Показываем сообщение для подтверждения
        echo ""
        echo -e "${WHITE}Сообщение:${NC} $message"
        echo ""
        echo -ne "${YELLOW}Отправить? (Enter = да, n = нет): ${NC}"
        read -r confirm
        
        # Пустой ввод (Enter) = да, n/N/т/Т = нет
        if [[ "$confirm" =~ ^[NnТт]$ ]]; then
            echo -e "${YELLOW}Отменено${NC}"
            continue
        fi
        
        # Сохраняем сообщение во временный файл в UTF-8
        printf '%s' "$message" | iconv -t UTF-8 > /tmp/group_message.txt 2>/dev/null || echo "$message" > /tmp/group_message.txt
        
        echo ""
        echo -e "${YELLOW}Отправляю...${NC}"
        
        # Отправляем через вещателя — группа остаётся запущенной и сама
        # рассылает сообщение участникам от своего имени (онлайн + офлайн)
        BROADCASTER_IDENTITY="$BROADCASTER_IDENTITY" BROADCASTER_DIR="$BROADCASTER_DIR" "$VENV_PATH/bin/python3" /tmp/send_group_msg.py
        
        # Удаляем временный файл
        rm -f /tmp/group_message.txt 2>/dev/null
        
        echo ""
        echo -e "${GREEN}✓ Готово!${NC}"
        echo ""
        echo -ne "${GRAY}Отправить ещё? (y = да, Enter = выход): ${NC}"
        read -r again
        
        if [[ ! "$again" =~ ^[YyДдНн]$ ]]; then
            return
        fi
    done
}

# Создаём Python скрипт для отправки (вызывается из send_group_message)
create_send_script() {
    cat > /tmp/send_group_msg.py << 'PYEOF'
# -*- coding: utf-8 -*-
# Отправка от имени группы через сервисного вещателя (broadcaster).
# Вещатель имеет право send_local + anonymous в группе, поэтому группа
# сама рассылает сообщение всем участникам ОТ СВОЕГО ИМЕНИ — онлайн сразу,
# офлайн через свою ноду распространения. Сервис группы останавливать не нужно.
import RNS
import LXMF
import time
import os

# Пути
GROUP_IDENTITY = "/root/.config/lxmf_distribution_group_extended/identity"
BROADCASTER_IDENTITY = os.environ["BROADCASTER_IDENTITY"]
BROADCASTER_STORAGE = os.environ["BROADCASTER_DIR"]
MESSAGE_FILE = "/tmp/group_message.txt"

# --- Чтение сообщения (пробуем разные кодировки) ---
message_text = None
for encoding in ['utf-8', 'cp1251', 'latin-1']:
    try:
        with open(MESSAGE_FILE, 'r', encoding=encoding) as f:
            message_text = f.read().strip()
        break
    except:
        continue

if not message_text:
    print("Ошибка: не удалось прочитать сообщение")
    exit(1)

print(f"Сообщение: {message_text}")

# --- Инициализация Reticulum ---
reticulum = RNS.Reticulum()

# --- Адрес группы вычисляем из её identity (без хардкода адреса) ---
group_identity = RNS.Identity.from_file(GROUP_IDENTITY)
group_addr = RNS.Destination.hash(group_identity, "lxmf", "delivery")
print(f"Адрес группы: {RNS.hexrep(group_addr, delimit=False)}")

# --- Грузим вещателя и поднимаем его роутер ---
b_identity = RNS.Identity.from_file(BROADCASTER_IDENTITY)
router = LXMF.LXMRouter(identity=b_identity, storagepath=BROADCASTER_STORAGE)
src = router.register_delivery_identity(b_identity, display_name="rn-broadcaster")

# --- Ищем путь к группе ---
if not RNS.Transport.has_path(group_addr):
    RNS.Transport.request_path(group_addr)
    t0 = time.time()
    while not RNS.Transport.has_path(group_addr) and time.time() - t0 < 15:
        time.sleep(0.5)

if not RNS.Transport.has_path(group_addr):
    print("✗ Путь к группе не найден — проверь, что сервис группы запущен")
    exit(1)

# --- Отправляем ОДНО сообщение на адрес группы ---
dest_identity = RNS.Identity.recall(group_addr)
dest = RNS.Destination(dest_identity, RNS.Destination.OUT, RNS.Destination.SINGLE, "lxmf", "delivery")
lxm = LXMF.LXMessage(dest, src, message_text, title="", desired_method=LXMF.LXMessage.DIRECT)
router.handle_outbound(lxm)

print("Отправляю группе (она разошлёт участникам сама)...")

# --- Ждём финальный статус доставки группе ---
TERMINAL = (LXMF.LXMessage.SENT, LXMF.LXMessage.DELIVERED, LXMF.LXMessage.FAILED)
t0 = time.time()
while lxm.state not in TERMINAL and time.time() - t0 < 30:
    time.sleep(0.5)

print("─" * 40)
if lxm.state == LXMF.LXMessage.DELIVERED:
    print("✓ Группа приняла сообщение — рассылка пошла")
    print("  (онлайн — сразу, офлайн — через ноду распространения группы)")
elif lxm.state == LXMF.LXMessage.SENT:
    print("✓ Сообщение отправлено группе")
    print("  (рассылку участникам группа выполнит сама)")
else:
    print(f"⚠ Сообщение не подтверждено (статус: {lxm.state})")
    print("  Проверь логи: journalctl -u surgut_group.service -n 30")
PYEOF
}

# Создаём скрипт при загрузке
create_send_script

# Участники группы
show_group_members() {
    echo ""
    echo -e "${CYAN}═══ УЧАСТНИКИ ГРУППЫ ═══${NC}"
    echo ""
    
    local data_file="/root/.config/lxmf_distribution_group_extended/data.cfg"
    
    if [ -f "$data_file" ]; then
        # Парсим через Python — надёжнее
        sudo "$VENV_PATH/bin/python3" << 'PYEOF'
import configparser
import os

data_file = "/root/.config/lxmf_distribution_group_extended/data.cfg"
config = configparser.ConfigParser()
config.read(data_file)

# Админы
if 'admin' in config.sections():
    admins = dict(config['admin'])
    if admins:
        print("  \033[1;31m👑 АДМИНЫ:\033[0m")
        for hash_addr, nick in admins.items():
            nick = nick.strip() if nick.strip() else hash_addr[:8]
            print(f"     \033[1;37m{nick}\033[0m \033[0;90m[{hash_addr}]\033[0m")
        print()

# Пользователи
if 'user' in config.sections():
    users = dict(config['user'])
    if users:
        print("  \033[1;32m👤 ПОЛЬЗОВАТЕЛИ:\033[0m")
        for hash_addr, nick in users.items():
            nick = nick.strip() if nick.strip() else hash_addr[:8]
            print(f"     \033[1;37m{nick}\033[0m \033[0;90m[{hash_addr}]\033[0m")
        print()

# Заблокированные
if 'block_user' in config.sections():
    blocked = dict(config['block_user'])
    if blocked:
        print("  \033[0;31m🚫 ЗАБЛОКИРОВАНЫ:\033[0m")
        for hash_addr, nick in blocked.items():
            nick = nick.strip() if nick.strip() else hash_addr[:8]
            print(f"     \033[0;90m{nick} [{hash_addr}]\033[0m")
PYEOF
    else
        echo -e "  ${RED}Файл данных не найден${NC}"
    fi
    
    press_enter
}

# Закреплённое сообщение
show_group_pin() {
    echo ""
    echo -e "${CYAN}═══ ЗАКРЕПЛЁННОЕ СООБЩЕНИЕ ═══${NC}"
    echo ""
    
    local data_file="/root/.config/lxmf_distribution_group_extended/data.cfg"
    
    if [ -f "$data_file" ]; then
        local in_pin=0
        while IFS= read -r line; do
            if [[ "$line" == "[pin]" ]]; then
                in_pin=1
                continue
            fi
            if [[ "$line" == "["* ]] && [ $in_pin -eq 1 ]; then
                break
            fi
            if [ $in_pin -eq 1 ] && [ -n "$line" ]; then
                echo -e "  ${WHITE}$line${NC}"
            fi
        done < "$data_file"
    else
        echo -e "  ${RED}Файл данных не найден${NC}"
    fi
    
    press_enter
}

# Статистика группы
show_group_stats() {
    echo ""
    echo -e "${CYAN}═══ СТАТИСТИКА ГРУППЫ ═══${NC}"
    echo ""
    
    local data_file="/root/.config/lxmf_distribution_group_extended/data.cfg"
    
    # Парсим через Python
    sudo "$VENV_PATH/bin/python3" << 'PYEOF'
import configparser

data_file = "/root/.config/lxmf_distribution_group_extended/data.cfg"
config = configparser.ConfigParser()
config.read(data_file)

admins = len(dict(config['admin'])) if 'admin' in config.sections() else 0
users = len(dict(config['user'])) if 'user' in config.sections() else 0
blocked = len(dict(config['block_user'])) if 'block_user' in config.sections() else 0

print(f"  👑 Админов: \033[1;37m{admins}\033[0m")
print(f"  👤 Пользователей: \033[1;37m{users}\033[0m")
print(f"  🚫 Заблокировано: \033[1;37m{blocked}\033[0m")
print(f"  📊 Всего участников: \033[1;37m{admins + users}\033[0m")
PYEOF
    
    echo ""
    
    local stat_file="/root/.config/lxmf_distribution_group_extended/statistic.cfg"
    if [ -f "$stat_file" ]; then
        sudo "$VENV_PATH/bin/python3" << 'PYEOF'
import configparser

stat_file = "/root/.config/lxmf_distribution_group_extended/statistic.cfg"
config = configparser.ConfigParser()
config.read(stat_file)

if 'interface_received_3' in config.sections():
    today = config['interface_received_3'].get('day_value', '0')
    total = config['interface_received_3'].get('all_value', '0')
    print(f"  📨 Сообщений сегодня: \033[1;37m{today}\033[0m")
    print(f"  📬 Сообщений всего: \033[1;37m{total}\033[0m")
PYEOF
    fi
    
    echo ""
    
    # Ресурсы
    local pid=$(systemctl show -p MainPID "$GROUP_SERVICE" 2>/dev/null | cut -d= -f2)
    if [ "$pid" != "0" ] && [ -n "$pid" ]; then
        echo -e "  ${GRAY}Ресурсы (PID: $pid):${NC}"
        ps -p "$pid" -o %cpu,%mem,rss --no-headers 2>/dev/null | \
            awk '{printf "  CPU: %s%%  MEM: %s%%  RAM: %.1f MB\n", $1, $2, $3/1024}'
    fi
    
    press_enter
}

