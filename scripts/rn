#!/bin/bash

# Скрипт требует прав root для управления systemd-сервисами, fail2ban и т.п.
# Если запущен не от root — пытаемся повысить привилегии через sudo.
if [ "$EUID" -ne 0 ]; then
    if command -v sudo >/dev/null 2>&1; then
        exec sudo "$0" "$@"
    else
        echo "ERROR: This script requires root privileges, but 'sudo' is not available."
        echo ""
        echo "Please run as root using one of these methods:"
        echo "  su -                  (switch to root, then run: $0)"
        echo "  su -c \"$0\"            (run once as root)"
        echo ""
        exit 1
    fi
fi

# Динамическое определение пользователя Reticulum
# Ищем юзера у которого есть ~/reticulum/venv (установленный стек)
get_reticulum_user() {
    local u
    for u in /home/*; do
        if [[ -d "$u/reticulum/venv" ]]; then
            basename "$u"
            return
        fi
    done
    echo "user"  # fallback
}

RET_USER="$(get_reticulum_user)"
RET_HOME="/home/${RET_USER}/reticulum"
BOT_HOME="/home/${RET_USER}/ollama-bot"

# ╔═══════════════════════════════════════════════════════════════╗
# ║                    RETICULUM CONTROL                          ║
# ║         Управление всеми сервисами Reticulum сети             ║
# ╚═══════════════════════════════════════════════════════════════╝
#
# Установка: sudo cp rn /usr/local/bin/ && sudo chmod +x /usr/local/bin/rn
# Запуск: rn (или кт на русской раскладке)
#

# ══════════════════════════════════════════════════════════════════
# КОНФИГУРАЦИЯ
# ══════════════════════════════════════════════════════════════════

VENV_PATH="${RET_HOME}/venv"
WORK_DIR="${RET_HOME}"
LOG_FILE="${RET_HOME}/logs/rn_control.log"
PAGES_PATH="/root/.nomadnetwork/storage/pages"
PIN_FILE="/root/.rn_pin"
SSH_PORT=22

# Все сервисы (показываются в меню и считаются для статуса)
# Кандидаты — массив фильтруется ниже, остаются только реально установленные юниты
SERVICES=(
    "reticulum.service"
    "nomadnet.service"
    "surgut_group.service"
    "lxmf_group.service"
    "surgutbot86.service"
    "messageboard.service"
)

# Сервисы для анонса (без reticulum и messageboard — они не анонсят)
ANNOUNCE_SERVICES=(
    "nomadnet.service"
    "surgut_group.service"
    "lxmf_group.service"
    "surgutbot86.service"
)

# Фильтруем: оставляем только те юниты, которые реально установлены
_filter_existing_units() {
    local -n arr=$1
    local filtered=()
    local unit
    for unit in "${arr[@]}"; do
        if systemctl list-unit-files "$unit" --no-legend 2>/dev/null | grep -q "^$unit"; then
            filtered+=("$unit")
        fi
    done
    arr=("${filtered[@]}")
}
_filter_existing_units SERVICES
_filter_existing_units ANNOUNCE_SERVICES

# Определяем какой юнит группы реально установлен в системе
# (lxmf_group.service на новых установках, surgut_group.service на старых)
_detect_group_service() {
    local candidate
    for candidate in "lxmf_group.service" "surgut_group.service"; do
        if systemctl list-unit-files "$candidate" --no-legend 2>/dev/null | grep -q "^$candidate"; then
            echo "$candidate"
            return
        fi
    done
    # Fallback: legacy name (на случай если юнит ещё не создан)
    echo "surgut_group.service"
}
GROUP_SERVICE="$(_detect_group_service)"

# Динамическое чтение имён группы и бота
get_group_name() {
    local cfg="/root/.config/lxmf_distribution_group_extended/config.cfg.owr"
    local name=""
    if [[ -f "$cfg" ]]; then
        name="$(grep -E '^\s*display_name\s*=' "$cfg" | head -n1 | cut -d= -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    fi
    echo "${name:-LXMF Group}"
}

get_bot_name() {
    local env="${BOT_HOME}/.env"
    local name=""
    if [[ -f "$env" ]]; then
        name="$(grep -E '^\s*BOT_NAME\s*=' "$env" | head -n1 | cut -d= -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^"//;s/"$//')"
    fi
    echo "${name:-Bot}"
}

declare -A SERVICE_NAMES=(
    ["reticulum.service"]="🌐 Reticulum Stack"
    ["nomadnet.service"]="📡 NomadNet Node"
    ["surgut_group.service"]="👥 $(get_group_name)"
    ["lxmf_group.service"]="👥 $(get_group_name)"
    ["surgutbot86.service"]="🤖 $(get_bot_name)"
    ["messageboard.service"]="📋 messageboard"
)

# Путь к доске объявлений
BOARD_PATH="/root/.nomadmb/storage/board"

# Пути к данным группы и бота
GROUP_CONFIG="/root/.config/lxmf_distribution_group_extended"
BOT_DATA="${BOT_HOME}/bot_data"

# Пути вещателя (broadcaster) — служебный отправитель новостей в группу
BROADCASTER_DIR="${RET_HOME}/rn_broadcaster"
BROADCASTER_IDENTITY="${BROADCASTER_DIR}/identity"
BROADCASTER_NAME="rn-broadcaster"
BROADCASTER_BACKUP_KEEP=5

# ══════════════════════════════════════════════════════════════════
# ЦВЕТА И ФОРМАТИРОВАНИЕ
# ══════════════════════════════════════════════════════════════════

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
GRAY='\033[0;90m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# Дополнительные оттенки для меню
LIGHT_BLUE='\033[1;34m'
LIGHT_GREEN='\033[1;32m'
LIGHT_PURPLE='\033[1;35m'
ORANGE='\033[0;33m'
LIGHT_CYAN='\033[1;36m'
LIGHT_RED='\033[1;31m'
PINK='\033[1;35m'

# ══════════════════════════════════════════════════════════════════
# DIALOG TUI: тема, палитра сущностей, универсальный хелпер меню
# ══════════════════════════════════════════════════════════════════
# Тема .dialogrc (тёмная, циановые рамки, белый бегунок, без подсветки букв)
DIALOG_RC="${TMPDIR:-/tmp}/dlg_rn.rc"
cat > "$DIALOG_RC" << 'RCEOF'
use_shadow = OFF
use_colors = ON
screen_color = (CYAN,BLACK,ON)
dialog_color = (WHITE,BLACK,OFF)
title_color = (CYAN,BLACK,ON)
border_color = (CYAN,BLACK,ON)
border2_color = (CYAN,BLACK,ON)
button_active_color = (BLACK,WHITE,OFF)
button_inactive_color = (WHITE,BLACK,OFF)
button_key_active_color = (BLACK,WHITE,OFF)
button_key_inactive_color = (WHITE,BLACK,OFF)
button_label_active_color = (BLACK,WHITE,OFF)
button_label_inactive_color = (WHITE,BLACK,OFF)
menubox_color = (WHITE,BLACK,OFF)
menubox_border_color = (CYAN,BLACK,ON)
menubox_border2_color = (CYAN,BLACK,ON)
item_color = (WHITE,BLACK,OFF)
item_selected_color = (BLACK,WHITE,ON)
tag_color = (WHITE,BLACK,OFF)
tag_selected_color = (BLACK,WHITE,ON)
tag_key_color = (WHITE,BLACK,OFF)
tag_key_selected_color = (BLACK,WHITE,ON)
RCEOF
export DIALOGRC="$DIALOG_RC"

# Палитра сущностей: цвет закреплён за сущностью, одинаков во всех меню
# (\Z2 зелён, \Z4 син, \Z5 magenta, \Z6 циан, \Z3 жёлт, \Z1 красн, "" дефолт)
C_RETICULUM="\Z4"   # синий
C_NOMADNET="\Z4"    # синий
C_GROUP="\Z5"       # magenta (SURGUT GROUP)
C_BOT="\Z2"         # зелёный
C_BOARD="\Z3"       # жёлтый (messageboard)
C_GROUPS="\Z6"      # циан (управление группами)
C_START="\Z2"       # зелёный (запуск)
C_STOP="\Z1"        # красный (стоп)
C_RESTART="\Z3"     # жёлтый (рестарт)
C_ANNOUNCE="\Z5"    # magenta (анонс)
C_ENV="\Z3"         # жёлтый (окружение)
C_MON="\Z6"         # циан (мониторинг)
C_PIN=""            # дефолт (чтобы не сливался с белым бегунком)
C_F2B="\Z1"         # красный (fail2ban)

# Универсальный хелпер меню. Авто-размер (рамка адаптируется под контент/экран).
# Вызов: dlg_menu "Заголовок" "Статус" "MENU_DEFAULT" "тег1" "пункт1" "тег2" "пункт2" ...
# Результат выбора → в глобальную DLG_CHOICE (пусто = Назад/Esc)
# ВАЖНО: теги — ЧИСТЫЕ значения (без \Z), иначе ломается возврат в case.
dlg_menu() {
    local title="$1"; shift
    local status="$1"; shift
    local default="$1"; shift
    local items=("$@")
    local def=()
    [ -n "$default" ] && def=(--default-item "$default")
    DLG_CHOICE=$(dialog --colors \
        --backtitle "RETICULUM CONTROL" \
        --title " $title " \
        --ok-label "Открыть" --cancel-label "Назад" \
        "${def[@]}" \
        --menu "$status" 0 0 0 \
        "${items[@]}" \
        3>&1 1>&2 2>&3)
}

# Короткие хелперы-обёртки (единый стиль)
dlg_msg()     { dialog --colors --no-hot-list --msgbox "$1" 0 0; }
dlg_confirm() { dialog --colors --no-hot-list --yesno "$1" 0 0; }   # код 0 = Да

# ══════════════════════════════════════════════════════════════════
# ВСПОМОГАТЕЛЬНАЯ ФУНКЦИЯ: НИК ПОЛЬЗОВАТЕЛЯ
# ══════════════════════════════════════════════════════════════════

# Получить ник пользователя по хэшу
get_user_nick() {
    local hash="$1"
    local nick=$(grep "$hash" /root/.config/lxmf_distribution_group_extended/data.cfg 2>/dev/null | head -1 | cut -d'=' -f2 | tr -d ' ')
    if [ -z "$nick" ]; then
        echo "$hash"
    else
        echo "$nick"
    fi
}

# ══════════════════════════════════════════════════════════════════
# PIN-КОД ЗАЩИТА
# ══════════════════════════════════════════════════════════════════

# Проверка существования PIN
check_pin_exists() {
    [ -f "$PIN_FILE" ]
}

# Установка нового PIN
setup_pin() {
    while true; do
        local pin1
        pin1=$(dialog --colors --insecure \
            --backtitle "RETICULUM CONTROL" \
            --title " УСТАНОВКА PIN " \
            --passwordbox "\nPIN защищает опасные действия\n(остановка сервисов, отправка сообщений)\n\nВведите 4-значный PIN:" 12 54 \
            3>&1 1>&2 2>&3)
        local rc=$?
        clear
        [ $rc -ne 0 ] && return   # отмена

        if [[ ! "$pin1" =~ ^[0-9]{4}$ ]]; then
            dlg_msg "\n\Z1PIN должен быть 4 цифры!\Zn"
            continue
        fi

        local pin2
        pin2=$(dialog --colors --insecure \
            --backtitle "RETICULUM CONTROL" \
            --title " УСТАНОВКА PIN " \
            --passwordbox "\nПовторите PIN:" 9 50 \
            3>&1 1>&2 2>&3)
        rc=$?
        clear
        [ $rc -ne 0 ] && return   # отмена

        if [ "$pin1" != "$pin2" ]; then
            dlg_msg "\n\Z1PIN не совпадает!\Zn"
            continue
        fi

        echo "$pin1" > "$PIN_FILE"
        chmod 600 "$PIN_FILE"
        dlg_msg "\n\Z2✓ PIN установлен!\Zn"
        break
    done
}

# Проверка PIN
verify_pin() {
    local action="$1"
    
    if ! check_pin_exists; then
        return 0  # Если PIN не установлен — пропускаем
    fi
    
    local stored_pin=$(cat "$PIN_FILE")

    local entered_pin
    entered_pin=$(dialog --colors --insecure \
        --backtitle "RETICULUM CONTROL" \
        --title " ПОДТВЕРЖДЕНИЕ PIN " \
        --passwordbox "\nДействие: \Z3${action}\Zn\n\nВведите PIN:" 11 50 \
        3>&1 1>&2 2>&3)
    local rc=$?
    clear

    # Отмена (Esc/Назад) = отказ от действия
    if [ $rc -ne 0 ]; then
        return 1
    fi

    if [ "$entered_pin" == "$stored_pin" ]; then
        return 0
    else
        dlg_msg "\n\Z1✗ Неверный PIN!\Zn"
        return 1
    fi
}

# Сброс PIN
reset_pin() {
    if ! check_pin_exists; then
        dlg_msg "\n\Z3PIN не установлен\Zn"
        return
    fi
    
    if ! verify_pin "сброс PIN"; then
        return
    fi

    if dlg_confirm "\nУдалить PIN-код?"; then
        rm -f "$PIN_FILE"
        dlg_msg "\n\Z2✓ PIN удалён!\Zn"
    fi
}

# Изменение PIN
change_pin() {
    if check_pin_exists; then
        if ! verify_pin "изменение PIN"; then
            return
        fi
    fi
    setup_pin
    press_enter
}

# ══════════════════════════════════════════════════════════════════
# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
# ══════════════════════════════════════════════════════════════════

log_action() {
    local msg="$1"
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $msg" >> "$LOG_FILE"
}

print_header() {
    clear
    echo ""
    echo -e "${CYAN}════════════════════════════════════${NC}"
    echo -e "${CYAN}${BOLD}      RETICULUM CONTROL${NC}"
    echo -e "${CYAN}════════════════════════════════════${NC}"
    echo -e "      ${GRAY}$(date '+%d.%m.%Y %H:%M:%S')${NC}"
    echo ""
}

print_line() {
    echo -e "${GRAY}────────────────────────────────────${NC}"
}

press_enter() {
    echo ""
    echo -e "${GRAY}Нажми Enter чтобы продолжить...${NC}"
    read
}

# Чтение ввода с поддержкой ESC
read_choice() {
    local choice=""
    
    # Читаем один символ
    IFS= read -rsn1 choice
    
    # Проверяем на ESC последовательность
    if [[ "$choice" == $'\e' ]]; then
        # Читаем возможные дополнительные символы (для стрелок и т.д.)
        read -rsn2 -t 0.1 extra
        if [ -z "$extra" ]; then
            # Чистый ESC
            echo "ESC"
            return
        fi
    fi
    
    # Если Enter (пустой ввод после первого символа)
    if [ -z "$choice" ]; then
        echo ""
        return
    fi
    
    # Если цифра или буква — читаем до Enter
    if [[ "$choice" =~ [0-9a-zA-Zа-яА-Я] ]]; then
        local rest=""
        read -r rest
        echo "${choice}${rest}"
        return
    fi
    
    echo "$choice"
}

# Мгновенное чтение одного символа (для меню)
read_key() {
    local key=""
    IFS= read -rsn1 key
    
    # Проверяем ESC
    if [[ "$key" == $'\e' ]]; then
        read -rsn2 -t 0.1 extra
        if [ -z "$extra" ]; then
            echo "ESC"
            return
        fi
    fi
    
    echo "$key"
}

# Умный числовой ввод: цифры любой длины + Enter + Backspace + мгновенный ESC.
# Возвращает: введённое число (echo), либо "ESC" если нажат Esc.
# Пустой ввод + Enter = пустая строка (трактуется вызывающим как "назад").
# Эхо набора идёт в stderr (на экран), результат — в stdout (для $(...)).
read_number_or_esc() {
    local buf=""
    local ch
    while true; do
        IFS= read -rsn1 ch
        case "$ch" in
            $'\e')
                # Esc или начало escape-последовательности (стрелки и т.п.)
                local extra=""
                read -rsn2 -t 0.05 extra
                if [ -z "$extra" ]; then
                    echo "ESC"
                    return
                fi
                # это стрелка/спецклавиша — игнорируем
                ;;
            ""|$'\n')
                # Enter — завершаем ввод
                echo "$buf"
                return
                ;;
            $'\x7f'|$'\b')
                # Backspace — стираем последний символ
                if [ -n "$buf" ]; then
                    buf="${buf%?}"
                    printf '\b \b' >&2
                fi
                ;;
            [0-9])
                # цифра — добавляем и показываем (эхо в stderr)
                buf="${buf}${ch}"
                printf '%s' "$ch" >&2
                ;;
            *)
                # прочее игнорируем
                ;;
        esac
    done
}

# Конвертация русской раскладки в английскую
convert_ru_to_en() {
    local input="$1"
    echo "$input" | sed 'y/йцукенгшщзхъфывапролджэячсмитьбюЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮ/qwertyuiop[]asdfghjkl;'\''zxcvbnm,.QWERTYUIOP[]ASDFGHJKL;'\''ZXCVBNM,./'
}

# Проверка статуса сервиса
get_service_status() {
    local service=$1
    if systemctl is-active --quiet "$service" 2>/dev/null; then
        echo "active"
    else
        echo "inactive"
    fi
}

# Красивый вывод статуса
print_service_status() {
    local service=$1
    local name="${SERVICE_NAMES[$service]:-$service}"
    local status=$(get_service_status "$service")
    
    if [ "$status" = "active" ]; then
        echo -e "  ${GREEN}●${NC} $name ${GREEN}[работает]${NC}"
    else
        echo -e "  ${RED}●${NC} $name ${RED}[остановлен]${NC}"
    fi
}

# Проверка venv
check_venv_active() {
    if [[ "$VIRTUAL_ENV" == "$VENV_PATH" ]]; then
        return 0
    else
        return 1
    fi
}

# ══════════════════════════════════════════════════════════════════
# ПРОВЕРКА И ФИКС ДОСТУПА К PYPI (обход блокировки Fastly IP)
# ══════════════════════════════════════════════════════════════════

# Список рабочих Fastly IP для pypi.org (на случай блокировки РКН)
PYPI_FALLBACK_IPS=(
    "151.101.0.223"
    "151.101.64.223"
    "151.101.128.223"
    "151.101.192.223"
)

PYPI_HOSTS=("pypi.org" "files.pythonhosted.org")

# Проверяет доступен ли pypi.org по HTTPS (таймаут 8 сек)
# Использует curl, при его отсутствии — python из venv
check_pypi_access() {
    if command -v curl >/dev/null 2>&1; then
        curl -sI https://pypi.org --connect-timeout 8 -o /dev/null 2>/dev/null && return 0
        return 1
    fi
    # Fallback на python (venv всегда есть в этом окружении)
    "$VENV_PATH/bin/python3" -c "
import urllib.request, sys
try:
    urllib.request.urlopen('https://pypi.org/simple/', timeout=8)
    sys.exit(0)
except Exception:
    sys.exit(1)
" 2>/dev/null && return 0
    return 1
}

# Удаляет записи pypi из /etc/hosts
clean_pypi_hosts() {
    sudo sed -i '/pypi\.org/d;/files\.pythonhosted\.org/d' /etc/hosts 2>/dev/null
}

# Подбирает рабочий Fastly IP и прописывает в /etc/hosts
# Возвращает 0 если успех, 1 если ни один IP не сработал
fix_pypi_access() {
    echo -e "${YELLOW}⚠ pypi.org недоступен — подбираю рабочий IP...${NC}"

    # Сначала чистим старые записи
    clean_pypi_hosts

    local ip
    for ip in "${PYPI_FALLBACK_IPS[@]}"; do
        echo -ne "  ${GRAY}Пробую ${ip}...${NC} "

        # Временно прописываем IP
        clean_pypi_hosts
        local host
        for host in "${PYPI_HOSTS[@]}"; do
            echo "$ip $host" | sudo tee -a /etc/hosts >/dev/null
        done

        # Проверяем доступность (используем общую функцию)
        if check_pypi_access; then
            echo -e "${GREEN}✓ работает!${NC}"
            log_action "PYPI FIX: using $ip"
            return 0
        else
            echo -e "${RED}✗${NC}"
        fi
    done

    # Ни один IP не сработал — убираем мусор из hosts
    clean_pypi_hosts
    echo -e "${RED}✗ Не удалось подобрать рабочий IP${NC}"
    return 1
}

# Гарантирует доступ к pypi: проверяет, при необходимости чинит.
# Возвращает 0 если доступ есть (или починили), 1 если нет.
ensure_pypi_access() {
    echo -ne "${GRAY}Проверяю доступ к pypi.org...${NC} "
    if check_pypi_access; then
        echo -e "${GREEN}✓${NC}"
        return 0
    fi
    echo -e "${YELLOW}недоступен${NC}"
    fix_pypi_access
    return $?
}

# ══════════════════════════════════════════════════════════════════
# ФУНКЦИИ УПРАВЛЕНИЯ СЕРВИСАМИ
# ══════════════════════════════════════════════════════════════════

start_service() {
    local service=$1
    local name="${SERVICE_NAMES[$service]:-$service}"
    echo -e "${YELLOW}▶${NC} Запускаю $name..."
    sudo systemctl start "$service"
    sleep 1
    if [ "$(get_service_status "$service")" = "active" ]; then
        echo -e "${GREEN}✓${NC} $name запущен"
        log_action "STARTED: $service"
    else
        echo -e "${RED}✗${NC} Ошибка запуска $name"
        log_action "FAILED TO START: $service"
    fi
}

stop_service() {
    local service=$1
    local name="${SERVICE_NAMES[$service]:-$service}"
    echo -e "${YELLOW}■${NC} Останавливаю $name..."
    sudo systemctl stop "$service"
    sleep 1
    if [ "$(get_service_status "$service")" = "inactive" ]; then
        echo -e "${GREEN}✓${NC} $name остановлен"
        log_action "STOPPED: $service"
    else
        echo -e "${RED}✗${NC} Ошибка остановки $name"
        log_action "FAILED TO STOP: $service"
    fi
}

restart_service() {
    local service=$1
    local name="${SERVICE_NAMES[$service]:-$service}"
    echo -e "${YELLOW}↻${NC} Перезапускаю $name..."
    sudo systemctl restart "$service"
    sleep 2
    if [ "$(get_service_status "$service")" = "active" ]; then
        echo -e "${GREEN}✓${NC} $name перезапущен"
        log_action "RESTARTED: $service"
    else
        echo -e "${RED}✗${NC} Ошибка перезапуска $name"
        log_action "FAILED TO RESTART: $service"
    fi
}

# Запуск всех сервисов
start_all() {
    echo -e "\n${CYAN}═══ ЗАПУСК ВСЕХ СЕРВИСОВ ═══${NC}\n"
    log_action "=== STARTING ALL SERVICES ==="
    for service in "${SERVICES[@]}"; do
        start_service "$service"
    done
    echo ""
    echo -e "${GREEN}✓ Все сервисы запущены!${NC}"
    press_enter
}

# Остановка всех сервисов
stop_all() {
    echo -e "\n${CYAN}═══ ОСТАНОВКА ВСЕХ СЕРВИСОВ ═══${NC}\n"
    log_action "=== STOPPING ALL SERVICES ==="
    # Останавливаем в обратном порядке
    for (( i=${#SERVICES[@]}-1; i>=0; i-- )); do
        stop_service "${SERVICES[i]}"
    done
    echo ""
    echo -e "${GREEN}✓ Все сервисы остановлены!${NC}"
    press_enter
}

# Перезапуск всех сервисов
restart_all() {
    echo -e "\n${CYAN}═══ ПЕРЕЗАПУСК ВСЕХ СЕРВИСОВ ═══${NC}\n"
    log_action "=== RESTARTING ALL SERVICES ==="
    for service in "${SERVICES[@]}"; do
        restart_service "$service"
        if [ "$service" = "reticulum.service" ]; then
            echo -e "${GRAY}⏳ Ожидаю инициализацию Reticulum...${NC}"
            sleep 4
        fi
    done
    echo ""
    echo -e "${GREEN}✓ Все сервисы перезапущены!${NC}"
    press_enter
}

# Анонс всех сервисов (быстрый рестарт 3 главных)
announce_all() {
    echo -e "\n${CYAN}═══ АНОНС ВСЕХ СЕРВИСОВ ═══${NC}\n"
    log_action "=== ANNOUNCING ALL SERVICES ==="
    for service in "${ANNOUNCE_SERVICES[@]}"; do
        local name="${SERVICE_NAMES[$service]:-$service}"
        echo -e "${PURPLE}📢${NC} Анонсирую $name..."
        sudo systemctl restart "$service"
        sleep 0.5
        if [ "$(get_service_status "$service")" = "active" ]; then
            echo -e "${GREEN}✓${NC} $name анонсирован"
            log_action "ANNOUNCED: $service"
        else
            echo -e "${RED}✗${NC} Ошибка анонса $name"
            log_action "FAILED TO ANNOUNCE: $service"
        fi
    done
    echo ""
    echo -e "${GREEN}✓ Все сервисы анонсированы!${NC}"
    press_enter
}

# ══════════════════════════════════════════════════════════════════
# МЕНЮ СТАТУСА
# ══════════════════════════════════════════════════════════════════

show_status() {
    print_header
    echo -e "${WHITE}${BOLD}  СТАТУС СЕРВИСОВ${NC}"
    print_line
    echo ""
    
    local active_count=0
    local total_count=${#SERVICES[@]}
    
    for service in "${SERVICES[@]}"; do
        print_service_status "$service"
        if [ "$(get_service_status "$service")" = "active" ]; then
            ((active_count++))
        fi
    done
    
    echo ""
    print_line
    
    # Статус venv
    if check_venv_active; then
        echo -e "  ${GREEN}●${NC} Virtual Environment ${GREEN}[активен]${NC}"
    else
        echo -e "  ${YELLOW}●${NC} Virtual Environment ${YELLOW}[не активен]${NC}"
    fi
    
    echo ""
    echo -e "  ${CYAN}Работает: ${active_count}/${total_count} сервисов${NC}"
    echo ""
    press_enter
}

# ══════════════════════════════════════════════════════════════════
# ПОДМЕНЮ: СЕРВИСЫ RETICULUM
# ══════════════════════════════════════════════════════════════════

menu_services() {
    local DEF=""
    while true; do
        # Полный статус КАЖДОГО сервиса в шапку (как в оригинале, но без эмодзи, с \Z-цветами)
        local STATUS=""
        for service in "${SERVICES[@]}"; do
            local nm="${SERVICE_NAMES[$service]:-$service}"
            # убираем эмодзи и ведущий пробел из имени
            nm=$(printf '%s' "$nm" | sed -E 's/^[^[:alnum:]A-Za-zА-Яа-я]+[[:space:]]*//')
            local st=$(get_service_status "$service")
            if [ "$st" = "active" ]; then
                STATUS="${STATUS}\Z2●\Zn ${nm} \Z2[работает]\Zn\n"
            else
                STATUS="${STATUS}\Z1●\Zn ${nm} \Z1[остановлен]\Zn\n"
            fi
        done

        local GROUP_NAME="$(get_group_name)"
        local BOT_NAME="$(get_bot_name)"

        dlg_menu "СЕРВИСЫ RETICULUM" "$STATUS" "$DEF" \
            "1"  "${C_RETICULUM}Reticulum Stack\Zn" \
            "2"  "${C_NOMADNET}NomadNet\Zn" \
            "3"  "${C_GROUP}${GROUP_NAME}\Zn" \
            "4"  "${C_BOT}${BOT_NAME}\Zn" \
            "5"  "${C_BOARD}messageboard\Zn" \
            "6"  "${C_GROUPS}Управление группами\Zn" \
            "a"  "${C_START}Запустить ВСЕ\Zn" \
            "s"  "${C_STOP}Остановить ВСЕ\Zn" \
            "r"  "${C_RESTART}Перезапустить ВСЕ\Zn" \
            "n"  "${C_ANNOUNCE}Анонсировать ВСЕ\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) menu_single_service "reticulum.service" ;;
            2) menu_nomadnet ;;
            3) menu_group ;;
            4) menu_surgutbot ;;
            5) menu_messageboard ;;
            6) menu_all_groups ;;
            a) start_all ;;
            s) 
                if verify_pin "остановить ВСЕ"; then
                    stop_all
                fi
                ;;
            r) restart_all ;;
            n) announce_all ;;
            *) ;;
        esac
    done
}

# Меню для одного сервиса
menu_single_service() {
    local service=$1
    local name="${SERVICE_NAMES[$service]:-$service}"
    # чистое имя без эмодзи для заголовка dialog
    local clean_name=$(printf '%s' "$name" | sed -E 's/^[^[:alnum:]A-Za-zА-Яа-я]+[[:space:]]*//')
    local DEF=""

    while true; do
        # Статус сервиса в шапку (без эмодзи, с \Z-цветами)
        local st=$(get_service_status "$service")
        local STATUS
        if [ "$st" = "active" ]; then
            STATUS="\Z2● ${clean_name} [работает]\Zn"
        else
            STATUS="\Z1● ${clean_name} [остановлен]\Zn"
        fi

        # Собираем пункты (пункт 6 только для NomadNet)
        local items=(
            "1" "${C_START}Запустить\Zn"
            "2" "${C_STOP}Остановить\Zn"
            "3" "${C_RESTART}Перезапустить\Zn"
            "4" "${C_MON}Показать логи\Zn"
            "5" "${C_NOMADNET}Подробный статус\Zn"
        )
        if [ "$service" = "nomadnet.service" ]; then
            items+=( "6" "${C_GROUP}Открыть интерактивно (TUI)\Zn" )
        fi

        dlg_menu "$clean_name" "$STATUS" "$DEF" "${items[@]}"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) 
                start_service "$service"
                press_enter
                ;;
            2) 
                if verify_pin "остановить $name"; then
                    stop_service "$service"
                    press_enter
                fi
                ;;
            3) 
                restart_service "$service"
                press_enter
                ;;
            4)
                echo ""
                echo -e "${CYAN}═══ ЛОГИ: $clean_name (Ctrl+C для выхода) ═══${NC}"
                echo ""
                sudo journalctl -u "$service" -f --no-pager -n 50
                ;;
            5)
                echo ""
                sudo systemctl status "$service"
                press_enter
                ;;
            6)
                if [ "$service" = "nomadnet.service" ]; then
                    launch_nomadnet_interactive
                fi
                ;;
            *) ;;
        esac
    done
}

