}
load_lang

# Универсальный хелпер меню. Авто-размер (рамка адаптируется под контент/экран).
# Вызов: dlg_menu "Заголовок" "Статус" "MENU_DEFAULT" "тег1" "пункт1" "тег2" "пункт2" ...
# Результат выбора → в глобальную DLG_CHOICE (пусто = Назад/Esc)
# ВАЖНО: теги — ЧИСТЫЕ значения (без \Z), иначе ломается возврат в case.
dlg_menu() {
    local title="$1"; shift
    local status="$1"; shift
    local default="$1"; shift
    local items=("$@")
    local def=()
    [ -n "$default" ] && def=(--default-item "$default")

    # ── Dynamic sizing ────────────────────────────────────────────────
    # Items come in (tag, description) pairs, so the number of menu rows
    # is half the array length. We size the dialog to show every row
    # without scrolling, while never exceeding the actual terminal size.
    local n_items=$(( ${#items[@]} / 2 ))

    # Terminal size (fallback to a sane default if not reported)
    local term_lines="${LINES:-0}"
    local term_cols="${COLUMNS:-0}"
    if [ "$term_lines" -le 0 ] 2>/dev/null; then
        term_lines=$(tput lines 2>/dev/null || echo 24)
    fi
    if [ "$term_cols" -le 0 ] 2>/dev/null; then
        term_cols=$(tput cols 2>/dev/null || echo 80)
    fi

    # Count how many lines the status/header text needs (it may contain \n).
    local status_lines=1
    if [ -n "$status" ]; then
        # count literal \n sequences plus the first line
        local nl_count
        nl_count=$(printf '%s' "$status" | grep -o '\\n' | wc -l 2>/dev/null || echo 0)
        status_lines=$(( nl_count + 1 ))
    fi

    # dialog chrome: title + borders + buttons + status block ≈ 7 lines.
    local chrome=$(( 7 + status_lines ))

    # Desired total height = chrome + one row per item.
    local height=$(( chrome + n_items ))

    # Cap to terminal height (leave a 1-line margin); never smaller than ~10.
    local max_h=$(( term_lines - 1 ))
    [ "$height" -gt "$max_h" ] && height=$max_h
    [ "$height" -lt 10 ] && height=10

    # menu_h = rows visible in the list area = height - chrome.
    local menu_h=$(( height - chrome ))
    [ "$menu_h" -lt 1 ] && menu_h=1
    # If everything fits, show all items (no scroll); otherwise show as many
    # as the area allows (dialog will scroll the rest).
    [ "$menu_h" -gt "$n_items" ] && menu_h=$n_items

    # Width: wide enough for content, capped to terminal (margin 4).
    local width=70
    local max_w=$(( term_cols - 4 ))
    [ "$width" -gt "$max_w" ] && width=$max_w
    [ "$width" -lt 40 ] && width=40

    DLG_CHOICE=$(dialog --colors \
        --backtitle "RETICULUM CONTROL" \
        --title " $title " \
        --ok-label "${L[btn_open]}" --cancel-label "${L[btn_back]}" \
        "${def[@]}" \
        --menu "$status" "$height" "$width" "$menu_h" \
        "${items[@]}" \
        3>&1 1>&2 2>&3)
    local dlg_rc=$?

    # ── Back vs ESC ───────────────────────────────────────────────────
    # dialog exit codes: 0 = item chosen, 1 = Back/Cancel button, 255 = ESC.
    # Both the Back button and ESC step back one level, instantly (ESCDELAY is
    # lowered at the top of the script, so ESC reacts immediately). To leave
    # from a deep menu, just tap ESC a few times to walk up to the terminal.
    if [ "$dlg_rc" -eq 255 ]; then
        DLG_CHOICE=""
    fi
}

# Короткие хелперы-обёртки (единый стиль)
dlg_msg()     { dialog --colors --no-hot-list --msgbox "$1" 0 0; }
dlg_confirm() { dialog --colors --no-hot-list --yes-label "${L[btn_yes]}" --no-label "${L[btn_no]}" --yesno "$1" 0 0; }   # код 0 = Да

# ══════════════════════════════════════════════════════════════════
# ВСПОМОГАТЕЛЬНАЯ ФУНКЦИЯ: НИК ПОЛЬЗОВАТЕЛЯ
# ══════════════════════════════════════════════════════════════════

# Получить ник пользователя по хэшу
get_user_nick() {
    local hash="$1"
    local nick=$(grep "$hash" /root/.config/lxmf_distribution_group_extended/data.cfg 2>/dev/null | head -1 | cut -d'=' -f2 | tr -d ' ')
    if [ -z "$nick" ]; then
        echo "$hash"
    else
        echo "$nick"
    fi
}

# ══════════════════════════════════════════════════════════════════
# PIN-КОД ЗАЩИТА
# ══════════════════════════════════════════════════════════════════

# Проверка существования PIN
check_pin_exists() {
    [ -f "$PIN_FILE" ]
}

# Установка нового PIN
setup_pin() {
    while true; do
        local pin1
        pin1=$(dialog --colors --insecure \
            --backtitle "RETICULUM CONTROL" \
            --title "${L[pin_setup_title]}" \
            --ok-label "${L[btn_open]}" --cancel-label "${L[btn_back]}" \
            --passwordbox "${L[pin_setup_prompt]}" 12 54 \
            3>&1 1>&2 2>&3)
        local rc=$?
        clear
        [ $rc -ne 0 ] && return   # отмена

        if [[ ! "$pin1" =~ ^[0-9]{4}$ ]]; then
            dlg_msg "${L[pin_must_4]}"
            continue
        fi

        local pin2
        pin2=$(dialog --colors --insecure \
            --backtitle "RETICULUM CONTROL" \
            --title "${L[pin_setup_title]}" \
            --ok-label "${L[btn_open]}" --cancel-label "${L[btn_back]}" \
            --passwordbox "${L[pin_repeat]}" 9 50 \
            3>&1 1>&2 2>&3)
        rc=$?
        clear
        [ $rc -ne 0 ] && return   # отмена

        if [ "$pin1" != "$pin2" ]; then
            dlg_msg "${L[pin_mismatch]}"
            continue
        fi

        echo "$pin1" > "$PIN_FILE"
        chmod 600 "$PIN_FILE"
        dlg_msg "${L[pin_set_ok]}"
        break
    done
}

# Проверка PIN
verify_pin() {
    local action="$1"
    
    if ! check_pin_exists; then
        return 0  # Если PIN не установлен — пропускаем
    fi
    
    local stored_pin=$(cat "$PIN_FILE")

    local entered_pin
    entered_pin=$(dialog --colors --insecure \
        --backtitle "RETICULUM CONTROL" \
        --title "${L[pin_confirm_title]}" \
        --ok-label "${L[btn_open]}" --cancel-label "${L[btn_back]}" \
        --passwordbox "$(printf "${L[pin_confirm_prompt]}" "${action}")" 11 50 \
        3>&1 1>&2 2>&3)
    local rc=$?
    clear

    # Отмена (Esc/Назад) = отказ от действия
    if [ $rc -ne 0 ]; then
        return 1
    fi

    if [ "$entered_pin" == "$stored_pin" ]; then
        return 0
    else
        dlg_msg "${L[pin_wrong]}"
        return 1
    fi
}

# Сброс PIN
reset_pin() {
    if ! check_pin_exists; then
        dlg_msg "${L[pin_notset]}"
        return
    fi
    
    if ! verify_pin "${L[pin_reset_reason]}"; then
        return
    fi

    if dlg_confirm "${L[pin_delete_confirm]}"; then
        rm -f "$PIN_FILE"
        dlg_msg "${L[pin_deleted]}"
    fi
}

# Изменение PIN
change_pin() {
    if check_pin_exists; then
        if ! verify_pin "${L[pin_change_reason]}"; then
            return
        fi
    fi
    setup_pin
    press_enter
}

# ══════════════════════════════════════════════════════════════════
# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
# ══════════════════════════════════════════════════════════════════

log_action() {
    local msg="$1"
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $msg" >> "$LOG_FILE"
}

print_header() {
    clear
    echo ""
    echo -e "${CYAN}════════════════════════════════════${NC}"
    echo -e "${CYAN}${BOLD}      RETICULUM CONTROL${NC}"
    echo -e "${CYAN}════════════════════════════════════${NC}"
    echo -e "      ${GRAY}$(date '+%d.%m.%Y %H:%M:%S')${NC}"
    echo ""
}

print_line() {
    echo -e "${GRAY}────────────────────────────────────${NC}"
}

press_enter() {
    # Разделитель + подсказка снизу, единообразно для всех выводов. На длинных
    # выводах терминал прокручивается сюда (к месту ввода), поэтому подсказка
    # всегда оказывается на виду. Закрываем и по Enter, и по ESC.
    echo ""
    echo -e "${CYAN}────────────────────────────────────${NC}"
    echo -e "${GRAY}${L[press_enter]}${NC}"
    local _k
    read -rsn1 _k 2>/dev/null
    if [ "$_k" = $'\e' ]; then
        # съесть возможный хвост escape-последовательности
        while read -rsn1 -t 0.02 _k 2>/dev/null; do :; done
    fi
}

# Чтение ввода с поддержкой ESC
read_choice() {
    local choice=""
    
    # Читаем один символ
    IFS= read -rsn1 choice
    
    # Проверяем на ESC последовательность
    if [[ "$choice" == $'\e' ]]; then
        # Читаем возможные дополнительные символы (для стрелок и т.д.)
        read -rsn2 -t 0.1 extra
        if [ -z "$extra" ]; then
            # Чистый ESC
            echo "ESC"
            return
        fi
    fi
    
    # Если Enter (пустой ввод после первого символа)
    if [ -z "$choice" ]; then
        echo ""
        return
    fi
    
    # Если цифра или буква — читаем до Enter
    if [[ "$choice" =~ [0-9a-zA-Zа-яА-Я] ]]; then
        local rest=""
        read -r rest
        echo "${choice}${rest}"
        return
    fi
    
    echo "$choice"
}

# Мгновенное чтение одного символа (для меню)
read_key() {
    local key=""
    IFS= read -rsn1 key
    
    # Проверяем ESC
    if [[ "$key" == $'\e' ]]; then
        read -rsn2 -t 0.1 extra
        if [ -z "$extra" ]; then
            echo "ESC"
            return
        fi
    fi
    
    echo "$key"
}

# Умный числовой ввод: цифры любой длины + Enter + Backspace + мгновенный ESC.
# Возвращает: введённое число (echo), либо "ESC" если нажат Esc.
# Пустой ввод + Enter = пустая строка (трактуется вызывающим как "назад").
# Эхо набора идёт в stderr (на экран), результат — в stdout (для $(...)).
read_number_or_esc() {
    local buf=""
    local ch
    while true; do
        IFS= read -rsn1 ch
        case "$ch" in
            $'\e')
                # Esc или начало escape-последовательности (стрелки и т.п.)
                local extra=""
                read -rsn2 -t 0.05 extra
                if [ -z "$extra" ]; then
                    echo "ESC"
                    return
                fi
                # это стрелка/спецклавиша — игнорируем
                ;;
            ""|$'\n')
                # Enter — завершаем ввод
                echo "$buf"
                return
                ;;
            $'\x7f'|$'\b')
                # Backspace — стираем последний символ
                if [ -n "$buf" ]; then
                    buf="${buf%?}"
                    printf '\b \b' >&2
                fi
                ;;
            [0-9])
                # цифра — добавляем и показываем (эхо в stderr)
                buf="${buf}${ch}"
                printf '%s' "$ch" >&2
                ;;
            *)
                # прочее игнорируем
                ;;
        esac
    done
}

# Конвертация русской раскладки в английскую
convert_ru_to_en() {
    local input="$1"
    echo "$input" | sed 'y/йцукенгшщзхъфывапролджэячсмитьбюЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮ/qwertyuiop[]asdfghjkl;'\''zxcvbnm,.QWERTYUIOP[]ASDFGHJKL;'\''ZXCVBNM,./'
}

# Проверка статуса сервиса
get_service_status() {
    local service=$1
    if systemctl is-active --quiet "$service" 2>/dev/null; then
        echo "active"
    else
        echo "inactive"
    fi
}

# Красивый вывод статуса
print_service_status() {
    local service=$1
    local name="${SERVICE_NAMES[$service]:-$service}"
    local status=$(get_service_status "$service")
    
    if [ "$status" = "active" ]; then
        echo -e "  ${GREEN}●${NC} $name ${GREEN}${L[st_running]}${NC}"
    else
        echo -e "  ${RED}●${NC} $name ${RED}${L[st_stopped]}${NC}"
    fi
}

# Проверка venv
check_venv_active() {
    if [[ "$VIRTUAL_ENV" == "$VENV_PATH" ]]; then
        return 0
    else
        return 1
    fi
}

# ══════════════════════════════════════════════════════════════════
# ПРОВЕРКА И ФИКС ДОСТУПА К PYPI (обход блокировки Fastly IP)
# ══════════════════════════════════════════════════════════════════

# Список рабочих Fastly IP для pypi.org (на случай блокировки РКН)
PYPI_FALLBACK_IPS=(
    "151.101.0.223"
    "151.101.64.223"
    "151.101.128.223"
    "151.101.192.223"
)

PYPI_HOSTS=("pypi.org" "files.pythonhosted.org")

# Проверяет доступен ли pypi.org по HTTPS (таймаут 8 сек)
# Использует curl, при его отсутствии — python из venv
check_pypi_access() {
    if command -v curl >/dev/null 2>&1; then
        curl -sI https://pypi.org --connect-timeout 8 -o /dev/null 2>/dev/null && return 0
        return 1
    fi
    # Fallback на python (venv всегда есть в этом окружении)
    "$VENV_PATH/bin/python3" -c "
import urllib.request, sys
try:
    urllib.request.urlopen('https://pypi.org/simple/', timeout=8)
    sys.exit(0)
except Exception:
    sys.exit(1)
" 2>/dev/null && return 0
    return 1
}

# Удаляет записи pypi из /etc/hosts
clean_pypi_hosts() {
    sudo sed -i '/pypi\.org/d;/files\.pythonhosted\.org/d' /etc/hosts 2>/dev/null
}

# Подбирает рабочий Fastly IP и прописывает в /etc/hosts
# Возвращает 0 если успех, 1 если ни один IP не сработал
fix_pypi_access() {
    echo -e "${YELLOW}${L[pypi_unavail_fixing]}${NC}"

    # Сначала чистим старые записи
    clean_pypi_hosts

    local ip
    for ip in "${PYPI_FALLBACK_IPS[@]}"; do
        echo -ne "${GRAY}$(printf "${L[pypi_trying]}" "$ip")${NC} "

        # Временно прописываем IP
        clean_pypi_hosts
        local host
        for host in "${PYPI_HOSTS[@]}"; do
            echo "$ip $host" | sudo tee -a /etc/hosts >/dev/null
        done

        # Проверяем доступность (используем общую функцию)
        if check_pypi_access; then
            echo -e "${GREEN}${L[pypi_works]}${NC}"
            log_action "PYPI FIX: using $ip"
            return 0
        else
            echo -e "${RED}✗${NC}"
        fi
    done

    # Ни один IP не сработал — убираем мусор из hosts
    clean_pypi_hosts
    echo -e "${RED}${L[pypi_nofix]}${NC}"
    return 1
}

# Гарантирует доступ к pypi: проверяет, при необходимости чинит.
# Возвращает 0 если доступ есть (или починили), 1 если нет.
ensure_pypi_access() {
    echo -ne "${GRAY}${L[pypi_checking]}${NC} "
    if check_pypi_access; then
        echo -e "${GREEN}✓${NC}"
        return 0
    fi
    echo -e "${YELLOW}${L[pypi_unavail_short]}${NC}"
    fix_pypi_access
    return $?
}

# ══════════════════════════════════════════════════════════════════
# ФУНКЦИИ УПРАВЛЕНИЯ СЕРВИСАМИ
# ══════════════════════════════════════════════════════════════════

start_service() {
    local service=$1
    local name="${SERVICE_NAMES[$service]:-$service}"
    echo -e "${YELLOW}$(printf "${L[act_starting]}" "$name")${NC}"
    sudo systemctl start "$service"
    sleep 1
    if [ "$(get_service_status "$service")" = "active" ]; then
        echo -e "${GREEN}$(printf "${L[act_started]}" "$name")${NC}"
        log_action "STARTED: $service"
    else
        echo -e "${RED}$(printf "${L[act_start_fail]}" "$name")${NC}"
        log_action "FAILED TO START: $service"
    fi
}

stop_service() {
    local service=$1
    local name="${SERVICE_NAMES[$service]:-$service}"
    echo -e "${YELLOW}$(printf "${L[act_stopping]}" "$name")${NC}"
    sudo systemctl stop "$service"
    sleep 1
    if [ "$(get_service_status "$service")" = "inactive" ]; then
        echo -e "${GREEN}$(printf "${L[act_stopped]}" "$name")${NC}"
        log_action "STOPPED: $service"
    else
        echo -e "${RED}$(printf "${L[act_stop_fail]}" "$name")${NC}"
        log_action "FAILED TO STOP: $service"
    fi
}

restart_service() {
    local service=$1
    local name="${SERVICE_NAMES[$service]:-$service}"
    echo -e "${YELLOW}$(printf "${L[act_restarting]}" "$name")${NC}"
    sudo systemctl restart "$service"
    sleep 2
    if [ "$(get_service_status "$service")" = "active" ]; then
        echo -e "${GREEN}$(printf "${L[act_restarted]}" "$name")${NC}"
        log_action "RESTARTED: $service"
    else
        echo -e "${RED}$(printf "${L[act_restart_fail]}" "$name")${NC}"
        log_action "FAILED TO RESTART: $service"
    fi
}

# Запуск всех сервисов
start_all() {
    echo -e "\n${CYAN}${L[act_all_start_hdr]}${NC}\n"
    log_action "=== STARTING ALL SERVICES ==="
    for service in "${SERVICES[@]}"; do
        start_service "$service"
    done
    echo ""
    echo -e "${GREEN}${L[act_all_started]}${NC}"
    press_enter
}

# Остановка всех сервисов
stop_all() {
    echo -e "\n${CYAN}${L[act_all_stop_hdr]}${NC}\n"
    log_action "=== STOPPING ALL SERVICES ==="
    # Останавливаем в обратном порядке
    for (( i=${#SERVICES[@]}-1; i>=0; i-- )); do
        stop_service "${SERVICES[i]}"
    done
    echo ""
    echo -e "${GREEN}${L[act_all_stopped]}${NC}"
    press_enter
}

# Перезапуск всех сервисов
restart_all() {
    echo -e "\n${CYAN}${L[act_all_restart_hdr]}${NC}\n"
    log_action "=== RESTARTING ALL SERVICES ==="
    for service in "${SERVICES[@]}"; do
        restart_service "$service"
        if [ "$service" = "reticulum.service" ]; then
            echo -e "${GRAY}${L[act_wait_reticulum]}${NC}"
            sleep 4
        fi
    done
    echo ""
    echo -e "${GREEN}${L[act_all_restarted]}${NC}"
    press_enter
}

# Анонс всех сервисов (быстрый рестарт 3 главных)
announce_all() {
    echo -e "\n${CYAN}${L[act_all_announce_hdr]}${NC}\n"
    log_action "=== ANNOUNCING ALL SERVICES ==="
    for service in "${ANNOUNCE_SERVICES[@]}"; do
        local name="${SERVICE_NAMES[$service]:-$service}"
        echo -e "${PURPLE}$(printf "${L[act_announcing]}" "$name")${NC}"
        sudo systemctl restart "$service"
        sleep 0.5
        if [ "$(get_service_status "$service")" = "active" ]; then
            echo -e "${GREEN}$(printf "${L[act_announced]}" "$name")${NC}"
            log_action "ANNOUNCED: $service"
        else
            echo -e "${RED}$(printf "${L[act_announce_fail]}" "$name")${NC}"
            log_action "FAILED TO ANNOUNCE: $service"
        fi
    done
    echo ""
    echo -e "${GREEN}${L[act_all_announced]}${NC}"
    press_enter
}

# ══════════════════════════════════════════════════════════════════
# МЕНЮ СТАТУСА
# ══════════════════════════════════════════════════════════════════

show_status() {
    print_header
    echo -e "${WHITE}${BOLD}${L[status_services_hdr]}${NC}"
    print_line
    echo ""
    
    local active_count=0
    local total_count=${#SERVICES[@]}
    
    for service in "${SERVICES[@]}"; do
        print_service_status "$service"
        if [ "$(get_service_status "$service")" = "active" ]; then
            ((active_count++))
        fi
    done

    # Динамические группы (созданные через бота): lxmf_group_*
    for dir in /root/.config/lxmf_group_*; do
        [ -d "$dir" ] && [ -f "$dir/identity" ] || continue
        local gname=$(get_group_display_name "$dir")
        local gservice=$(get_group_service "$dir")
        local glock=""
        is_group_private "$dir" && glock=" ${YELLOW}${L[ag_private]}${NC}"
        ((total_count++))
        if [ "$(get_service_status "$gservice")" = "active" ]; then
            ((active_count++))
            echo -e "  ${GREEN}●${NC} ${gname}${glock} ${GREEN}${L[st_running]}${NC}"
        else
            echo -e "  ${RED}●${NC} ${gname}${glock} ${RED}${L[st_stopped]}${NC}"
        fi
    done
    
    echo ""
    print_line
    
    # Статус venv
    if check_venv_active; then
        echo -e "  ${GREEN}●${NC} ${GREEN}${L[status_venv_active]}${NC}"
    else
        echo -e "  ${YELLOW}●${NC} ${YELLOW}${L[status_venv_inactive]}${NC}"
    fi
    
    echo ""
    echo -e "  ${CYAN}$(printf "${L[status_running_count]}" "${active_count}" "${total_count}")${NC}"
    echo ""
    press_enter
}

# ══════════════════════════════════════════════════════════════════
# ПОДМЕНЮ: СЕРВИСЫ RETICULUM
# ══════════════════════════════════════════════════════════════════

menu_services() {
    local DEF=""
    while true; do
        # Полный статус КАЖДОГО сервиса в шапку (как в оригинале, но без эмодзи, с \Z-цветами)
        local STATUS=""
        for service in "${SERVICES[@]}"; do
            local nm="${SERVICE_NAMES[$service]:-$service}"
            # убираем эмодзи и ведущий пробел из имени
            nm=$(printf '%s' "$nm" | sed -E 's/^[^[:alnum:]A-Za-zА-Яа-я]+[[:space:]]*//')
            local st=$(get_service_status "$service")
            if [ "$st" = "active" ]; then
                STATUS="${STATUS}\Z2●\Zn ${nm} \Z2${L[st_running]}\Zn\n"
            else
                STATUS="${STATUS}\Z1●\Zn ${nm} \Z1${L[st_stopped]}\Zn\n"
            fi
        done

        # Динамические группы (созданные через бота): lxmf_group_*
        for gdir in /root/.config/lxmf_group_*; do
            [ -d "$gdir" ] && [ -f "$gdir/identity" ] || continue
            local gnm=$(get_group_display_name "$gdir")
            local gsvc=$(get_group_service "$gdir")
            local glk=""
            is_group_private "$gdir" && glk=" \Z3${L[ag_private]}\Zn"
            if [ "$(get_service_status "$gsvc")" = "active" ]; then
                STATUS="${STATUS}\Z2●\Zn ${gnm}${glk} \Z2${L[st_running]}\Zn\n"
            else
                STATUS="${STATUS}\Z1●\Zn ${gnm}${glk} \Z1${L[st_stopped]}\Zn\n"
            fi
        done

        local GROUP_NAME="$(get_group_name)"
        local BOT_NAME="$(get_bot_name)"

        dlg_menu "${L[svc_title]}" "$STATUS" "$DEF" \
            "1"  "${C_RETICULUM}Reticulum Stack\Zn" \
            "2"  "${C_NOMADNET}NomadNet\Zn" \
            "3"  "${C_GROUP}${GROUP_NAME}\Zn" \
            "4"  "${C_BOT}${BOT_NAME}\Zn" \
            "5"  "${C_BOARD}messageboard\Zn" \
            "6"  "${C_GROUPS}${L[svc_m_groups]}\Zn" \
            "a"  "${C_START}${L[svc_m_start_all]}\Zn" \
            "s"  "${C_STOP}${L[svc_m_stop_all]}\Zn" \
            "r"  "${C_RESTART}${L[svc_m_restart_all]}\Zn" \
            "n"  "${C_ANNOUNCE}${L[svc_m_announce_all]}\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) menu_single_service "reticulum.service" ;;
            2) menu_nomadnet ;;
            3) menu_group ;;
            4) menu_surgutbot ;;
            5) menu_messageboard ;;
            6) menu_all_groups ;;
            a) start_all ;;
            s) 
                if verify_pin "${L[svc_stopall_reason]}"; then
                    stop_all
                fi
                ;;
            r) restart_all ;;
            n) announce_all ;;
            *) ;;
        esac
    done
}

# Меню для одного сервиса
menu_single_service() {
    local service=$1
    local name="${SERVICE_NAMES[$service]:-$service}"
    # чистое имя без эмодзи для заголовка dialog
    local clean_name=$(printf '%s' "$name" | sed -E 's/^[^[:alnum:]A-Za-zА-Яа-я]+[[:space:]]*//')
    local DEF=""

    while true; do
        # Статус сервиса в шапку (без эмодзи, с \Z-цветами)
        local st=$(get_service_status "$service")
        local STATUS
        if [ "$st" = "active" ]; then
            STATUS="\Z2● ${clean_name} ${L[st_running]}\Zn"
        else
            STATUS="\Z1● ${clean_name} ${L[st_stopped]}\Zn"
        fi

        # Собираем пункты (пункт 6 только для NomadNet)
        local items=(
            "1" "${C_START}${L[ss_m_start]}\Zn"
            "2" "${C_STOP}${L[ss_m_stop]}\Zn"
            "3" "${C_RESTART}${L[ss_m_restart]}\Zn"
            "4" "${C_MON}${L[ss_m_logs]}\Zn"
            "5" "${C_NOMADNET}${L[ss_m_status]}\Zn"
        )
        if [ "$service" = "nomadnet.service" ]; then
            items+=( "6" "${C_GROUP}${L[ss_m_tui]}\Zn" )
        fi

        dlg_menu "$clean_name" "$STATUS" "$DEF" "${items[@]}"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) 
                start_service "$service"
                press_enter
                ;;
            2) 
                if verify_pin "$(printf "${L[ss_stop_reason]}" "$name")"; then
                    stop_service "$service"
                    press_enter
                fi
                ;;
            3) 
                restart_service "$service"
                press_enter
                ;;
            4)
                view_live_log "$(printf "${L[bot_logs_hdr]}" "$clean_name")" -u "$service" -f --no-pager -n 50
                ;;
            5)
                echo ""
                systemctl status "$service" --no-pager
                press_enter
                ;;
            6)
                if [ "$service" = "nomadnet.service" ]; then
                    launch_nomadnet_interactive
                fi
                ;;
            *) ;;
        esac
    done
}

