# Просмотр лог-файла с пагинацией
view_log_file() {
    local log_file="$1"
    local title="$2"
    
    if [ ! -f "$log_file" ]; then
        echo ""
        echo -e "${YELLOW}${L[log_file_notfound]}${NC}"
        press_enter
        return
    fi
    
    local lines=$(wc -l < "$log_file")
    if [ "$lines" -eq 0 ]; then
        echo ""
        echo -e "${YELLOW}${L[log_empty]}${NC}"
        press_enter
        return
    fi
    
    local page_size=30
    local total_pages=$(( (lines + page_size - 1) / page_size ))
    local current_page=1
    
    while true; do
        clear
        echo ""
        echo -e "${CYAN}$(printf "${L[log_view_file_hdr]}" "$title")${NC}"
        echo -e "${GRAY}$(printf "${L[log_entries]}" "$lines" "$current_page" "$total_pages")${NC}"
        echo -e "${GRAY}${L[log_nav_hint2]}${NC}"
        print_line
        echo ""
        
        local start_line=$(( (current_page - 1) * page_size + 1 ))
        sed -n "${start_line},+$((page_size - 1))p" "$log_file"
        
        echo ""
        print_line
        echo -ne "${CYAN}${L[log_choice]}${NC}"
        local choice=$(read_key)
        
        if [[ "$choice" == "ESC" ]] || [[ -z "$choice" ]]; then
            return
        fi
        
        choice=$(convert_ru_to_en "$choice")
        
        case $choice in
            n|N) 
                if [ "$current_page" -lt "$total_pages" ]; then
                    ((current_page++))
                fi
                ;;
            p|P)
                if [ "$current_page" -gt 1 ]; then
                    ((current_page--))
                fi
                ;;
            f|F) current_page=1 ;;
            l|L) current_page=$total_pages ;;
            *) ;;
        esac
    done
}

# Меню управления доверенными
menu_trusted_users() {
    local bot_db="${BOT_HOME}/bot_data"
    local DEF=""

    while true; do
        # Текущий список доверенных в шапку
        local STATUS="\Z7${L[tu_subtitle]}\Zn\n"
        if [ -f "$bot_db" ]; then
            local trusted=$(sqlite3 "$bot_db" "SELECT value FROM key_value WHERE key='trusted_users'" 2>/dev/null)
            if [ -n "$trusted" ] && [ "$trusted" != "[]" ]; then
                local list=$(echo "$trusted" | TU_TOTAL="${L[tu_total]}" "$VENV_PATH/bin/python3" -c "
import sys, json, os
data = json.loads(sys.stdin.read())
for i, h in enumerate(data, 1):
    print(f'{i}. {h}')
print(f\"{os.environ.get('TU_TOTAL','Total:')} {len(data)}\")
" 2>/dev/null)
                STATUS="${STATUS}${list}"
            else
                STATUS="${STATUS}\Z3${L[tu_empty]}\Zn"
            fi
        else
            STATUS="${STATUS}\Z1${L[tu_db_notfound]}\Zn"
        fi

        dlg_menu "${L[tu_title]}" "$STATUS" "$DEF" \
            "1" "${C_START}${L[tu_m_add]}\Zn" \
            "2" "${C_STOP}${L[tu_m_remove]}\Zn" \
            "3" "${C_MON}${L[tu_m_refresh]}\Zn" \
            "4" "${C_GROUP}${L[tu_m_commands]}\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) add_trusted_user ;;
            2) remove_trusted_user ;;
            3) ;; # просто обновит экран
            4) show_bot_commands ;;
            *) ;;
        esac
    done
}

# Показать команды бота
show_bot_commands() {
    echo ""
    echo -e "${CYAN}${L[cmd_hdr]}${NC}"
    echo ""
    echo -e "${WHITE}${L[cmd_admin]}${NC}"
    echo -e "  /adminhelp       - ${L[cmd_adminhelp]}"
    echo ""
    echo -e "${WHITE}${L[cmd_whitelist]}${NC}"
    echo -e "  /trust <hash>    - ${L[cmd_trust]}"
    echo -e "  /untrust <hash>  - ${L[cmd_untrust]}"
    echo -e "  /trusted         - ${L[cmd_trusted]}"
    echo ""
    echo -e "${WHITE}${L[cmd_groups_hdr]}${NC}"
    echo -e "  /newgroup ${L[cmd_arg_name]}            - ${L[cmd_newgroup]}"
    echo -e "  /newgroup ${L[cmd_arg_name]} private    - ${L[cmd_newgroup_priv]}"
    echo -e "  /delgroup ${L[cmd_arg_name]}            - ${L[cmd_delgroup]}"
    echo -e "  /renamegroup ${L[cmd_arg_old_new]} - ${L[cmd_renamegroup]}"
    echo -e "  /setprivate ${L[cmd_arg_name]}          - ${L[cmd_setprivate]}"
    echo -e "  /setpublic ${L[cmd_arg_name]}           - ${L[cmd_setpublic]}"
    echo -e "  /groups                         - ${L[cmd_groups]}"
    echo -e "  /group ${L[cmd_arg_name]}               - ${L[cmd_group]}"
    echo ""
    echo -e "${WHITE}${L[cmd_stats_hdr]}${NC}"
    echo -e "  /stats           - ${L[cmd_stats]}"
    echo -e "  /status          - ${L[cmd_status]}"
    echo -e "  /models          - ${L[cmd_models]}"
    echo -e "  /setmodel ${L[cmd_arg_model]} - ${L[cmd_setmodel]}"
    echo -e "  /clearall        - ${L[cmd_clearall]}"
    echo ""
    press_enter
}

# Добавление доверенного
add_trusted_user() {
    local bot_db="${BOT_HOME}/bot_data"

    local user_hash
    user_hash=$(dialog --colors \
        --backtitle "RETICULUM CONTROL" \
        --title "${L[tu_add_title]}" \
        --ok-label "${L[btn_open]}" --cancel-label "${L[btn_back]}" \
        --inputbox "${L[tu_add_prompt]}" 12 56 \
        3>&1 1>&2 2>&3)
    local rc=$?
    clear
    [ $rc -ne 0 ] && return          # отмена
    [ -z "$user_hash" ] && return

    # Проверка формата
    if [[ ! "$user_hash" =~ ^[a-fA-F0-9]{32}$ ]]; then
        dlg_msg "${L[tu_bad_format]}"
        return
    fi
    
    user_hash=$(echo "$user_hash" | tr '[:upper:]' '[:lower:]')
    
    # Получаем текущий список
    local trusted=$(sqlite3 "$bot_db" "SELECT value FROM key_value WHERE key='trusted_users'" 2>/dev/null)
    if [ -z "$trusted" ]; then
        trusted="[]"
    fi
    
    # Проверяем есть ли уже
    if echo "$trusted" | grep -q "$user_hash"; then
        echo -e "${YELLOW}${L[tu_already]}${NC}"
        press_enter
        return
    fi
    
    # Добавляем через Python
    local new_trusted=$("$VENV_PATH/bin/python3" -c "
import json
data = json.loads('$trusted')
data.append('$user_hash')
print(json.dumps(data))
" 2>/dev/null)
    
    # Сохраняем
    sqlite3 "$bot_db" "INSERT OR REPLACE INTO key_value (key, value) VALUES ('trusted_users', '$new_trusted')" 2>/dev/null
    
    echo ""
    echo -e "${GREEN}${L[tu_added]}${WHITE}$user_hash${NC}"
    echo -e "${YELLOW}${L[tu_can_create]}${NC}"
    press_enter
}

# Удаление доверенного
remove_trusted_user() {
    local bot_db="${BOT_HOME}/bot_data"

    # Получаем текущий список
    local trusted=$(sqlite3 "$bot_db" "SELECT value FROM key_value WHERE key='trusted_users'" 2>/dev/null)
    if [ -z "$trusted" ] || [ "$trusted" == "[]" ]; then
        dlg_msg "\n\Z3${L[tu_empty]}\Zn"
        return
    fi

    # Список доверенных в массив
    local users_array=()
    while IFS= read -r line; do
        users_array+=("$line")
    done < <("$VENV_PATH/bin/python3" -c "
import json
data = json.loads('$trusted')
for h in data:
    print(h)
" 2>/dev/null)

    # Собираем пункты для dialog
    local items=()
    local i=1
    for h in "${users_array[@]}"; do
        items+=( "$i" "${C_RETICULUM}${h}\Zn" )
        ((i++))
    done

    dlg_menu "${L[tu_remove_title]}" "${L[tu_remove_prompt]}" "" "${items[@]}"
    local choice="$DLG_CHOICE"
    clear
    [ -z "$choice" ] && return        # отмена

    if [[ ! "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#users_array[@]}" ]; then
        return
    fi

    local user_to_remove="${users_array[$((choice-1))]}"

    # Подтверждение
    if ! dlg_confirm "$(printf "${L[tu_remove_confirm]}" "${user_to_remove}")"; then
        return
    fi

    # Удаляем через Python
    local new_trusted=$("$VENV_PATH/bin/python3" -c "
import json
data = json.loads('$trusted')
data.remove('$user_to_remove')
print(json.dumps(data))
" 2>/dev/null)

    # Сохраняем
    sqlite3 "$bot_db" "INSERT OR REPLACE INTO key_value (key, value) VALUES ('trusted_users', '$new_trusted')" 2>/dev/null

    dlg_msg "$(printf "${L[tu_removed]}" "${user_to_remove}")"
}
# ============================================================
# Обновление прошивок RNode (вызов fetch-rnode-firmware.sh)
# ============================================================

FETCH_SCRIPT="/root/reticulum-node-stack/scripts/fetch-rnode-firmware.sh"

update_rnode_firmware_select() {
    print_header
    echo -e "${WHITE}${BOLD}${L[rf_update_one]}${NC}"
    print_line
    echo ""
    echo -e "${CYAN}${L[rf_avail_devices]}${NC}"
    echo -e "  ${GRAY}t114, lora32v2, lora32v3, heltec32v4${NC}"
    echo -e "  ${GRAY}tbeam, tbeam_supreme, tbeam_sx1262${NC}"
    echo -e "  ${GRAY}t3s3, t3s3_sx127x, t3s3_sx1280${NC}"
    echo -e "  ${GRAY}tdeck, techo, rak4631${NC}"
    echo -e "  ${GRAY}lora32v10, lora32v20, lora32v21${NC}"
    echo -e "  ${GRAY}esp32, feather, ng20, ng21, xiao${NC}"
    echo ""
    echo -ne "${CYAN}${L[rf_device_prompt]}${NC}"
    read device_name
    if [ -z "$device_name" ]; then
        echo -e "${GRAY}${L[rf_cancelled]}${NC}"
        press_enter
        return
    fi
    echo ""
    "$FETCH_SCRIPT" "$device_name"
    press_enter
}

menu_rnode_firmware() {
    local DEF=""
    while true; do
        local STATUS="\Z7${L[rf_source]}\Zn\n${L[rf_backup]}"

        dlg_menu "${L[rf_title]}" "$STATUS" "$DEF" \
            "1" "${C_START}${L[rf_m_all]}\Zn" \
            "2" "${C_MON}${L[rf_m_missing]}\Zn" \
            "3" "${C_RESTART}${L[rf_m_one]}\Zn" \
            "4" "${C_NOMADNET}${L[rf_m_list]}\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1)
                if verify_pin "${L[rf_reason_all]}"; then
                    echo ""
                    "$FETCH_SCRIPT"
                    press_enter
                fi
                ;;
            2)
                echo ""
                "$FETCH_SCRIPT" --missing
                press_enter
                ;;
            3)
                if verify_pin "${L[rf_reason_one]}"; then
                    update_rnode_firmware_select
                fi
                ;;
            4)
                echo ""
                "$FETCH_SCRIPT" --list
                press_enter
                ;;
            *) ;;
        esac
    done
}
menu_surgutbot() {
    local service="surgutbot86.service"
    local name="${SERVICE_NAMES[$service]}"
    local clean_name=$(printf '%s' "$name" | sed -E 's/^[^[:alnum:]A-Za-zА-Яа-я]+[[:space:]]*//')
    local DEF=""

    while true; do
        local st=$(get_service_status "$service")
        local bot_hash=$(get_lxmf_hash "${BOT_HOME}/config/identity")
        local STATUS
        if [ "$st" = "active" ]; then
            STATUS="\Z2● ${clean_name} ${L[st_running]}\Zn"
        else
            STATUS="\Z1● ${clean_name} ${L[st_stopped]}\Zn"
        fi
        # Динамический LXMF-адрес бота в шапку
        [ -n "$bot_hash" ] && STATUS="${STATUS}\n\Z7LXMF:\Zn ${bot_hash}"
        STATUS="${STATUS}\n\Z7${L[cfg_file]}\Zn ${BOT_HOME}"

        dlg_menu "$clean_name" "$STATUS" "$DEF" \
            "1" "${C_START}${L[ss_m_start]}\Zn" \
            "2" "${C_STOP}${L[ss_m_stop]}\Zn" \
            "3" "${C_RESTART}${L[ss_m_restart]}\Zn" \
            "4" "${C_MON}${L[ss_m_logs]}\Zn" \
            "5" "${C_NOMADNET}${L[ss_m_status]}\Zn" \
            "6" "${C_GROUP}${L[bot_m_stats]}\Zn" \
            "7" "${C_ENV}${L[bot_m_kb]}\Zn" \
            "f" "${C_NOMADNET}${L[bot_m_firmware]}\Zn" \
            "e" "${C_STOP}${L[bot_m_editcode]}\Zn" \
            "s" "${C_MON}${L[bot_m_settings]}\Zn" \
            "t" "${C_START}${L[bot_m_trusted]}\Zn" \
            "l" "${C_BOARD}${L[bot_m_msglogs]}\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) start_service "$service"; press_enter ;;
            2) 
                if verify_pin "${L[bot_stop_reason]}"; then
                    stop_service "$service"
                    press_enter
                fi
                ;;
            3) restart_service "$service"; press_enter ;;
            4)
                view_live_log "$(printf "${L[bot_logs_hdr]}" "$clean_name")" -u "$service" -f --no-pager -n 50
                ;;
            5)
                echo ""
                systemctl status "$service" --no-pager
                press_enter
                ;;
            6) show_bot_stats ;;
            7) 
                if verify_pin "${L[bot_kb_reason]}"; then
                    menu_knowledge_base
                fi
                ;;
            f)
                menu_rnode_firmware
                ;;
            e) 
                if verify_pin "${L[bot_editcode_reason]}"; then
                    edit_bot_code
                fi
                ;;
            s)
                if verify_pin "${L[bot_settings_reason]}"; then
                    edit_bot_settings
                fi
                ;;
            t)
                if verify_pin "${L[bot_trusted_reason]}"; then
                    menu_trusted_users
                fi
                ;;
            l)
                if verify_pin "${L[bot_logs_reason]}"; then
                    menu_bot_logs
                fi
                ;;
            *) ;;
        esac
    done
}


# Статистика бота
show_bot_stats() {
    echo ""
    echo -e "${CYAN}${L[bot_stats_hdr]}${NC}"
    echo ""
    
    local bot_db="${BOT_HOME}/bot_data"
    
    if [ -f "$bot_db" ]; then
        # Всего сообщений
        local total_msg=$(sqlite3 "$bot_db" "SELECT value FROM key_value WHERE key='stat_total_messages'" 2>/dev/null || echo "0")
        echo -e "  📨 ${L[bot_stat_total_msg]} ${WHITE}${total_msg:-0}${NC}"
        
        # Всего пользователей
        local total_users=$(sqlite3 "$bot_db" "SELECT value FROM key_value WHERE key='stat_total_users'" 2>/dev/null || echo "0")
        echo -e "  ${L[bot_stat_total_users]} ${WHITE}${total_users:-0}${NC}"
        
        # Активные сегодня
        local today=$(date +%Y-%m-%d)
        local dau=$(sqlite3 "$bot_db" "SELECT value FROM key_value WHERE key='stat_dau_$today'" 2>/dev/null)
        if [ -n "$dau" ]; then
            local dau_count=$(echo "$dau" | grep -o '"' | wc -l)
            dau_count=$((dau_count / 2))
            echo -e "  📅 ${L[bot_stat_active_today]} ${WHITE}$dau_count${NC}"
        else
            echo -e "  📅 ${L[bot_stat_active_today]} ${WHITE}0${NC}"
        fi
        
        echo ""
        
        # Использование ресурсов
        local pid=$(systemctl show -p MainPID "$service" 2>/dev/null | cut -d= -f2)
        if [ "$pid" != "0" ] && [ -n "$pid" ]; then
            echo -e "  ${GRAY}$(printf "${L[bot_stat_resources]}" "$pid")${NC}"
            ps -p "$pid" -o %cpu,%mem,rss --no-headers 2>/dev/null | \
                awk '{printf "  CPU: %s%%  MEM: %s%%  RAM: %.1f MB\n", $1, $2, $3/1024}'
        fi
    else
        echo -e "  ${RED}${L[bot_db_notfound]}${NC}"
    fi
    
    press_enter
}

menu_bot() {
    menu_surgutbot
}

# ══════════════════════════════════════════════════════════════════
# ПОДМЕНЮ: НАСТРОЙКИ RNODE
# ══════════════════════════════════════════════════════════════════

menu_rnode_settings() {
    local rnode_port=""
    
    # Ищем порт RNode
    for port in /dev/ttyACM0 /dev/ttyACM1 /dev/ttyUSB0 /dev/ttyUSB1; do
        if [ -e "$port" ]; then
            rnode_port="$port"
            break
        fi
    done

    if [ -z "$rnode_port" ]; then
        dlg_msg "${L[rn_notfound]}"
        return
    fi

    local DEF=""
    while true; do
        local STATUS="\Z2$(printf "${L[rn_port]}" "${rnode_port}")\Zn"

        dlg_menu "${L[rn_title]}" "$STATUS" "$DEF" \
            "1" "${C_START}${L[rn_t_30]}\Zn" \
            "2" "${C_NOMADNET}${L[rn_t_60]}\Zn" \
            "3" "${C_MON}${L[rn_t_120]}\Zn" \
            "4" "${C_GROUP}${L[rn_t_255]}\Zn" \
            "5" "${C_RESTART}${L[rn_t_always]}\Zn" \
            "6" "${C_ENV}${L[rn_t_custom]}\Zn" \
            "b" "${C_ANNOUNCE}${L[rn_brightness]}\Zn" \
            "i" "${C_BOARD}${L[rn_info]}\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) set_rnode_timeout "$rnode_port" 30; press_enter ;;
            2) set_rnode_timeout "$rnode_port" 60; press_enter ;;
            3) set_rnode_timeout "$rnode_port" 120; press_enter ;;
            4) set_rnode_timeout "$rnode_port" 255; press_enter ;;
            5) set_rnode_timeout "$rnode_port" 0; press_enter ;;
            6)
                local custom_timeout
                custom_timeout=$(dialog --colors \
                    --backtitle "RETICULUM CONTROL" \
                    --title "${L[rn_timeout_title]}" \
                    --ok-label "${L[btn_open]}" --cancel-label "${L[btn_back]}" \
                    --inputbox "${L[rn_timeout_prompt]}" 11 50 \
                    3>&1 1>&2 2>&3)
                local rc=$?
                clear
                [ $rc -ne 0 ] && continue
                if [[ "$custom_timeout" =~ ^[0-9]+$ ]] && [ "$custom_timeout" -ge 0 ] && [ "$custom_timeout" -le 255 ]; then
                    set_rnode_timeout "$rnode_port" "$custom_timeout"
                    press_enter
                else
                    dlg_msg "${L[rn_bad_value]}"
                fi
                ;;
            b)
                local brightness
                brightness=$(dialog --colors \
                    --backtitle "RETICULUM CONTROL" \
                    --title "${L[rn_bright_title]}" \
                    --ok-label "${L[btn_open]}" --cancel-label "${L[btn_back]}" \
                    --inputbox "${L[rn_bright_prompt]}" 11 50 \
                    3>&1 1>&2 2>&3)
                local rc=$?
                clear
                [ $rc -ne 0 ] && continue
                if [[ "$brightness" =~ ^[0-9]+$ ]] && [ "$brightness" -ge 0 ] && [ "$brightness" -le 255 ]; then
                    set_rnode_brightness "$rnode_port" "$brightness"
                    press_enter
                else
                    dlg_msg "${L[rn_bad_value]}"
                fi
                ;;
            i)
                show_rnode_info "$rnode_port"
                ;;
            *) ;;
        esac
    done
}

set_rnode_timeout() {
    local port="$1"
    local timeout="$2"
    
    echo ""
    echo -e "${YELLOW}${L[rn_stopping_ret]}${NC}"
    sudo systemctl stop reticulum.service
    sleep 1
    
    echo -e "${YELLOW}${L[rn_port_speed]}${NC}"
    stty -F "$port" 9600
    
    echo -e "${YELLOW}$(printf "${L[rn_set_timeout]}" "${timeout}")${NC}"
    "$VENV_PATH/bin/rnodeconf" "$port" -t "$timeout"
    
    echo -e "${YELLOW}${L[rn_starting_ret]}${NC}"
    sudo systemctl start reticulum.service
    sleep 1
    
    if [ "$timeout" -eq 0 ]; then
        echo -e "${GREEN}${L[rn_screen_always]}${NC}"
    else
        echo -e "${GREEN}$(printf "${L[rn_screen_off_after]}" "${timeout}")${NC}"
    fi
    press_enter
}

set_rnode_brightness() {
    local port="$1"
    local brightness="$2"
    
    echo ""
    echo -e "${YELLOW}${L[rn_stopping_ret]}${NC}"
    sudo systemctl stop reticulum.service
    sleep 1
    
    echo -e "${YELLOW}${L[rn_port_speed]}${NC}"
    stty -F "$port" 9600
    
    echo -e "${YELLOW}$(printf "${L[rn_set_bright]}" "${brightness}")${NC}"
    "$VENV_PATH/bin/rnodeconf" "$port" -D "$brightness"
    
    echo -e "${YELLOW}${L[rn_starting_ret]}${NC}"
    sudo systemctl start reticulum.service
    sleep 1
    
    if [ "$brightness" -eq 0 ]; then
        echo -e "${GREEN}${L[rn_screen_off]}${NC}"
    else
        echo -e "${GREEN}$(printf "${L[rn_bright_set]}" "${brightness}")${NC}"
    fi
    press_enter
}

show_rnode_info() {
    local port="$1"

    # Собираем ПОЛНЫЙ список сервисов, которые могут держать RNode-порт:
    # статичные из SERVICES + динамические группы lxmf_group_*
    local all_svc=()
    for s in "${SERVICES[@]}"; do
        all_svc+=("$s")
    done
    for dir in /root/.config/lxmf_group_*; do
        if [ -d "$dir" ] && [ -f "$dir/identity" ]; then
            all_svc+=("$(basename "$dir").service")
        fi
    done

    # Запоминаем, какие из них СЕЙЧАС активны (чтобы поднять обратно только их)
    local was_active=()
    for s in "${all_svc[@]}"; do
        if systemctl is-active --quiet "$s" 2>/dev/null; then
            was_active+=("$s")
        fi
    done

    echo ""
    echo -e "${YELLOW}${L[rn_stopping_svc]}${NC}"
    # Останавливаем в обратном порядке (сначала зависимые, потом ядро)
    for (( i=${#was_active[@]}-1; i>=0; i-- )); do
        sudo systemctl stop "${was_active[i]}" 2>/dev/null
    done
    sleep 1

    echo -e "${YELLOW}${L[rn_port_speed]}${NC}"
    stty -F "$port" 9600

    echo ""
    echo -e "${CYAN}${L[rn_info_hdr]}${NC}"
    echo ""
    "$VENV_PATH/bin/rnodeconf" "$port" -i

    echo ""
    echo -e "${YELLOW}${L[rn_starting_svc]}${NC}"
    # Поднимаем в прямом порядке (ядро первым, зависимые потом)
    for s in "${was_active[@]}"; do
        sudo systemctl start "$s" 2>/dev/null
        echo -e "  ${GREEN}✓${NC} $s"
    done

    press_enter
}

# ══════════════════════════════════════════════════════════════════
# СМЕНА ЯЗЫКА ИНТЕРФЕЙСА
# Сохраняет выбор в $LANG_FILE и перезагружает словарь «на лету»
# (load_lang), оставаясь в текущем меню. Главное меню и все
# последующие экраны перерисуются на новом языке.
# ══════════════════════════════════════════════════════════════════
switch_language() {
    local DEF_L="1"
    [[ "$LANG_RN" == "en" ]] && DEF_L="2"
    dlg_menu "${L[lang_title]}" "${L[lang_prompt]}\n" "$DEF_L" \
        "1" "${L[lang_ru]}" \
        "2" "${L[lang_en]}"
    [ -z "$DLG_CHOICE" ] && return

    local new_lang="ru"
    [ "$DLG_CHOICE" = "2" ] && new_lang="en"

    # Если язык не изменился — просто выходим
    [ "$new_lang" = "$LANG_RN" ] && return

    mkdir -p "$(dirname "$LANG_FILE")" 2>/dev/null
    echo "$new_lang" > "$LANG_FILE"

    # Перезагружаем словарь на лету — без перезапуска процесса,
    # чтобы остаться в текущем меню.
    LANG_RN="$new_lang"
    load_lang
}

# ══════════════════════════════════════════════════════════════════
# ПОДМЕНЮ: ОКРУЖЕНИЕ
# ══════════════════════════════════════════════════════════════════

menu_environment() {
    local DEF=""
    while true; do
        # Статус venv и SSH в шапку (без эмодзи, с \Z-цветами)
        local STATUS=""
        if check_venv_active; then
            STATUS="\Z2${L[env_venv_active]}\Zn\n"
        else
            STATUS="\Z3${L[env_venv_inactive]}\Zn\n"
        fi
        local ssh_listen=$(ss -tlnp 2>/dev/null | grep ":${SSH_PORT}" | awk '{print $4}' | cut -d: -f1)
        if [ "$ssh_listen" = "0.0.0.0" ]; then
            STATUS="${STATUS}\Z2● SSH [0.0.0.0:${SSH_PORT}]\Zn"
        elif [ "$ssh_listen" = "127.0.0.1" ]; then
            STATUS="${STATUS}\Z1$(printf "${L[env_ssh_local]}" "${SSH_PORT}")\Zn"
        else
            STATUS="${STATUS}\Z3${L[env_ssh_unknown]}\Zn"
        fi

        dlg_menu "${L[env_title]}" "$STATUS" "$DEF" \
            "1" "${C_START}${L[env_m_venv]}\Zn" \
            "2" "${C_NOMADNET}${L[env_m_workdir]}\Zn" \
            "3" "${C_MON}${L[env_m_versions]}\Zn" \
            "4" "${C_RESTART}${L[env_m_update]}\Zn" \
            "5" "${C_GROUP}${L[env_m_showcfg]}\Zn" \
            "6" "${C_ENV}${L[env_m_editcfg]}\Zn" \
            "7" "${C_BOARD}${L[env_m_rnode]}\Zn" \
            "8" "${C_STOP}${L[env_m_ssh]}\Zn" \
            "p" "${C_MON}${L[env_m_pypi]}\Zn" \
            "l" "${L[m_lang]}\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1)
                echo ""
                echo -e "${CYAN}${L[env_venv_howto]}${NC}"
                echo -e "${WHITE}source $VENV_PATH/bin/activate${NC}"
                echo ""
                echo -e "${GRAY}${L[env_venv_note]}${NC}"
                press_enter
                ;;
            2)
                echo ""
                echo -e "${CYAN}${L[env_cd_howto]}${NC}"
                echo -e "${WHITE}cd $WORK_DIR${NC}"
                press_enter
                ;;
            3)
                echo ""
                echo -e "${CYAN}${L[env_versions_hdr]}${NC}"
                echo ""
                "$VENV_PATH/bin/pip" list | grep -i -E "rns|nomad|lxmf|reticulum" 2>/dev/null || echo "${L[env_pkg_notfound]}"
                press_enter
                ;;
            4)
                if verify_pin "${L[env_update_reason]}"; then
                    echo ""
                    echo -e "${YELLOW}${L[env_updating]}${NC}"
                    echo ""
                    if ensure_pypi_access; then
                        echo ""
                        "$VENV_PATH/bin/pip" install --upgrade rns nomadnet lxmf
                        log_action "UPDATED: Reticulum packages"
                    else
                        echo ""
                        echo -e "${RED}${L[env_pypi_noaccess]}${NC}"
                        echo -e "${GRAY}${L[env_check_inet]}${NC}"
                        echo -e "${GRAY}${L[env_add_ip]}${NC}"
                    fi
                    press_enter
                fi
                ;;
            5)
                echo ""
                echo -e "${CYAN}${L[env_cfg_hdr]}${NC}"
                echo ""
                if [ -f ~/.reticulum/config ]; then
                    cat ~/.reticulum/config
                else
                    echo "${L[env_cfg_notfound]}"
                fi
                press_enter
                ;;
            6)
                if [ -f ~/.reticulum/config ]; then
                    if verify_pin "${L[env_editcfg_reason]}"; then
                        ${EDITOR:-nano} ~/.reticulum/config
                    fi
                else
                    echo "${L[env_cfg_notfound_short]}"
                    press_enter
                fi
                ;;
            7)
                menu_rnode_settings
                ;;
            8)
                menu_ssh_settings
                ;;
            p)
                echo ""
                echo -e "${CYAN}${L[env_pypi_hdr]}${NC}"
                echo ""
                local cur_hosts
                cur_hosts=$(grep -E "pypi\.org|files\.pythonhosted\.org" /etc/hosts 2>/dev/null)
                if [ -n "$cur_hosts" ]; then
                    echo -e "${GRAY}${L[env_pypi_current]}${NC}"
                    echo "$cur_hosts" | while read -r line; do
                        echo -e "  ${WHITE}$line${NC}"
                    done
                    echo ""
                fi
                if ensure_pypi_access; then
                    echo ""
                    echo -e "${GREEN}${L[env_pypi_ok]}${NC}"
                else
                    echo ""
                    echo -e "${RED}${L[env_pypi_fail]}${NC}"
                fi
                press_enter
                ;;
            l)
                switch_language
                ;;
            *) ;;
        esac
    done
}

# ══════════════════════════════════════════════════════════════════
# ПОДМЕНЮ: НАСТРОЙКИ SSH
# ══════════════════════════════════════════════════════════════════

menu_ssh_settings() {
    local DEF=""
    while true; do
        # Статус SSH в шапку (без эмодзи, с \Z-цветами)
        local ssh_port=$(grep "^Port" /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}')
        local ssh_listen=$(ss -tlnp 2>/dev/null | grep ":${ssh_port:-22}" | awk '{print $4}' | cut -d: -f1)
        local root_login=$(grep "^PermitRootLogin" /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}')

        local STATUS="\Z7${L[ssh_port_label]}\Zn ${ssh_port:-22}\n"
        if [ "$ssh_listen" = "0.0.0.0" ]; then
            STATUS="${STATUS}\Z7${L[ssh_listen_label]}\Zn \Z2${L[ssh_listen_all]}\Zn\n"
        elif [ "$ssh_listen" = "127.0.0.1" ]; then
            STATUS="${STATUS}\Z7${L[ssh_listen_label]}\Zn \Z1${L[ssh_listen_local]}\Zn\n"
        else
            STATUS="${STATUS}\Z7${L[ssh_listen_label]}\Zn \Z3${ssh_listen}\Zn\n"
        fi
        STATUS="${STATUS}\Z7${L[ssh_rootlogin_label]}\Zn ${root_login:-yes}"

        dlg_menu "${L[ssh_title]}" "$STATUS" "$DEF" \
            "1" "${C_START}${L[ssh_m_edit]}\Zn" \
            "2" "${C_RESTART}${L[ssh_m_restart]}\Zn" \
            "3" "${C_NOMADNET}${L[ssh_m_status]}\Zn" \
            "4" "${C_MON}${L[ssh_m_conns]}\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1)
                if ! verify_pin "${L[ssh_edit_reason]}"; then continue; fi
                echo ""
                echo -e "${CYAN}${L[ssh_edit_hdr]}${NC}"
                echo ""
                echo -e "${YELLOW}${L[ssh_edit_warn]}${NC}"
                echo -e "${GRAY}${L[ssh_edit_note]}${NC}"
                echo ""
                sleep 1
                sudo nano /etc/ssh/sshd_config
                if dlg_confirm "${L[ssh_restart_confirm]}"; then
                    sudo systemctl restart sshd
                    dlg_msg "${L[ssh_restarted]}"
                fi
                ;;
            2)
                if ! verify_pin "${L[ssh_restart_reason]}"; then continue; fi
                echo ""
                echo -e "${YELLOW}${L[ssh_restarting]}${NC}"
                sudo systemctl restart sshd
                sleep 1
                local new_listen=$(ss -tlnp 2>/dev/null | grep ":${ssh_port:-22}" | awk '{print $4}')
                echo -e "${GREEN}${L[ssh_restarted_plain]}${NC}"
                echo -e "  ${L[ssh_listening_plain]} ${WHITE}$new_listen${NC}"
                press_enter
                ;;
            3)
                echo ""
                systemctl status sshd --no-pager
                press_enter
                ;;
            4)
                echo ""
                echo -e "${CYAN}${L[ssh_conns_hdr]}${NC}"
                echo ""
                who | grep -v "^$" || echo "${L[ssh_no_conns]}"
                echo ""
                echo -e "${GRAY}${L[ssh_details]}${NC}"
                ss -tnp | grep ":${ssh_port:-22}" | head -10 || echo "${L[ssh_no_conns2]}"
                press_enter
                ;;
            *) ;;
        esac
    done
}

# ══════════════════════════════════════════════════════════════════
# ПОДМЕНЮ: МОНИТОРИНГ
# ══════════════════════════════════════════════════════════════════

menu_monitoring() {
    local DEF=""
    while true; do
        dlg_menu "${L[mon_title]}" "\Z4${L[mon_subtitle]}\Zn" "$DEF" \
            "1" "${C_START}${L[mon_m_status]}\Zn" \
            "2" "${C_MON}${L[mon_m_logs]}\Zn" \
            "3" "${C_NOMADNET}${L[mon_m_ifaces]}\Zn" \
            "4" "${C_GROUP}${L[mon_m_peers]}\Zn" \
            "5" "${C_RESTART}${L[mon_m_resources]}\Zn" \
            "6" "${C_ENV}${L[mon_m_actionlog]}\Zn" \
            "7" "${C_BOARD}messageboard\Zn" \
            "8" "${C_GROUPS}${L[mon_m_pages]}\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) show_status ;;
            2)
                view_live_log "${L[mon_logs_hdr]}" -u reticulum.service -u nomadnet.service -f --no-pager -n 30
                ;;
            3)
                echo ""
                echo -e "${CYAN}${L[mon_ifaces_hdr]}${NC}"
                echo ""
                "$VENV_PATH/bin/rnstatus" 2>/dev/null || echo "${L[mon_rnstatus_na]}"
                press_enter
                ;;
            4)
                echo ""
                echo -e "${CYAN}${L[mon_peers_hdr]}${NC}"
                echo ""
                "$VENV_PATH/bin/rnpath" -t 2>/dev/null || echo "${L[mon_rnpath_na]}"
                press_enter
                ;;
            5)
                echo ""
                echo -e "${CYAN}${L[mon_resources_hdr]}${NC}"
                echo ""
                for service in "${SERVICES[@]}"; do
                    local name="${SERVICE_NAMES[$service]:-$service}"
                    local pid=$(systemctl show -p MainPID "$service" 2>/dev/null | cut -d= -f2)
                    if [ "$pid" != "0" ] && [ -n "$pid" ]; then
                        echo -e "${WHITE}$name (PID: $pid)${NC}"
                        ps -p "$pid" -o %cpu,%mem,rss --no-headers 2>/dev/null | \
                            awk '{printf "  CPU: %s%%  MEM: %s%%  RSS: %.1f MB\n", $1, $2, $3/1024}'
                    fi
                done
                press_enter
                ;;
            6)
                echo ""
                echo -e "${CYAN}${L[mon_actionlog_hdr]}${NC}"
                echo ""
                if [ -f "$LOG_FILE" ]; then
                    tail -30 "$LOG_FILE"
                else
                    echo "${L[mon_log_empty]}"
                fi
                press_enter
                ;;
            7) menu_messageboard ;;
            8) menu_pages ;;
            *) ;;
        esac
    done
}

# ══════════════════════════════════════════════════════════════════
# ПОДМЕНЮ: ПРОСМОТР СТРАНИЦ УЗЛА
# ══════════════════════════════════════════════════════════════════

menu_pages() {
    local DEF=""
    while true; do
        # Список страниц динамически
        local pages=()
        local items=()
        local i=1
        for page in "$PAGES_PATH"/*.mu; do
            if [ -f "$page" ]; then
                local pagename=$(basename "$page")
                pages+=("$page")
                items+=( "$i" "${C_RETICULUM}${pagename}\Zn" )
                ((i++))
            fi
        done

        local STATUS
        if [ ${#pages[@]} -eq 0 ]; then
            STATUS="\Z3${L[pg_none]}\Zn"
        else
            STATUS="\Z4$(printf "${L[pg_count]}" "${#pages[@]}")\Zn"
        fi

        dlg_menu "${L[pg_title]}" "$STATUS" "$DEF" "${items[@]}"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"
        local choice="$DLG_CHOICE"

        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#pages[@]}" ]; then
            local selected_page="${pages[$((choice-1))]}"
            page_actions_menu "$selected_page"
        fi
    done
}

# Меню действий со страницей
page_actions_menu() {
    local page_path="$1"
    local pagename=$(basename "$page_path")
    local DEF=""

    while true; do
        dlg_menu "$pagename" "\Z4${L[pg_actions]}\Zn" "$DEF" \
            "1" "${C_NOMADNET}${L[pg_a_view]}\Zn" \
            "2" "${C_START}${L[pg_a_edit]}\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) view_page_without_counter "$page_path" ;;
            2) 
                if verify_pin "${L[pg_edit_reason]}"; then
                    edit_page "$page_path"
                fi
                ;;
            *) ;;
        esac
    done
}

# Редактирование страницы
edit_page() {
    local page_path="$1"
    local pagename=$(basename "$page_path")
    
    echo ""
    echo -e "${CYAN}$(printf "${L[pg_edit_hdr]}" "$pagename")${NC}"
    echo ""
    echo -e "${YELLOW}${L[pg_edit_warn]}${NC}"
    echo -e "${GRAY}${L[pg_opening_nano]}${NC}"
    echo -e "${GRAY}${L[pg_nano_keys]}${NC}"
    sleep 1
    
    sudo nano "$page_path"
    
    echo ""
    echo -e "${GREEN}${L[pg_edit_done]}${NC}"
    press_enter
}

# Просмотр страницы без увеличения счётчика
view_page_without_counter() {
    local page_path="$1"
    local pagename=$(basename "$page_path")
    
    echo ""
    echo -e "${CYAN}═══ $pagename ═══${NC}"
    echo ""
    
    # Проверяем, является ли страница скриптом Python
    if head -1 "$page_path" | grep -q "python"; then
        # Для Python скриптов показываем исходный код
        echo -e "${GRAY}${L[pg_py_script]}${NC}"
        echo ""
        cat "$page_path"
    else
        # Для обычных страниц показываем содержимое
        cat "$page_path"
    fi
    
    press_enter
}

# ══════════════════════════════════════════════════════════════════
# УПРАВЛЕНИЕ ГРУППАМИ (созданными ботом)
# ══════════════════════════════════════════════════════════════════

# Получить имя группы из конфига
get_group_display_name() {
    local config_path="$1"
    local name=""
    
    if [ -f "$config_path/config.cfg.owr" ]; then
        name=$(grep "^display_name" "$config_path/config.cfg.owr" 2>/dev/null | head -1 | cut -d'=' -f2 | xargs)
    fi
    
    if [ -z "$name" ] && [ -f "$config_path/config.cfg" ]; then
        name=$(grep "^display_name" "$config_path/config.cfg" 2>/dev/null | head -1 | cut -d'=' -f2 | xargs)
    fi
    
    if [ -z "$name" ]; then
        name=$(basename "$config_path")
    fi
    
    echo "$name"
}

# Получить сервис группы
get_group_service() {
    local config_path="$1"
    local dir_name=$(basename "$config_path")
    echo "${dir_name}.service"
}

# Получить хэш группы
get_group_hash() {
    local config_path="$1"
    local identity_file="$config_path/identity"
    
    if [ -f "$identity_file" ]; then
        "$VENV_PATH/bin/python3" -c "
import RNS
identity = RNS.Identity.from_file('$identity_file')
h = RNS.Destination.hash(identity, 'lxmf', 'delivery')
print(h.hex())
" 2>/dev/null
    fi
}

# Получить LXMF-адрес из произвольного identity-файла (например, бота)
get_lxmf_hash() {
    local identity_file="$1"
    [ -f "$identity_file" ] || return
    "$VENV_PATH/bin/python3" -c "
import RNS
identity = RNS.Identity.from_file('$identity_file')
h = RNS.Destination.hash(identity, 'lxmf', 'delivery')
print(h.hex())
" 2>/dev/null
}

# Просмотр живого лога с выходом по ESC (вместо Ctrl+C).
# Аргументы: $1 = заголовок (уже готовый текст), далее — аргументы journalctl.
# journalctl запускается в фоне; нажатие ESC его останавливает и возвращает
# в меню. Хвостовые байты автоповтора ESC дочищаются, чтобы не попасть в шелл.
view_live_log() {
    local header="$1"; shift
    clear
    echo ""
    echo -e "${CYAN}${header}${NC}"
    echo -e "${GRAY}${L[log_esc_hint]}${NC}"
    echo ""

    # journalctl в фоне, вывод — прямо в терминал.
    # Скрипт уже работает под root (self-sudo в начале), поэтому sudo здесь
    # не нужен — так $! указывает прямо на journalctl и его легко остановить.
    journalctl "$@" &
    local jpid=$!

    # Ждём ESC; как только пришёл — гасим journalctl
    local key
    while kill -0 "$jpid" 2>/dev/null; do
        if read -rsn1 -t 0.3 key 2>/dev/null; then
            if [ "$key" = $'\e' ]; then
                break
            fi
        fi
    done
    kill "$jpid" 2>/dev/null
    wait "$jpid" 2>/dev/null
    # Дочистить возможный хвост автоповтора ESC
    while read -rsn1 -t 0.02 key 2>/dev/null; do :; done
    clear
}

# Проверить приватная ли группа
is_group_private() {
    local config_path="$1"
    local data_file="$config_path/data.cfg"
    
    if [ -f "$data_file" ]; then
        grep -q "auto_add_user_type = wait" "$data_file" 2>/dev/null && return 0
    fi
    return 1
}

# Меню всех групп (только lxmf_group_*, без SURGUT GROUP)
menu_all_groups() {
    local DEF=""
    while true; do
        local groups_arr=()
        local items=()
        local groups_active=0
        local i=1

        # Только lxmf_group_* — без lxmf_distribution_group_extended (SURGUT GROUP)
        for dir in /root/.config/lxmf_group_*; do
            if [ -d "$dir" ] && [ -f "$dir/identity" ]; then
                groups_arr+=("$dir")
                local name=$(get_group_display_name "$dir")
                local service=$(get_group_service "$dir")
                local status=$(get_service_status "$service")
                local lock=""
                is_group_private "$dir" && lock=" \Z3${L[ag_private]}\Zn"

                if [ "$status" = "active" ]; then
                    items+=( "$i" "\Z2●\Zn ${name}${lock}" )
                    ((groups_active++))
                else
                    items+=( "$i" "\Z1○\Zn ${name}${lock}" )
                fi
                ((i++))
            fi
        done

        # Статус в шапку
        local STATUS
        if [ ${#groups_arr[@]} -eq 0 ]; then
            STATUS="\Z3${L[ag_none]}\Zn\n${L[ag_create_hint]}"
        else
            if [ $groups_active -eq ${#groups_arr[@]} ]; then
                STATUS="\Z2$(printf "${L[ag_running]}" "${groups_active}" "${#groups_arr[@]}")\Zn"
            elif [ $groups_active -eq 0 ]; then
                STATUS="\Z1$(printf "${L[ag_running]}" "${groups_active}" "${#groups_arr[@]}")\Zn"
            else
                STATUS="\Z3$(printf "${L[ag_running]}" "${groups_active}" "${#groups_arr[@]}")\Zn"
            fi
        fi

        # Добавляем действия (буквы как в оригинале)
        items+=( "a" "${C_START}${L[ag_m_start_all]}\Zn" )
        items+=( "s" "${C_STOP}${L[ag_m_stop_all]}\Zn" )
        items+=( "r" "${C_RESTART}${L[ag_m_restart_all]}\Zn" )

        dlg_menu "${L[ag_title]}" "$STATUS" "$DEF" "${items[@]}"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"
        local choice="$DLG_CHOICE"

        clear
        case "$choice" in
            [1-9]|[1-9][0-9])
                local idx=$((choice - 1))
                if [ $idx -lt ${#groups_arr[@]} ]; then
                    menu_single_group_full "${groups_arr[$idx]}"
                fi
                ;;
            a)
                echo ""
                echo -e "${YELLOW}${L[ag_starting_all]}${NC}"
                for dir in "${groups_arr[@]}"; do
                    local service=$(get_group_service "$dir")
                    start_service "$service"
                done
                press_enter
                ;;
            s)
                if verify_pin "${L[ag_stop_all_reason]}"; then
                    echo ""
                    echo -e "${YELLOW}${L[ag_stopping_all]}${NC}"
                    for dir in "${groups_arr[@]}"; do
                        local service=$(get_group_service "$dir")
                        stop_service "$service"
                    done
                    press_enter
                fi
                ;;
            r)
                echo ""
                echo -e "${YELLOW}${L[ag_restarting_all]}${NC}"
                for dir in "${groups_arr[@]}"; do
                    local service=$(get_group_service "$dir")
                    restart_service "$service"
                done
                press_enter
                ;;
            *) ;;
        esac
    done
}

# Полное меню для одной группы
menu_single_group_full() {
    local config_path="$1"
    local DEF=""

    while true; do
        # Динамически читаем имя/сервис/хеш (вдруг переименовали)
        local name=$(get_group_display_name "$config_path")
        local service=$(get_group_service "$config_path")
        local group_hash=$(get_group_hash "$config_path")
        local lock=""
        is_group_private "$config_path" && lock=" \Z3${L[ag_private]}\Zn"

        # Статус в шапку
        local st=$(get_service_status "$service")
        local STATUS
        if [ "$st" = "active" ]; then
            STATUS="\Z2● ${name}${lock} \Z2${L[st_running]}\Zn\n"
        else
            STATUS="\Z1● ${name}${lock} \Z1${L[st_stopped]}\Zn\n"
        fi
        STATUS="${STATUS}\Z7LXMF:\Zn ${group_hash}\n\Z7${L[cfg_file]}\Zn ${config_path}"

        dlg_menu "$name" "$STATUS" "$DEF" \
            "1" "${C_START}${L[ss_m_start]}\Zn" \
            "2" "${C_STOP}${L[ss_m_stop]}\Zn" \
            "3" "${C_RESTART}${L[ss_m_restart]}\Zn" \
            "4" "${C_MON}${L[ss_m_logs]}\Zn" \
            "5" "${C_NOMADNET}${L[ss_m_status]}\Zn" \
            "6" "${C_GROUP}${L[sg_m_members]}\Zn" \
            "7" "${C_BOARD}${L[sg_m_wait]}\Zn" \
            "8" "${C_ENV}${L[sg_m_stats]}\Zn" \
            "d" "${C_STOP}${L[grp_m_edit_data]}\Zn" \
            "c" "${C_GROUP}${L[grp_m_edit_config]}\Zn" \
            "o" "${C_RESTART}${L[grp_m_edit_owr]}\Zn" \
            "n" "${C_ANNOUNCE}${L[sg_m_announce]}\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) start_service "$service"; press_enter ;;
            2) 
                if verify_pin "$(printf "${L[sg_stop_reason]}" "$name")"; then
                    stop_service "$service"
                    press_enter
                fi
                ;;
            3) restart_service "$service"; press_enter ;;
            4)
                view_live_log "$(printf "${L[bot_logs_hdr]}" "$name")" -u "$service" -f --no-pager -n 50
                ;;
            5)
                echo ""
                systemctl status "$service" --no-pager
                press_enter
                ;;
            6) show_group_members_generic "$config_path" ;;
            7) show_group_wait_list "$config_path" ;;
            8) show_group_stats_generic "$config_path" "$service" ;;
            d)
                if verify_pin "${L[grp_edit_data_reason]}"; then
                    edit_group_file_generic "$config_path/data.cfg" "data.cfg"
                fi
                ;;
            c)
                if verify_pin "${L[grp_edit_config_reason]}"; then
                    edit_group_file_generic "$config_path/config.cfg" "config.cfg"
                fi
                ;;
            o)
                if verify_pin "${L[grp_edit_owr_reason]}"; then
                    edit_group_file_generic "$config_path/config.cfg.owr" "config.cfg.owr"
                fi
                ;;
            n)
                echo ""
                echo -e "${YELLOW}${L[sg_announcing]}${NC}"
                local svc=$(get_group_service "$config_path")
                # Включаем announce_startup
                sed -i 's/announce_startup = No/announce_startup = Yes/' "$config_path/config.cfg"
                sed -i 's/announce_startup = No/announce_startup = Yes/' "$config_path/config.cfg.owr" 2>/dev/null
                # Перезапускаем группу
                sudo systemctl restart "$svc"
                sleep 3
                # Возвращаем обратно
                sed -i 's/announce_startup = Yes/announce_startup = No/' "$config_path/config.cfg"
                sed -i 's/announce_startup = Yes/announce_startup = No/' "$config_path/config.cfg.owr" 2>/dev/null
                echo -e "${GREEN}${L[sg_announced]}${NC}"
                press_enter
                ;;
            *) ;;
        esac
    done
}

# Редактирование файла группы (универсальная функция)
edit_group_file_generic() {
    local file_path="$1"
    local file_name="$2"
    
    echo ""
    echo -e "${CYAN}$(printf "${L[gg_edit_hdr]}" "$file_name")${NC}"
    echo ""
    
    if [ -f "$file_path" ]; then
        local lines=$(wc -l < "$file_path")
        local size=$(du -h "$file_path" | cut -f1)
        echo -e "  📄 ${L[cfg_file]} ${WHITE}$file_path${NC}"
        echo -e "  📊 $(printf "${L[cfg_lines_size]}" "$lines" "$size")"
        echo ""
    else
        echo -e "  ${RED}${L[cfg_notfound]}${NC}"
        press_enter
        return
    fi
    
    echo -e "${GRAY}${L[cfg_opening_nano]}${NC}"
    echo -e "${GRAY}${L[cfg_nano_keys]}${NC}"
    sleep 1
    
    sudo nano "$file_path"
    
    echo ""
    echo -e "${GREEN}${L[cfg_edit_done]}${NC}"
    echo -e "${YELLOW}${L[cfg_restart_group]}${NC}"
    press_enter
}

# Участники группы (универсальная функция)
show_group_members_generic() {
    local config_path="$1"
    local data_file="$config_path/data.cfg"
    local name=$(get_group_display_name "$config_path")
    
    echo ""
    echo -e "${CYAN}$(printf "${L[gg_members_hdr]}" "$name")${NC}"
    echo ""
    
    if [ -f "$data_file" ]; then
        GG_ADMINS="${L[gg_admins_py]}" GG_MODS="${L[gg_mods_py]}" GG_USERS="${L[gg_users_py]}" \
        GG_GUESTS="${L[gg_guests_py]}" GG_BLOCKED="${L[gg_blocked_py]}" GG_TOTAL="${L[gg_total_py]}" \
        "$VENV_PATH/bin/python3" << PYEOF
import configparser
import os

data_file = "$data_file"
config = configparser.ConfigParser()
config.read(data_file)

L_ADMINS = os.environ.get('GG_ADMINS')
L_MODS = os.environ.get('GG_MODS')
L_USERS = os.environ.get('GG_USERS')
L_GUESTS = os.environ.get('GG_GUESTS')
L_BLOCKED = os.environ.get('GG_BLOCKED')
L_TOTAL = os.environ.get('GG_TOTAL')

total = 0

if 'admin' in config.sections():
    admins = dict(config['admin'])
    if admins:
        print(f"  \033[1;31m{L_ADMINS}\033[0m")
        for hash_addr, nick in admins.items():
            nick = nick.strip() if nick.strip() else hash_addr[:16]
            print(f"     \033[1;37m{nick}\033[0m")
            print(f"     \033[0;90m{hash_addr}\033[0m")
            total += 1
        print()

if 'mod' in config.sections():
    mods = dict(config['mod'])
    if mods:
        print(f"  \033[1;35m{L_MODS}\033[0m")
        for hash_addr, nick in mods.items():
            nick = nick.strip() if nick.strip() else hash_addr[:16]
            print(f"     \033[1;37m{nick}\033[0m")
            print(f"     \033[0;90m{hash_addr}\033[0m")
            total += 1
        print()

if 'user' in config.sections():
    users = dict(config['user'])
    if users:
        print(f"  \033[1;32m{L_USERS}\033[0m")
        for hash_addr, nick in users.items():
            nick = nick.strip() if nick.strip() else hash_addr[:16]
            print(f"     \033[1;37m{nick}\033[0m \033[0;90m[{hash_addr[:16]}...]\033[0m")
            total += 1
        print()

if 'guest' in config.sections():
    guests = dict(config['guest'])
    if guests:
        print(f"  \033[1;36m{L_GUESTS}\033[0m")
        for hash_addr, nick in guests.items():
            nick = nick.strip() if nick.strip() else hash_addr[:16]
            print(f"     \033[0;90m{nick} [{hash_addr[:16]}...]\033[0m")
            total += 1
        print()

for section in ['block_admin', 'block_mod', 'block_user', 'block_guest', 'block_wait']:
    if section in config.sections():
        blocked = dict(config[section])
        if blocked:
            print(f"  \033[0;31m{L_BLOCKED}\033[0m")
            for hash_addr, nick in blocked.items():
                nick = nick.strip() if nick.strip() else hash_addr[:16]
                print(f"     \033[0;90m{nick} [{hash_addr[:16]}...]\033[0m")
            print()
            break

print(f"  \033[1;37m{L_TOTAL} {total}\033[0m")
PYEOF
    else
        echo -e "  ${RED}${L[gg_data_notfound]}${NC}"
    fi
    
    press_enter
}

# Список ожидающих (wait)
show_group_wait_list() {
    local config_path="$1"
    local data_file="$config_path/data.cfg"
    local name=$(get_group_display_name "$config_path")
    
    echo ""
    echo -e "${CYAN}$(printf "${L[gg_wait_hdr]}" "$name")${NC}"
    echo ""
    
    if [ -f "$data_file" ]; then
        GG_WAITING="${L[gg_waiting_py]}" GG_NONAME="${L[gg_noname_py]}" GG_TOTAL_WAIT="${L[gg_total_wait_py]}" \
        GG_ALLOW="${L[gg_allow_py]}" GG_DENY="${L[gg_deny_py]}" GG_NOWAIT="${L[gg_no_wait_py]}" \
        "$VENV_PATH/bin/python3" << PYEOF
import configparser
import os

data_file = "$data_file"
config = configparser.ConfigParser()
config.read(data_file)

L_WAITING = os.environ.get('GG_WAITING')
L_NONAME = os.environ.get('GG_NONAME')
L_TOTAL_WAIT = os.environ.get('GG_TOTAL_WAIT')
L_ALLOW = os.environ.get('GG_ALLOW')
L_DENY = os.environ.get('GG_DENY')
L_NOWAIT = os.environ.get('GG_NOWAIT')

if 'wait' in config.sections():
    wait_list = dict(config['wait'])
    if wait_list:
        print(f"  \033[1;33m{L_WAITING}\033[0m")
        print()
        for i, (hash_addr, nick) in enumerate(wait_list.items(), 1):
            nick = nick.strip() if nick.strip() else L_NONAME
            print(f"  {i}. \033[1;37m{nick}\033[0m")
            print(f"     \033[0;90m{hash_addr}\033[0m")
            print()
        print(f"  \033[0;33m{L_TOTAL_WAIT} {len(wait_list)}\033[0m")
        print()
        print(f"  \033[0;90m{L_ALLOW}\033[0m")
        print(f"  \033[0;90m{L_DENY}\033[0m")
    else:
        print(f"  \033[0;32m{L_NOWAIT}\033[0m")
else:
    print(f"  \033[0;32m{L_NOWAIT}\033[0m")
PYEOF
    else
        echo -e "  ${RED}${L[gg_data_notfound]}${NC}"
    fi
    
    press_enter
}

# Статистика группы (универсальная)
show_group_stats_generic() {
    local config_path="$1"
    local service="$2"
    local name=$(get_group_display_name "$config_path")
    local data_file="$config_path/data.cfg"
    local stat_file="$config_path/statistic.cfg"
    
    echo ""
    echo -e "${CYAN}$(printf "${L[gg_stats_hdr]}" "$name")${NC}"
    echo ""
    
    local group_hash=$(get_group_hash "$config_path")
    echo -e "  ${WHITE}${L[gg_name]}${NC} $name"
    echo -e "  ${WHITE}${L[gg_lxmf]}${NC} $group_hash"
    
    if is_group_private "$config_path"; then
        echo -e "  ${WHITE}${L[gg_type_priv]}${NC}"
    else
        echo -e "  ${WHITE}${L[gg_type_pub]}${NC}"
    fi
    echo ""
    
    if [ -f "$data_file" ]; then
        GG_ADMINS="${L[gg_admins_n_py]}" GG_MODS="${L[gg_mods_n_py]}" GG_USERS="${L[gg_users_n_py]}" \
        GG_GUESTS="${L[gg_guests_n_py]}" GG_WAIT="${L[gg_wait_n_py]}" GG_TOTAL="${L[gg_total_n_py]}" \
        "$VENV_PATH/bin/python3" << PYEOF
import configparser
import os

data_file = "$data_file"
config = configparser.ConfigParser()
config.read(data_file)

admins = len(dict(config['admin'])) if 'admin' in config.sections() else 0
mods = len(dict(config['mod'])) if 'mod' in config.sections() else 0
users = len(dict(config['user'])) if 'user' in config.sections() else 0
guests = len(dict(config['guest'])) if 'guest' in config.sections() else 0
wait = len(dict(config['wait'])) if 'wait' in config.sections() else 0

print(f"  {os.environ.get('GG_ADMINS')} {admins}")
print(f"  {os.environ.get('GG_MODS')} {mods}")
print(f"  {os.environ.get('GG_USERS')} {users}")
print(f"  {os.environ.get('GG_GUESTS')} {guests}")
print(f"  {os.environ.get('GG_WAIT')} {wait}")
print(f"  ─────────────────")
print(f"  {os.environ.get('GG_TOTAL')} {admins + mods + users + guests}")
PYEOF
    fi
    
    echo ""
    
    if [ -f "$stat_file" ]; then
        echo -e "  ${WHITE}${L[gg_msg_stats]}${NC}"
        GG_RECEIVED="${L[gg_received_py]}" GG_SENT="${L[gg_sent_py]}" \
        "$VENV_PATH/bin/python3" << PYEOF
import configparser
import os

stat_file = "$stat_file"
config = configparser.ConfigParser()
config.read(stat_file)

if 'main' in config.sections():
    main = config['main']
    rx = main.get('rx_count', '0')
    tx = main.get('tx_count', '0')
    print(f"     {os.environ.get('GG_RECEIVED')} {rx}")
    print(f"     {os.environ.get('GG_SENT')} {tx}")
PYEOF
    fi
    
    echo ""
    
    local pid=$(systemctl show -p MainPID "$service" 2>/dev/null | cut -d= -f2)
    if [ "$pid" != "0" ] && [ -n "$pid" ]; then
        echo -e "  ${GRAY}$(printf "${L[gg_resources]}" "$pid")${NC}"
        ps -p "$pid" -o %cpu,%mem,rss --no-headers 2>/dev/null | \
            awk '{printf "  CPU: %s%%  MEM: %s%%  RAM: %.1f MB\n", $1, $2, $3/1024}'
    fi
    
    press_enter
}

# Удаление сообщения с доски
delete_board_message() {
    echo ""
    echo -e "${CYAN}${L[bd_del_hdr]}${NC}"
    echo ""
    
    if [ ! -f "$BOARD_PATH" ]; then
        echo -e "${RED}${L[bd_notfound]}${NC}"
        press_enter
        return
    fi
    
    # Показываем сообщения с номерами
    BD_EMPTY="${L[bd_empty_py]}" BD_TOTAL="${L[bd_total_py]}" BD_ERR="${L[bd_err_py]}" \
    "$VENV_PATH/bin/python3" << 'PYEOF'
import RNS.vendor.umsgpack as msgpack
import os

board_path = "/root/.nomadmb/storage/board"
L_EMPTY = os.environ.get('BD_EMPTY', 'Board is empty')
L_TOTAL = os.environ.get('BD_TOTAL', 'Total messages:')
L_ERR = os.environ.get('BD_ERR', 'Error:')

try:
    with open(board_path, 'rb') as f:
        messages = msgpack.unpack(f)
    
    if not messages:
        print(L_EMPTY)
    else:
        print(f"{L_TOTAL} {len(messages)}\n")
        for i, msg in enumerate(messages, 1):
            clean = msg.replace('`F888', '').replace('`Fddd', '').replace('`Fd8f', '').replace('`f', '')
            preview = clean[:80] + "..." if len(clean) > 80 else clean
            print(f"  [{i}] {preview}")
except Exception as e:
    print(f"{L_ERR} {e}")
PYEOF

    echo ""
    echo -ne "${WHITE}${L[bd_del_prompt]}${NC}"
    read msg_num
    
    if [ "$msg_num" == "0" ] || [ -z "$msg_num" ]; then
        echo -e "${GRAY}${L[bd_cancelled]}${NC}"
        press_enter
        return
    fi
    
    # Удаляем сообщение
    BD_BADNUM="${L[bd_bad_num_py]}" BD_DELETED="${L[bd_deleted_py]}" BD_ERR="${L[bd_err_py]}" \
    "$VENV_PATH/bin/python3" << PYEOF
import RNS.vendor.umsgpack as msgpack
import os

board_path = "/root/.nomadmb/storage/board"
msg_num = $msg_num
L_BADNUM = os.environ.get('BD_BADNUM', 'Invalid number. Available: 1-')
L_DELETED = os.environ.get('BD_DELETED', '✓ Message #%d deleted:')
L_ERR = os.environ.get('BD_ERR', 'Error:')

try:
    with open(board_path, 'rb') as f:
        messages = msgpack.unpack(f)
    
    if msg_num < 1 or msg_num > len(messages):
        print(f"\033[0;31m{L_BADNUM}{len(messages)}\033[0m")
    else:
        deleted = messages.pop(msg_num - 1)
        with open(board_path, 'wb') as f:
            msgpack.pack(messages, f)
        clean = deleted.replace('\`F888', '').replace('\`Fddd', '')[:50]
        print(f"\033[0;32m{L_DELETED % msg_num} {clean}...\033[0m")
except Exception as e:
    print(f"\033[0;31m{L_ERR} {e}\033[0m")
PYEOF
    
    press_enter
}

# Экспорт доски (бэкап сообщений в файл)
export_board() {
    echo ""
    echo -e "${CYAN}${L[bd_exp_hdr]}${NC}"
    echo ""

    if [ ! -f "$BOARD_PATH" ]; then
        echo -e "${YELLOW}${L[bd_exp_empty]}${NC}"
        press_enter
        return
    fi

    local count
    count=$("$VENV_PATH/bin/python3" -c "
import RNS.vendor.umsgpack as msgpack
with open('$BOARD_PATH', 'rb') as f:
    print(len(msgpack.unpack(f)))
" 2>/dev/null || echo "?")

    local backup_dir
    backup_dir="$(dirname "$(dirname "$BOARD_PATH")")/backups"
    local default_file="$backup_dir/board_backup_$(date +%Y%m%d_%H%M%S).msgpack"

    echo -e "  ${L[bd_msgs_on_board]} ${WHITE}$count${NC}"
    echo ""
    echo -e "${GRAY}${L[bd_save_where]}${NC}"
    echo -e "${GRAY}  $default_file${NC}"
    echo -ne "${WHITE}${L[bd_path]}${NC}"
    read -r dest
    dest="${dest/#\~/$HOME}"
    [ -z "$dest" ] && dest="$default_file"

    mkdir -p "$(dirname "$dest")" 2>/dev/null
    if cp "$BOARD_PATH" "$dest" 2>/dev/null; then
        echo ""
        echo -e "${GREEN}${L[bd_saved]}${NC}"
        echo -e "  ${WHITE}$dest${NC}"
        echo ""
        echo -e "${GRAY}${L[bd_copy_hint]}${NC}"
        echo -e "${GRAY}  scp '$dest' user@newhost:~/${NC}"
    else
        echo -e "${RED}$(printf "${L[bd_save_fail]}" "$dest")${NC}"
    fi
    press_enter
}

# Импорт доски (восстановление сообщений из файла)
import_board() {
    echo ""
    echo -e "${CYAN}${L[bd_imp_hdr]}${NC}"
    echo ""
    echo -e "${YELLOW}${L[bd_imp_warn]}${NC}"
    echo -e "${GRAY}${L[bd_imp_note]}${NC}"
    echo ""

    local backup_dir
    backup_dir="$(dirname "$(dirname "$BOARD_PATH")")/backups"

    # Собираем доступные бэкапы (новые сверху)
    local files=()
    if [ -d "$backup_dir" ]; then
        while IFS= read -r f; do
            [ -n "$f" ] && files+=("$f")
        done < <(ls -1t "$backup_dir"/*.msgpack 2>/dev/null)
    fi

    local src=""
    if [ ${#files[@]} -gt 0 ]; then
        echo -e "${WHITE}$(printf "${L[bd_found_in]}" "$backup_dir")${NC}"
        echo ""
        local i=1
        for f in "${files[@]}"; do
            local cnt sz mt
            cnt=$("$VENV_PATH/bin/python3" -c "
import RNS.vendor.umsgpack as msgpack
with open('$f','rb') as fh: print(len(msgpack.unpack(fh)))
" 2>/dev/null || echo "?")
            sz=$(du -h "$f" 2>/dev/null | cut -f1)
            mt=$(date -r "$f" '+%Y-%m-%d %H:%M' 2>/dev/null)
            echo -e "  ${LIGHT_GREEN}[$i]${NC} $(basename "$f")"
            echo -e "      ${GRAY}$mt · $sz · ${L[bd_msgs_label]} $cnt${NC}"
            i=$((i+1))
        done
        echo ""
        echo -e "${GRAY}${L[bd_enter_num_path]}${NC}"
        echo -ne "${WHITE}${L[bd_choice]}${NC}"
        read -r pick
        pick="${pick/#\~/$HOME}"

        if [ "$pick" == "0" ] || [ -z "$pick" ]; then
            echo -e "${GRAY}${L[bd_cancelled]}${NC}"
            press_enter
            return
        fi
        if [[ "$pick" =~ ^[0-9]+$ ]] && [ "$pick" -ge 1 ] && [ "$pick" -le ${#files[@]} ]; then
            src="${files[$((pick-1))]}"
        else
            src="$pick"
        fi
    else
        echo -e "${GRAY}$(printf "${L[bd_none_in]}" "$backup_dir")${NC}"
        echo -ne "${WHITE}${L[bd_path_prompt]}${NC}"
        read -r src
        src="${src/#\~/$HOME}"
        if [ "$src" == "0" ] || [ -z "$src" ]; then
            echo -e "${GRAY}${L[bd_cancelled]}${NC}"
            press_enter
            return
        fi
    fi

    if [ ! -f "$src" ]; then
        echo -e "${RED}$(printf "${L[bd_file_notfound]}" "$src")${NC}"
        press_enter
        return
    fi

    # Валидация: это читаемая msgpack-доска (список)?
    local count
    count=$("$VENV_PATH/bin/python3" -c "
import RNS.vendor.umsgpack as msgpack, sys
try:
    with open('$src', 'rb') as f:
        data = msgpack.unpack(f)
    if not isinstance(data, list):
        sys.exit(1)
    print(len(data))
except Exception:
    sys.exit(1)
" 2>/dev/null)
    if [ -z "$count" ]; then
        echo -e "${RED}${L[bd_not_board]}${NC}"
        press_enter
        return
    fi

    echo ""
    echo -e "  ${L[bd_msgs_in_backup]} ${WHITE}$count${NC}"
    echo -ne "${WHITE}${L[bd_restore_q]}${NC}"
    read -r confirm
    # Enter (пусто) или y/д = применить; только явное n/н = отмена
    if [[ "$confirm" =~ ^[nNтТ] ]]; then
        echo -e "${GRAY}${L[bd_cancelled]}${NC}"
        press_enter
        return
    fi

    mkdir -p "$(dirname "$BOARD_PATH")" 2>/dev/null
    if [ -f "$BOARD_PATH" ]; then
        local bak="${BOARD_PATH}.bak.$(date +%Y%m%d_%H%M%S)"
        cp "$BOARD_PATH" "$bak" && echo -e "${GRAY}$(printf "${L[bd_cur_saved]}" "$bak")${NC}"
    fi

    if cp "$src" "$BOARD_PATH"; then
        echo -e "${GREEN}$(printf "${L[bd_restored]}" "$count")${NC}"
        echo -e "${GRAY}${L[bd_restart_mb]}${NC}"
        restart_service "messageboard.service"
    else
        echo -e "${RED}${L[bd_restore_fail]}${NC}"
    fi
    press_enter
}

# ══════════════════════════════════════════════════════════════════
# ПОДМЕНЮ: ДОСКА ОБЪЯВЛЕНИЙ
# ══════════════════════════════════════════════════════════════════

menu_messageboard() {
    local DEF=""
    while true; do
        # Статус сервиса доски в шапку
        local st=$(get_service_status "messageboard.service")
        local STATUS
        if [ "$st" = "active" ]; then
            STATUS="\Z2● messageboard ${L[st_running]}\Zn"
        else
            STATUS="\Z1● messageboard ${L[st_stopped]}\Zn"
        fi

        dlg_menu "${L[mb_title]}" "$STATUS" "$DEF" \
            "1"  "${C_START}${L[ss_m_start]}\Zn" \
            "2"  "${C_STOP}${L[ss_m_stop]}\Zn" \
            "3"  "${C_RESTART}${L[ss_m_restart]}\Zn" \
            "4"  "${C_MON}${L[ss_m_logs]}\Zn" \
            "5"  "${C_NOMADNET}${L[mb_m_view]}\Zn" \
            "6"  "${C_GROUP}${L[mb_m_stats]}\Zn" \
            "7"  "${C_STOP}${L[mb_m_delete]}\Zn" \
            "8"  "${C_GROUPS}${L[mb_m_announce]}\Zn" \
            "9"  "${C_STOP}${L[mb_m_block]}\Zn" \
            "u"  "${C_START}${L[mb_m_unblock]}\Zn" \
            "e"  "${C_BOARD}${L[mb_m_export]}\Zn" \
            "i"  "${C_NOMADNET}${L[mb_m_import]}\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1)
                start_service "messageboard.service"
                press_enter
                ;;
            2)
                if verify_pin "${L[mb_stop_reason]}"; then
                    stop_service "messageboard.service"
                    press_enter
                fi
                ;;
            3)
                restart_service "messageboard.service"
                press_enter
                ;;
            4)
                view_live_log "${L[mb_logs_hdr]}" -u messageboard.service -f --no-pager -n 50
                ;;
            5)
                echo ""
                echo -e "${CYAN}${L[mb_msgs_hdr]}${NC}"
                echo ""
                if [ -f "$BOARD_PATH" ]; then
                    MB_TOTAL="${L[mb_total_msgs]}" MB_EMPTY="${L[mb_board_empty_py]}" MB_ERR="${L[mb_read_err]}" \
                    "$VENV_PATH/bin/python3" -c "
import RNS.vendor.umsgpack as msgpack
import os
L_TOTAL = os.environ.get('MB_TOTAL', 'Total messages:')
L_EMPTY = os.environ.get('MB_EMPTY', 'Board is empty')
L_ERR = os.environ.get('MB_ERR', 'Read error:')
try:
    with open('$BOARD_PATH', 'rb') as f:
        messages = msgpack.unpack(f)
    if messages:
        print(f'{L_TOTAL} {len(messages)}\n')
        for i, msg in enumerate(messages[-10:], 1):
            clean = msg.replace('\`F888', '').replace('\`Fddd', '').replace('\`Fd8f', '').replace('\`f', '')
            print(f'{i}. {clean[:100]}...' if len(clean) > 100 else f'{i}. {clean}')
    else:
        print(L_EMPTY)
except Exception as e:
    print(f'{L_ERR} {e}')
" 2>/dev/null || echo "${L[mb_read_fail]}"
                else
                    echo -e "${GRAY}${L[mb_empty]}${NC}"
                fi
                press_enter
                ;;
            6)
                echo ""
                echo -e "${CYAN}${L[mb_stats_hdr]}${NC}"
                echo ""
                local pid=$(systemctl show -p MainPID messageboard.service 2>/dev/null | cut -d= -f2)
                if [ "$pid" != "0" ] && [ -n "$pid" ]; then
                    echo -e "${WHITE}$(printf "${L[mb_board_label]}" "$pid")${NC}"
                    ps -p "$pid" -o %cpu,%mem,rss --no-headers 2>/dev/null | \
                        awk '{printf "  CPU: %s%%  MEM: %s%%  RSS: %.1f MB\n", $1, $2, $3/1024}'
                    echo ""
                fi
                if [ -f "$BOARD_PATH" ]; then
                    local msg_count=$("$VENV_PATH/bin/python3" -c "
import RNS.vendor.umsgpack as msgpack
with open('$BOARD_PATH', 'rb') as f:
    print(len(msgpack.unpack(f)))
" 2>/dev/null || echo "0")
                    echo -e "  ${L[mb_msgs_on_board]} ${WHITE}$msg_count${NC}"
                    local board_size=$(du -h "$BOARD_PATH" 2>/dev/null | cut -f1)
                    echo -e "  ${L[mb_file_size]} ${WHITE}$board_size${NC}"
                fi
                press_enter
                ;;
            7)
                if verify_pin "${L[mb_delete_reason]}"; then
                    delete_board_message
                fi
                ;;
            8)
                echo ""
                echo -e "${CYAN}${L[mb_announcing]}${NC}"
                rm -f ~/.nomadmb/storage/last_announce
                restart_service "messageboard.service"
                echo -e "${GREEN}${L[mb_announced]}${NC}"
                press_enter
                ;;
            9)
                if verify_pin "block"; then
                    local block_hash
                    block_hash=$(dialog --colors \
                        --backtitle "RETICULUM CONTROL" \
                        --title "${L[mb_block_title]}" \
                        --ok-label "${L[btn_open]}" --cancel-label "${L[btn_back]}" \
                        --inputbox "${L[mb_block_prompt]}" 10 56 \
                        3>&1 1>&2 2>&3)
                    local rc=$?
                    clear
                    [ $rc -ne 0 ] && continue
                    block_hash=$(echo "$block_hash" | tr -d "[:space:]" | sed "s/lxmf@//")
                    if [ ${#block_hash} -eq 32 ]; then
                        if grep -qx "$block_hash" ~/.nomadmb/storage/blocklist 2>/dev/null; then
                            dlg_msg "${L[mb_already_blocked]}"
                        else
                            echo "$block_hash" >> ~/.nomadmb/storage/blocklist
                            dlg_msg "$(printf "${L[mb_blocked]}" "${block_hash}")"
                        fi
                    elif [ -z "$block_hash" ]; then
                        : # отмена
                    else
                        dlg_msg "${L[mb_bad_addr]}"
                    fi
                fi
                ;;
            u)
                echo ""
                echo -e "${CYAN}${L[mb_blocked_hdr]}${NC}"
                if [ -f ~/.nomadmb/storage/blocklist ]; then
                    cat -n ~/.nomadmb/storage/blocklist
                    echo ""
                    echo -ne "${CYAN}${L[mb_unblock_prompt]}${NC}"
                    local line_num=$(read_number_or_esc)
                    echo ""
                    if [ "$line_num" != "0" ] && [ "$line_num" != "ESC" ] && [ -n "$line_num" ]; then
                        if verify_pin "unblock"; then
                            sed -i "${line_num}d" ~/.nomadmb/storage/blocklist
                            echo -e "${GREEN}${L[mb_unblocked]}${NC}"
                        fi
                    fi
                else
                    echo -e "${GRAY}${L[mb_blocklist_empty]}${NC}"
                fi
                press_enter
                ;;
            e)
                export_board
                ;;
            i)
                if verify_pin "${L[mb_import_reason]}"; then
                    import_board
                fi
                ;;
            *) ;;
        esac
    done
}

# ══════════════════════════════════════════════════════════════════
# ГЛАВНОЕ МЕНЮ
# ══════════════════════════════════════════════════════════════════

main_menu() {
    # Проверяем PIN только если запущен не из f2b
    if [[ "$1" != "--skip-pin" ]]; then
        if ! check_pin_exists; then
            echo ""
            echo -e "${YELLOW}${L[main_pin_notset]}${NC}"
            echo -ne "${WHITE}${L[main_pin_ask]}${NC}"
            read -r setup_now
            if [[ "$setup_now" =~ ^[YyДд]$ ]]; then
                setup_pin
            fi
        fi
    fi
    
    local DEF_MAIN=""
    while true; do
        # Полный статус как в оригинале (без эмодзи, с \Z-цветами)
        local active=0
        for service in "${SERVICES[@]}"; do
            [ "$(get_service_status "$service")" = "active" ] && ((active++))
        done
        local total=${#SERVICES[@]}

        local STATUS=""
        if [ $active -eq $total ]; then
            STATUS="\Z2${L[svc_all_running]} (${active}/${total})\Zn\n"
        elif [ $active -eq 0 ]; then
            STATUS="\Z1${L[svc_all_stopped]}\Zn\n"
        else
            STATUS="\Z3${L[svc_some_running]} ${active}/${total} ${L[svc_word]}\Zn\n"
        fi

        # Статус групп (lxmf_group_*)
        local groups_total=0
        local groups_active=0
        for dir in /root/.config/lxmf_group_*; do
            if [ -d "$dir" ] && [ -f "$dir/identity" ]; then
                ((groups_total++))
                local svc=$(basename "$dir").service
                [ "$(get_service_status "$svc")" = "active" ] && ((groups_active++))
            fi
        done
        if [ $groups_total -gt 0 ]; then
            if [ $groups_active -eq $groups_total ]; then
                STATUS="${STATUS}\Z2${L[groups_label]} ${groups_active}/${groups_total}\Zn\n"
            elif [ $groups_active -eq 0 ]; then
                STATUS="${STATUS}\Z1${L[groups_label]} ${groups_active}/${groups_total}\Zn\n"
            else
                STATUS="${STATUS}\Z3${L[groups_label]} ${groups_active}/${groups_total}\Zn\n"
            fi
        fi

        # Статус PIN
        if check_pin_exists; then
            STATUS="${STATUS}${L[pin_active]}\n"
        fi

        local BOT_NAME="$(get_bot_name)"

        # Пункт f2b показываем только если скрипт установлен
        local f2b_item=()
        if [ -x /usr/local/bin/f2b ]; then
            f2b_item=( "9" "${C_F2B}Fail2ban Manager (f2b)\Zn" )
        fi

        dlg_menu "${L[main_title]}" "$STATUS" "$DEF_MAIN" \
            "1" "${C_START}${L[m_quickstart]}\Zn" \
            "2" "${C_RETICULUM}${L[m_services]}\Zn" \
            "3" "${C_BOT}${BOT_NAME}\Zn" \
            "4" "${C_ENV}${L[m_environment]}\Zn" \
            "5" "${C_MON}${L[m_monitoring]}\Zn" \
            "6" "${C_RESTART}${L[m_restart_all]}\Zn" \
            "7" "${C_STOP}${L[m_stop_all]}\Zn" \
            "8" "${L[m_pin_setup]}" \
            "${f2b_item[@]}"

        # Пусто = Назад/Esc = выход
        # Back / single ESC on the top menu = leave this rn process. If rn was
        # launched from f2b, control returns to f2b naturally; if rn is the
        # root process, it returns to the terminal. A quick double-ESC (handled
        # in dlg_menu) exits straight to the terminal from any depth.
        if [ -z "$DLG_CHOICE" ]; then
            clear
            exit 0
        fi
        DEF_MAIN="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) start_all ;;
            2) menu_services ;;
            3) menu_bot ;;
            4) menu_environment ;;
            5) menu_monitoring ;;
            6) restart_all ;;
            7) 
                if verify_pin "${L[main_stopall_reason]}"; then
                    stop_all
                fi
                ;;
            8) menu_pin ;;
            9)
                if [ -x /usr/local/bin/f2b ]; then
                    # Nested call (not exec): leaving f2b returns here to rn.
                    /usr/local/bin/f2b
                    clear
                else
                    dlg_msg "\n\Z1${L[f2b_notfound]}\Zn"
                fi
                ;;
            *) ;;
        esac
    done
}

# Меню настройки PIN
menu_pin() {
    local DEF=""
    while true; do
        local STATUS
        if check_pin_exists; then
            STATUS="\Z2● PIN установлен\Zn"
        else
            STATUS="\Z3● PIN не установлен\Zn"
        fi

        dlg_menu "${L[pin_title]}" "$STATUS" "$DEF" \
            "1" "${C_START}Установить/Изменить PIN\Zn" \
            "2" "${C_STOP}Удалить PIN\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) change_pin ;;
            2) reset_pin ;;
            *) ;;
        esac
    done
}

# ══════════════════════════════════════════════════════════════════
# БЫСТРЫЕ КОМАНДЫ (аргументы командной строки)
# ══════════════════════════════════════════════════════════════════

show_help() {
    echo ""
    echo -e "${CYAN}Reticulum Control${NC}"
    echo ""
    echo "${L[cli_usage]}"
    echo ""
    echo "${L[cli_commands]}"
    echo "${L[cli_noargs]}"
    echo "${L[cli_status]}"
    echo "${L[cli_start]}"
    echo "${L[cli_stop]}"
    echo "${L[cli_restart]}"
    echo "${L[cli_logs]}"
    echo "${L[cli_help]}"
    echo ""
}

# ══════════════════════════════════════════════════════════════════
# ТОЧКА ВХОДА
# ══════════════════════════════════════════════════════════════════

# Конвертируем аргумент если на русском
arg=$(convert_ru_to_en "${1:-}")

case "$arg" in
    status)
        for service in "${SERVICES[@]}"; do
            print_service_status "$service"
        done
        # Динамические группы (созданные через бота): lxmf_group_*
        for dir in /root/.config/lxmf_group_*; do
            [ -d "$dir" ] && [ -f "$dir/identity" ] || continue
            gname=$(get_group_display_name "$dir")
            gservice=$(get_group_service "$dir")
            glock=""
            is_group_private "$dir" && glock=" ${YELLOW}${L[ag_private]}${NC}"
            if [ "$(get_service_status "$gservice")" = "active" ]; then
                echo -e "  ${GREEN}●${NC} ${gname}${glock} ${GREEN}${L[st_running]}${NC}"
            else
                echo -e "  ${RED}●${NC} ${gname}${glock} ${RED}${L[st_stopped]}${NC}"
            fi
        done
        ;;
    start)
        start_all
        ;;
    stop)
        stop_all
        ;;
    restart)
        restart_all
        ;;
    logs)
        sudo journalctl -u reticulum.service -u nomadnet.service -u surgutbot86.service -u "$GROUP_SERVICE" -u messageboard.service -f --no-pager
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        main_menu "$1"
        ;;
esac
