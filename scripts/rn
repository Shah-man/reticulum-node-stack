# Просмотр лог-файла с пагинацией
view_log_file() {
    local log_file="$1"
    local title="$2"
    
    if [ ! -f "$log_file" ]; then
        echo ""
        echo -e "${YELLOW}Лог-файл не найден или пуст${NC}"
        press_enter
        return
    fi
    
    local lines=$(wc -l < "$log_file")
    if [ "$lines" -eq 0 ]; then
        echo ""
        echo -e "${YELLOW}Лог пуст${NC}"
        press_enter
        return
    fi
    
    local page_size=30
    local total_pages=$(( (lines + page_size - 1) / page_size ))
    local current_page=1
    
    while true; do
        clear
        echo ""
        echo -e "${CYAN}═══ $title ═══${NC}"
        echo -e "${GRAY}Всего: $lines записей | Страница $current_page/$total_pages${NC}"
        echo -e "${GRAY}[n] след. | [p] пред. | [f] первая | [l] последняя | [0] выход${NC}"
        print_line
        echo ""
        
        local start_line=$(( (current_page - 1) * page_size + 1 ))
        sed -n "${start_line},+$((page_size - 1))p" "$log_file"
        
        echo ""
        print_line
        echo -ne "${CYAN}Выбор: ${NC}"
        local choice=$(read_key)
        
        if [[ "$choice" == "ESC" ]] || [[ "$choice" == "0" ]]; then
            return
        fi
        
        choice=$(convert_ru_to_en "$choice")
        
        case $choice in
            n|N) 
                if [ "$current_page" -lt "$total_pages" ]; then
                    ((current_page++))
                fi
                ;;
            p|P)
                if [ "$current_page" -gt 1 ]; then
                    ((current_page--))
                fi
                ;;
            f|F) current_page=1 ;;
            l|L) current_page=$total_pages ;;
            *) ;;
        esac
    done
}

# Меню управления доверенными
menu_trusted_users() {
    local bot_db="${BOT_HOME}/bot_data"
    local DEF=""

    while true; do
        # Текущий список доверенных в шапку
        local STATUS="\Z7Доверенные могут создавать/удалять свои группы\Zn\n"
        if [ -f "$bot_db" ]; then
            local trusted=$(sqlite3 "$bot_db" "SELECT value FROM key_value WHERE key='trusted_users'" 2>/dev/null)
            if [ -n "$trusted" ] && [ "$trusted" != "[]" ]; then
                local list=$(echo "$trusted" | "$VENV_PATH/bin/python3" -c "
import sys, json
data = json.loads(sys.stdin.read())
for i, h in enumerate(data, 1):
    print(f'{i}. {h}')
print(f'Всего: {len(data)}')
" 2>/dev/null)
                STATUS="${STATUS}${list}"
            else
                STATUS="${STATUS}\Z3Список пуст\Zn"
            fi
        else
            STATUS="${STATUS}\Z1База данных не найдена\Zn"
        fi

        dlg_menu "ДОВЕРЕННЫЕ ПОЛЬЗОВАТЕЛИ" "$STATUS" "$DEF" \
            "1" "${C_START}Добавить пользователя\Zn" \
            "2" "${C_STOP}Удалить пользователя\Zn" \
            "3" "${C_MON}Обновить список\Zn" \
            "4" "${C_GROUP}Показать команды бота\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) add_trusted_user ;;
            2) remove_trusted_user ;;
            3) ;; # просто обновит экран
            4) show_bot_commands ;;
            *) ;;
        esac
    done
}

# Показать команды бота
show_bot_commands() {
    echo ""
    echo -e "${CYAN}═══ КОМАНДЫ БОТА (ШПАРГАЛКА) ═══${NC}"
    echo ""
    echo -e "${WHITE}Админ команды:${NC}"
    echo -e "  /adminhelp       - показать эту справку в боте"
    echo ""
    echo -e "${WHITE}Whitelist:${NC}"
    echo -e "  /trust <hash>    - добавить доверенного"
    echo -e "  /untrust <hash>  - убрать доверенного"
    echo -e "  /trusted         - список доверенных"
    echo ""
    echo -e "${WHITE}Группы:${NC}"
    echo -e "  /newgroup <название>            - создать группу"
    echo -e "  /newgroup <название> private    - создать приватную"
    echo -e "  /delgroup <название>            - удалить группу"
    echo -e "  /renamegroup <старое> | <новое> - переименовать"
    echo -e "  /setprivate <название>          - сделать приватной"
    echo -e "  /setpublic <название>           - сделать публичной"
    echo -e "  /groups                         - список групп"
    echo -e "  /group <название>               - инфо о группе"
    echo ""
    echo -e "${WHITE}Статистика и управление:${NC}"
    echo -e "  /stats           - статистика бота"
    echo -e "  /status          - статус Ollama"
    echo -e "  /models          - список моделей"
    echo -e "  /setmodel <модель> - сменить модель"
    echo -e "  /clearall        - очистить все истории"
    echo ""
    press_enter
}

# Добавление доверенного
add_trusted_user() {
    local bot_db="${BOT_HOME}/bot_data"

    local user_hash
    user_hash=$(dialog --colors \
        --backtitle "RETICULUM CONTROL" \
        --title " ДОБАВЛЕНИЕ ДОВЕРЕННОГО " \
        --inputbox "\nВведите полный LXMF адрес (32 hex символа):\n\nПример: 14addeb7c3bb2ef4ff6f163af66c36f4" 12 56 \
        3>&1 1>&2 2>&3)
    local rc=$?
    clear
    [ $rc -ne 0 ] && return          # отмена
    [ -z "$user_hash" ] && return

    # Проверка формата
    if [[ ! "$user_hash" =~ ^[a-fA-F0-9]{32}$ ]]; then
        dlg_msg "\n\Z1✗ Неверный формат!\Zn\nНужно 32 hex символа"
        return
    fi
    
    user_hash=$(echo "$user_hash" | tr '[:upper:]' '[:lower:]')
    
    # Получаем текущий список
    local trusted=$(sqlite3 "$bot_db" "SELECT value FROM key_value WHERE key='trusted_users'" 2>/dev/null)
    if [ -z "$trusted" ]; then
        trusted="[]"
    fi
    
    # Проверяем есть ли уже
    if echo "$trusted" | grep -q "$user_hash"; then
        echo -e "${YELLOW}⚠ Уже в списке!${NC}"
        press_enter
        return
    fi
    
    # Добавляем через Python
    local new_trusted=$("$VENV_PATH/bin/python3" -c "
import json
data = json.loads('$trusted')
data.append('$user_hash')
print(json.dumps(data))
" 2>/dev/null)
    
    # Сохраняем
    sqlite3 "$bot_db" "INSERT OR REPLACE INTO key_value (key, value) VALUES ('trusted_users', '$new_trusted')" 2>/dev/null
    
    echo ""
    echo -e "${GREEN}✓ Добавлен: ${WHITE}$user_hash${NC}"
    echo -e "${YELLOW}Теперь этот пользователь может создавать группы!${NC}"
    press_enter
}

# Удаление доверенного
remove_trusted_user() {
    local bot_db="${BOT_HOME}/bot_data"

    # Получаем текущий список
    local trusted=$(sqlite3 "$bot_db" "SELECT value FROM key_value WHERE key='trusted_users'" 2>/dev/null)
    if [ -z "$trusted" ] || [ "$trusted" == "[]" ]; then
        dlg_msg "\n\Z3Список пуст!\Zn"
        return
    fi

    # Список доверенных в массив
    local users_array=()
    while IFS= read -r line; do
        users_array+=("$line")
    done < <("$VENV_PATH/bin/python3" -c "
import json
data = json.loads('$trusted')
for h in data:
    print(h)
" 2>/dev/null)

    # Собираем пункты для dialog
    local items=()
    local i=1
    for h in "${users_array[@]}"; do
        items+=( "$i" "${C_RETICULUM}${h}\Zn" )
        ((i++))
    done

    dlg_menu "УДАЛЕНИЕ ДОВЕРЕННОГО" "\Z4Выберите кого удалить:\Zn" "" "${items[@]}"
    local choice="$DLG_CHOICE"
    clear
    [ -z "$choice" ] && return        # отмена

    if [[ ! "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#users_array[@]}" ]; then
        return
    fi

    local user_to_remove="${users_array[$((choice-1))]}"

    # Подтверждение
    if ! dlg_confirm "\nУдалить доверенного?\n\n\Z7${user_to_remove}\Zn"; then
        return
    fi

    # Удаляем через Python
    local new_trusted=$("$VENV_PATH/bin/python3" -c "
import json
data = json.loads('$trusted')
data.remove('$user_to_remove')
print(json.dumps(data))
" 2>/dev/null)

    # Сохраняем
    sqlite3 "$bot_db" "INSERT OR REPLACE INTO key_value (key, value) VALUES ('trusted_users', '$new_trusted')" 2>/dev/null

    dlg_msg "\n\Z2✓ Удалён:\Zn\n${user_to_remove}"
}
# ============================================================
# Обновление прошивок RNode (вызов fetch-rnode-firmware.sh)
# ============================================================

FETCH_SCRIPT="/root/reticulum-node-stack/scripts/fetch-rnode-firmware.sh"

update_rnode_firmware_select() {
    print_header
    echo -e "${WHITE}${BOLD}  Обновить одну прошивку${NC}"
    print_line
    echo ""
    echo -e "${CYAN}Доступные имена устройств:${NC}"
    echo -e "  ${GRAY}t114, lora32v2, lora32v3, heltec32v4${NC}"
    echo -e "  ${GRAY}tbeam, tbeam_supreme, tbeam_sx1262${NC}"
    echo -e "  ${GRAY}t3s3, t3s3_sx127x, t3s3_sx1280${NC}"
    echo -e "  ${GRAY}tdeck, techo, rak4631${NC}"
    echo -e "  ${GRAY}lora32v10, lora32v20, lora32v21${NC}"
    echo -e "  ${GRAY}esp32, feather, ng20, ng21, xiao${NC}"
    echo ""
    echo -ne "${CYAN}Имя устройства (или Enter для отмены): ${NC}"
    read device_name
    if [ -z "$device_name" ]; then
        echo -e "${GRAY}Отменено${NC}"
        press_enter
        return
    fi
    echo ""
    "$FETCH_SCRIPT" "$device_name"
    press_enter
}

menu_rnode_firmware() {
    local DEF=""
    while true; do
        local STATUS="\Z7Источник: github.com/markqvist/RNode_Firmware\Zn\nБэкап: до 5 версий каждой прошивки в .old/"

        dlg_menu "ОБНОВЛЕНИЕ ПРОШИВОК RNODE" "$STATUS" "$DEF" \
            "1" "${C_START}Обновить все прошивки (~6 МБ, с бэкапом)\Zn" \
            "2" "${C_MON}Скачать только отсутствующие\Zn" \
            "3" "${C_RESTART}Обновить одну прошивку\Zn" \
            "4" "${C_NOMADNET}Показать что есть на диске\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1)
                if verify_pin "обновить все прошивки RNode"; then
                    echo ""
                    "$FETCH_SCRIPT"
                    press_enter
                fi
                ;;
            2)
                echo ""
                "$FETCH_SCRIPT" --missing
                press_enter
                ;;
            3)
                if verify_pin "обновить прошивку RNode"; then
                    update_rnode_firmware_select
                fi
                ;;
            4)
                echo ""
                "$FETCH_SCRIPT" --list
                press_enter
                ;;
            *) ;;
        esac
    done
}
menu_surgutbot() {
    local service="surgutbot86.service"
    local name="${SERVICE_NAMES[$service]}"
    local clean_name=$(printf '%s' "$name" | sed -E 's/^[^[:alnum:]A-Za-zА-Яа-я]+[[:space:]]*//')
    local DEF=""

    while true; do
        local st=$(get_service_status "$service")
        local STATUS
        if [ "$st" = "active" ]; then
            STATUS="\Z2● ${clean_name} [работает]\Zn"
        else
            STATUS="\Z1● ${clean_name} [остановлен]\Zn"
        fi

        dlg_menu "$clean_name" "$STATUS" "$DEF" \
            "1" "${C_START}Запустить\Zn" \
            "2" "${C_STOP}Остановить\Zn" \
            "3" "${C_RESTART}Перезапустить\Zn" \
            "4" "${C_MON}Показать логи\Zn" \
            "5" "${C_NOMADNET}Подробный статус\Zn" \
            "6" "${C_GROUP}Статистика бота\Zn" \
            "7" "${C_ENV}База знаний\Zn" \
            "f" "${C_NOMADNET}Обновление прошивок RNode\Zn" \
            "e" "${C_STOP}Редактировать код бота\Zn" \
            "s" "${C_MON}Настройки бота (.env)\Zn" \
            "t" "${C_START}Доверенные пользователи\Zn" \
            "l" "${C_BOARD}Логи сообщений\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) start_service "$service"; press_enter ;;
            2) 
                if verify_pin "остановить бота"; then
                    stop_service "$service"
                    press_enter
                fi
                ;;
            3) restart_service "$service"; press_enter ;;
            4)
                echo ""
                echo -e "${CYAN}═══ ЛОГИ: $clean_name (Ctrl+C для выхода) ═══${NC}"
                sudo journalctl -u "$service" -f --no-pager -n 50
                ;;
            5)
                echo ""
                sudo systemctl status "$service"
                press_enter
                ;;
            6) show_bot_stats ;;
            7) 
                if verify_pin "редактировать базу знаний"; then
                    menu_knowledge_base
                fi
                ;;
            f)
                menu_rnode_firmware
                ;;
            e) 
                if verify_pin "редактировать код бота"; then
                    edit_bot_code
                fi
                ;;
            s)
                if verify_pin "настройки бота"; then
                    edit_bot_settings
                fi
                ;;
            t)
                if verify_pin "управление доверенными"; then
                    menu_trusted_users
                fi
                ;;
            l)
                if verify_pin "просмотр логов"; then
                    menu_bot_logs
                fi
                ;;
            *) ;;
        esac
    done
}


# Статистика бота
show_bot_stats() {
    echo ""
    echo -e "${CYAN}═══ СТАТИСТИКА SURGUTBOT86 ═══${NC}"
    echo ""
    
    local bot_db="${BOT_HOME}/bot_data"
    
    if [ -f "$bot_db" ]; then
        # Всего сообщений
        local total_msg=$(sqlite3 "$bot_db" "SELECT value FROM key_value WHERE key='stat_total_messages'" 2>/dev/null || echo "0")
        echo -e "  📨 Всего сообщений: ${WHITE}${total_msg:-0}${NC}"
        
        # Всего пользователей
        local total_users=$(sqlite3 "$bot_db" "SELECT value FROM key_value WHERE key='stat_total_users'" 2>/dev/null || echo "0")
        echo -e "  👥 Всего пользователей: ${WHITE}${total_users:-0}${NC}"
        
        # Активные сегодня
        local today=$(date +%Y-%m-%d)
        local dau=$(sqlite3 "$bot_db" "SELECT value FROM key_value WHERE key='stat_dau_$today'" 2>/dev/null)
        if [ -n "$dau" ]; then
            local dau_count=$(echo "$dau" | grep -o '"' | wc -l)
            dau_count=$((dau_count / 2))
            echo -e "  📅 Активных сегодня: ${WHITE}$dau_count${NC}"
        else
            echo -e "  📅 Активных сегодня: ${WHITE}0${NC}"
        fi
        
        echo ""
        
        # Использование ресурсов
        local pid=$(systemctl show -p MainPID "$service" 2>/dev/null | cut -d= -f2)
        if [ "$pid" != "0" ] && [ -n "$pid" ]; then
            echo -e "  ${GRAY}Ресурсы (PID: $pid):${NC}"
            ps -p "$pid" -o %cpu,%mem,rss --no-headers 2>/dev/null | \
                awk '{printf "  CPU: %s%%  MEM: %s%%  RAM: %.1f MB\n", $1, $2, $3/1024}'
        fi
    else
        echo -e "  ${RED}База данных бота не найдена${NC}"
    fi
    
    press_enter
}

menu_bot() {
    menu_surgutbot
}

# ══════════════════════════════════════════════════════════════════
# ПОДМЕНЮ: НАСТРОЙКИ RNODE
# ══════════════════════════════════════════════════════════════════

menu_rnode_settings() {
    local rnode_port=""
    
    # Ищем порт RNode
    for port in /dev/ttyACM0 /dev/ttyACM1 /dev/ttyUSB0 /dev/ttyUSB1; do
        if [ -e "$port" ]; then
            rnode_port="$port"
            break
        fi
    done

    if [ -z "$rnode_port" ]; then
        dlg_msg "\n\Z1RNode не найден\Zn\n\nПроверьте подключение устройства."
        return
    fi

    local DEF=""
    while true; do
        local STATUS="\Z2● RNode порт: ${rnode_port}\Zn"

        dlg_menu "НАСТРОЙКИ RNODE" "$STATUS" "$DEF" \
            "1" "${C_START}Таймаут экрана: 30 секунд\Zn" \
            "2" "${C_NOMADNET}Таймаут экрана: 60 секунд (1 мин)\Zn" \
            "3" "${C_MON}Таймаут экрана: 120 секунд (2 мин)\Zn" \
            "4" "${C_GROUP}Таймаут экрана: 255 секунд (макс)\Zn" \
            "5" "${C_RESTART}Таймаут экрана: всегда включён\Zn" \
            "6" "${C_ENV}Таймаут экрана: своё значение (0-255)\Zn" \
            "b" "${C_ANNOUNCE}Настроить яркость (0-255)\Zn" \
            "i" "${C_BOARD}Информация о RNode\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) set_rnode_timeout "$rnode_port" 30; press_enter ;;
            2) set_rnode_timeout "$rnode_port" 60; press_enter ;;
            3) set_rnode_timeout "$rnode_port" 120; press_enter ;;
            4) set_rnode_timeout "$rnode_port" 255; press_enter ;;
            5) set_rnode_timeout "$rnode_port" 0; press_enter ;;
            6)
                local custom_timeout
                custom_timeout=$(dialog --colors \
                    --backtitle "RETICULUM CONTROL" \
                    --title " ТАЙМАУТ ЭКРАНА " \
                    --inputbox "\nВведите таймаут в секундах (0-255):\n0 = всегда включён" 11 50 \
                    3>&1 1>&2 2>&3)
                local rc=$?
                clear
                [ $rc -ne 0 ] && continue
                if [[ "$custom_timeout" =~ ^[0-9]+$ ]] && [ "$custom_timeout" -ge 0 ] && [ "$custom_timeout" -le 255 ]; then
                    set_rnode_timeout "$rnode_port" "$custom_timeout"
                    press_enter
                else
                    dlg_msg "\n\Z1Неверное значение (0-255)\Zn"
                fi
                ;;
            b)
                local brightness
                brightness=$(dialog --colors \
                    --backtitle "RETICULUM CONTROL" \
                    --title " ЯРКОСТЬ ЭКРАНА " \
                    --inputbox "\nВведите яркость (0-255):\n0 = выключен" 11 50 \
                    3>&1 1>&2 2>&3)
                local rc=$?
                clear
                [ $rc -ne 0 ] && continue
                if [[ "$brightness" =~ ^[0-9]+$ ]] && [ "$brightness" -ge 0 ] && [ "$brightness" -le 255 ]; then
                    set_rnode_brightness "$rnode_port" "$brightness"
                    press_enter
                else
                    dlg_msg "\n\Z1Неверное значение (0-255)\Zn"
                fi
                ;;
            i)
                show_rnode_info "$rnode_port"
                ;;
            *) ;;
        esac
    done
}

set_rnode_timeout() {
    local port="$1"
    local timeout="$2"
    
    echo ""
    echo -e "${YELLOW}Останавливаю Reticulum...${NC}"
    sudo systemctl stop reticulum.service
    sleep 1
    
    echo -e "${YELLOW}Настраиваю скорость порта...${NC}"
    stty -F "$port" 9600
    
    echo -e "${YELLOW}Устанавливаю таймаут экрана: ${WHITE}${timeout} сек${NC}"
    "$VENV_PATH/bin/rnodeconf" "$port" -t "$timeout"
    
    echo -e "${YELLOW}Запускаю Reticulum...${NC}"
    sudo systemctl start reticulum.service
    sleep 1
    
    if [ "$timeout" -eq 0 ]; then
        echo -e "${GREEN}✓ Экран будет всегда включён${NC}"
    else
        echo -e "${GREEN}✓ Экран выключится через ${timeout} сек${NC}"
    fi
    press_enter
}

set_rnode_brightness() {
    local port="$1"
    local brightness="$2"
    
    echo ""
    echo -e "${YELLOW}Останавливаю Reticulum...${NC}"
    sudo systemctl stop reticulum.service
    sleep 1
    
    echo -e "${YELLOW}Настраиваю скорость порта...${NC}"
    stty -F "$port" 9600
    
    echo -e "${YELLOW}Устанавливаю яркость: ${WHITE}${brightness}${NC}"
    "$VENV_PATH/bin/rnodeconf" "$port" -D "$brightness"
    
    echo -e "${YELLOW}Запускаю Reticulum...${NC}"
    sudo systemctl start reticulum.service
    sleep 1
    
    if [ "$brightness" -eq 0 ]; then
        echo -e "${GREEN}✓ Экран выключен${NC}"
    else
        echo -e "${GREEN}✓ Яркость установлена: ${brightness}${NC}"
    fi
    press_enter
}

show_rnode_info() {
    local port="$1"

    # Собираем ПОЛНЫЙ список сервисов, которые могут держать RNode-порт:
    # статичные из SERVICES + динамические группы lxmf_group_*
    local all_svc=()
    for s in "${SERVICES[@]}"; do
        all_svc+=("$s")
    done
    for dir in /root/.config/lxmf_group_*; do
        if [ -d "$dir" ] && [ -f "$dir/identity" ]; then
            all_svc+=("$(basename "$dir").service")
        fi
    done

    # Запоминаем, какие из них СЕЙЧАС активны (чтобы поднять обратно только их)
    local was_active=()
    for s in "${all_svc[@]}"; do
        if systemctl is-active --quiet "$s" 2>/dev/null; then
            was_active+=("$s")
        fi
    done

    echo ""
    echo -e "${YELLOW}Останавливаю сервисы Reticulum (освобождаю порт)...${NC}"
    # Останавливаем в обратном порядке (сначала зависимые, потом ядро)
    for (( i=${#was_active[@]}-1; i>=0; i-- )); do
        sudo systemctl stop "${was_active[i]}" 2>/dev/null
    done
    sleep 1

    echo -e "${YELLOW}Настраиваю скорость порта...${NC}"
    stty -F "$port" 9600

    echo ""
    echo -e "${CYAN}═══ ИНФОРМАЦИЯ О RNODE ═══${NC}"
    echo ""
    "$VENV_PATH/bin/rnodeconf" "$port" -i

    echo ""
    echo -e "${YELLOW}Запускаю сервисы обратно...${NC}"
    # Поднимаем в прямом порядке (ядро первым, зависимые потом)
    for s in "${was_active[@]}"; do
        sudo systemctl start "$s" 2>/dev/null
        echo -e "  ${GREEN}✓${NC} $s"
    done

    press_enter
}

# ══════════════════════════════════════════════════════════════════
# ПОДМЕНЮ: ОКРУЖЕНИЕ
# ══════════════════════════════════════════════════════════════════

menu_environment() {
    local DEF=""
    while true; do
        # Статус venv и SSH в шапку (без эмодзи, с \Z-цветами)
        local STATUS=""
        if check_venv_active; then
            STATUS="\Z2● Virtual Environment [активен]\Zn\n"
        else
            STATUS="\Z3● Virtual Environment [не активен]\Zn\n"
        fi
        local ssh_listen=$(ss -tlnp 2>/dev/null | grep ":${SSH_PORT}" | awk '{print $4}' | cut -d: -f1)
        if [ "$ssh_listen" = "0.0.0.0" ]; then
            STATUS="${STATUS}\Z2● SSH [0.0.0.0:${SSH_PORT}]\Zn"
        elif [ "$ssh_listen" = "127.0.0.1" ]; then
            STATUS="${STATUS}\Z1● SSH [127.0.0.1:${SSH_PORT} — только локально!]\Zn"
        else
            STATUS="${STATUS}\Z3● SSH [неизвестно]\Zn"
        fi

        dlg_menu "ОКРУЖЕНИЕ И НАСТРОЙКИ" "$STATUS" "$DEF" \
            "1" "${C_START}Активировать venv\Zn" \
            "2" "${C_NOMADNET}Перейти в рабочую папку\Zn" \
            "3" "${C_MON}Проверить версии пакетов\Zn" \
            "4" "${C_RESTART}Обновить пакеты Reticulum\Zn" \
            "5" "${C_GROUP}Показать конфиг Reticulum\Zn" \
            "6" "${C_ENV}Редактировать конфиг Reticulum\Zn" \
            "7" "${C_BOARD}Настройки RNode\Zn" \
            "8" "${C_STOP}Настройки SSH\Zn" \
            "p" "${C_MON}Проверить/починить доступ к pypi\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1)
                echo ""
                echo -e "${CYAN}Для активации venv выполни:${NC}"
                echo -e "${WHITE}source $VENV_PATH/bin/activate${NC}"
                echo ""
                echo -e "${GRAY}(скрипт не может активировать venv в родительском shell)${NC}"
                press_enter
                ;;
            2)
                echo ""
                echo -e "${CYAN}Для перехода выполни:${NC}"
                echo -e "${WHITE}cd $WORK_DIR${NC}"
                press_enter
                ;;
            3)
                echo ""
                echo -e "${CYAN}═══ ВЕРСИИ ПАКЕТОВ ═══${NC}"
                echo ""
                "$VENV_PATH/bin/pip" list | grep -i -E "rns|nomad|lxmf|reticulum" 2>/dev/null || echo "Пакеты не найдены"
                press_enter
                ;;
            4)
                echo ""
                echo -e "${YELLOW}Обновляю пакеты Reticulum...${NC}"
                echo ""
                if ensure_pypi_access; then
                    echo ""
                    "$VENV_PATH/bin/pip" install --upgrade rns nomadnet lxmf
                    log_action "UPDATED: Reticulum packages"
                else
                    echo ""
                    echo -e "${RED}✗ Нет доступа к pypi.org${NC}"
                    echo -e "${GRAY}Проверь интернет или попробуй позже.${NC}"
                    echo -e "${GRAY}Можно также добавить новый IP в PYPI_FALLBACK_IPS в скрипте.${NC}"
                fi
                press_enter
                ;;
            5)
                echo ""
                echo -e "${CYAN}═══ КОНФИГ RETICULUM ═══${NC}"
                echo ""
                if [ -f ~/.reticulum/config ]; then
                    cat ~/.reticulum/config
                else
                    echo "Конфиг не найден в ~/.reticulum/config"
                fi
                press_enter
                ;;
            6)
                if [ -f ~/.reticulum/config ]; then
                    ${EDITOR:-nano} ~/.reticulum/config
                else
                    echo "Конфиг не найден"
                    press_enter
                fi
                ;;
            7)
                menu_rnode_settings
                ;;
            8)
                menu_ssh_settings
                ;;
            p)
                echo ""
                echo -e "${CYAN}═══ ДОСТУП К PYPI ═══${NC}"
                echo ""
                local cur_hosts
                cur_hosts=$(grep -E "pypi\.org|files\.pythonhosted\.org" /etc/hosts 2>/dev/null)
                if [ -n "$cur_hosts" ]; then
                    echo -e "${GRAY}Текущие записи в /etc/hosts:${NC}"
                    echo "$cur_hosts" | while read -r line; do
                        echo -e "  ${WHITE}$line${NC}"
                    done
                    echo ""
                fi
                if ensure_pypi_access; then
                    echo ""
                    echo -e "${GREEN}✓ Доступ к pypi.org есть${NC}"
                else
                    echo ""
                    echo -e "${RED}✗ Доступ к pypi.org отсутствует${NC}"
                fi
                press_enter
                ;;
            *) ;;
        esac
    done
}

# ══════════════════════════════════════════════════════════════════
# ПОДМЕНЮ: НАСТРОЙКИ SSH
# ══════════════════════════════════════════════════════════════════

menu_ssh_settings() {
    local DEF=""
    while true; do
        # Статус SSH в шапку (без эмодзи, с \Z-цветами)
        local ssh_port=$(grep "^Port" /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}')
        local ssh_listen=$(ss -tlnp 2>/dev/null | grep ":${ssh_port:-22}" | awk '{print $4}' | cut -d: -f1)
        local root_login=$(grep "^PermitRootLogin" /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}')

        local STATUS="\Z7Порт:\Zn ${ssh_port:-22}\n"
        if [ "$ssh_listen" = "0.0.0.0" ]; then
            STATUS="${STATUS}\Z7Слушает:\Zn \Z20.0.0.0 (все интерфейсы)\Zn\n"
        elif [ "$ssh_listen" = "127.0.0.1" ]; then
            STATUS="${STATUS}\Z7Слушает:\Zn \Z1127.0.0.1 (только локально!)\Zn\n"
        else
            STATUS="${STATUS}\Z7Слушает:\Zn \Z3${ssh_listen}\Zn\n"
        fi
        STATUS="${STATUS}\Z7Root логин:\Zn ${root_login:-yes}"

        dlg_menu "НАСТРОЙКИ SSH" "$STATUS" "$DEF" \
            "1" "${C_START}Редактировать sshd_config\Zn" \
            "2" "${C_RESTART}Перезапустить SSH\Zn" \
            "3" "${C_NOMADNET}Показать статус sshd\Zn" \
            "4" "${C_MON}Показать текущие подключения\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1)
                echo ""
                echo -e "${CYAN}═══ РЕДАКТИРОВАНИЕ sshd_config ═══${NC}"
                echo ""
                echo -e "${YELLOW}⚠ Важно: ListenAddress должен быть 0.0.0.0 для удалённого доступа${NC}"
                echo -e "${GRAY}Если строка закомментирована (#) — слушает на всех интерфейсах${NC}"
                echo ""
                sleep 1
                sudo nano /etc/ssh/sshd_config
                if dlg_confirm "\nПерезапустить SSH для применения изменений?"; then
                    sudo systemctl restart sshd
                    dlg_msg "\n\Z2✓ SSH перезапущен\Zn"
                fi
                ;;
            2)
                echo ""
                echo -e "${YELLOW}Перезапускаю SSH...${NC}"
                sudo systemctl restart sshd
                sleep 1
                local new_listen=$(ss -tlnp 2>/dev/null | grep ":${ssh_port:-22}" | awk '{print $4}')
                echo -e "${GREEN}✓ SSH перезапущен${NC}"
                echo -e "  Слушает: ${WHITE}$new_listen${NC}"
                press_enter
                ;;
            3)
                echo ""
                sudo systemctl status sshd
                press_enter
                ;;
            4)
                echo ""
                echo -e "${CYAN}═══ ТЕКУЩИЕ SSH ПОДКЛЮЧЕНИЯ ═══${NC}"
                echo ""
                who | grep -v "^$" || echo "Нет активных подключений"
                echo ""
                echo -e "${GRAY}Детали:${NC}"
                ss -tnp | grep ":${ssh_port:-22}" | head -10 || echo "Нет подключений"
                press_enter
                ;;
            *) ;;
        esac
    done
}

# ══════════════════════════════════════════════════════════════════
# ПОДМЕНЮ: МОНИТОРИНГ
# ══════════════════════════════════════════════════════════════════

menu_monitoring() {
    local DEF=""
    while true; do
        dlg_menu "МОНИТОРИНГ" "\Z4Состояние сети и сервисов\Zn" "$DEF" \
            "1" "${C_START}Статус всех сервисов\Zn" \
            "2" "${C_MON}Общие логи Reticulum\Zn" \
            "3" "${C_NOMADNET}Сетевые интерфейсы RNS\Zn" \
            "4" "${C_GROUP}Подключённые пиры\Zn" \
            "5" "${C_RESTART}Использование ресурсов\Zn" \
            "6" "${C_ENV}Лог действий скрипта\Zn" \
            "7" "${C_BOARD}messageboard\Zn" \
            "8" "${C_GROUPS}Просмотр страниц узла\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) show_status ;;
            2)
                echo ""
                echo -e "${CYAN}═══ ЛОГИ RETICULUM (Ctrl+C для выхода) ═══${NC}"
                sudo journalctl -u reticulum.service -u nomadnet.service -f --no-pager -n 30
                ;;
            3)
                echo ""
                echo -e "${CYAN}═══ ИНТЕРФЕЙСЫ RNS ═══${NC}"
                echo ""
                "$VENV_PATH/bin/rnstatus" 2>/dev/null || echo "rnstatus не доступен"
                press_enter
                ;;
            4)
                echo ""
                echo -e "${CYAN}═══ ПОДКЛЮЧЁННЫЕ ПИРЫ ═══${NC}"
                echo ""
                "$VENV_PATH/bin/rnpath" -t 2>/dev/null || echo "rnpath не доступен"
                press_enter
                ;;
            5)
                echo ""
                echo -e "${CYAN}═══ ИСПОЛЬЗОВАНИЕ РЕСУРСОВ ═══${NC}"
                echo ""
                for service in "${SERVICES[@]}"; do
                    local name="${SERVICE_NAMES[$service]:-$service}"
                    local pid=$(systemctl show -p MainPID "$service" 2>/dev/null | cut -d= -f2)
                    if [ "$pid" != "0" ] && [ -n "$pid" ]; then
                        echo -e "${WHITE}$name (PID: $pid)${NC}"
                        ps -p "$pid" -o %cpu,%mem,rss --no-headers 2>/dev/null | \
                            awk '{printf "  CPU: %s%%  MEM: %s%%  RSS: %.1f MB\n", $1, $2, $3/1024}'
                    fi
                done
                press_enter
                ;;
            6)
                echo ""
                echo -e "${CYAN}═══ ЛОГ ДЕЙСТВИЙ ═══${NC}"
                echo ""
                if [ -f "$LOG_FILE" ]; then
                    tail -30 "$LOG_FILE"
                else
                    echo "Лог пока пуст"
                fi
                press_enter
                ;;
            7) menu_messageboard ;;
            8) menu_pages ;;
            *) ;;
        esac
    done
}

# ══════════════════════════════════════════════════════════════════
# ПОДМЕНЮ: ПРОСМОТР СТРАНИЦ УЗЛА
# ══════════════════════════════════════════════════════════════════

menu_pages() {
    local DEF=""
    while true; do
        # Список страниц динамически
        local pages=()
        local items=()
        local i=1
        for page in "$PAGES_PATH"/*.mu; do
            if [ -f "$page" ]; then
                local pagename=$(basename "$page")
                pages+=("$page")
                items+=( "$i" "${C_RETICULUM}${pagename}\Zn" )
                ((i++))
            fi
        done

        local STATUS
        if [ ${#pages[@]} -eq 0 ]; then
            STATUS="\Z3Страниц не найдено\Zn"
        else
            STATUS="\Z4Страниц узла: ${#pages[@]}\Zn"
        fi

        dlg_menu "СТРАНИЦЫ УЗЛА" "$STATUS" "$DEF" "${items[@]}"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"
        local choice="$DLG_CHOICE"

        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#pages[@]}" ]; then
            local selected_page="${pages[$((choice-1))]}"
            page_actions_menu "$selected_page"
        fi
    done
}

# Меню действий со страницей
page_actions_menu() {
    local page_path="$1"
    local pagename=$(basename "$page_path")
    local DEF=""

    while true; do
        dlg_menu "$pagename" "\Z4Действия со страницей\Zn" "$DEF" \
            "1" "${C_NOMADNET}Просмотр\Zn" \
            "2" "${C_START}Редактировать (nano)\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) view_page_without_counter "$page_path" ;;
            2) 
                if verify_pin "редактировать страницу"; then
                    edit_page "$page_path"
                fi
                ;;
            *) ;;
        esac
    done
}

# Редактирование страницы
edit_page() {
    local page_path="$1"
    local pagename=$(basename "$page_path")
    
    echo ""
    echo -e "${CYAN}═══ РЕДАКТИРОВАНИЕ: $pagename ═══${NC}"
    echo ""
    echo -e "${YELLOW}⚠ Внимание: изменение страницы влияет на отображение в сети!${NC}"
    echo -e "${GRAY}Открываю nano...${NC}"
    echo -e "${GRAY}(Ctrl+O сохранить, Ctrl+X выход)${NC}"
    sleep 1
    
    sudo nano "$page_path"
    
    echo ""
    echo -e "${GREEN}✓ Редактирование завершено${NC}"
    press_enter
}

# Просмотр страницы без увеличения счётчика
view_page_without_counter() {
    local page_path="$1"
    local pagename=$(basename "$page_path")
    
    echo ""
    echo -e "${CYAN}═══ $pagename ═══${NC}"
    echo ""
    
    # Проверяем, является ли страница скриптом Python
    if head -1 "$page_path" | grep -q "python"; then
        # Для Python скриптов показываем исходный код
        echo -e "${GRAY}(Python скрипт - показан исходный код)${NC}"
        echo ""
        cat "$page_path"
    else
        # Для обычных страниц показываем содержимое
        cat "$page_path"
    fi
    
    press_enter
}

# ══════════════════════════════════════════════════════════════════
# УПРАВЛЕНИЕ ГРУППАМИ (созданными ботом)
# ══════════════════════════════════════════════════════════════════

# Получить имя группы из конфига
get_group_display_name() {
    local config_path="$1"
    local name=""
    
    if [ -f "$config_path/config.cfg.owr" ]; then
        name=$(grep "^display_name" "$config_path/config.cfg.owr" 2>/dev/null | head -1 | cut -d'=' -f2 | xargs)
    fi
    
    if [ -z "$name" ] && [ -f "$config_path/config.cfg" ]; then
        name=$(grep "^display_name" "$config_path/config.cfg" 2>/dev/null | head -1 | cut -d'=' -f2 | xargs)
    fi
    
    if [ -z "$name" ]; then
        name=$(basename "$config_path")
    fi
    
    echo "$name"
}

# Получить сервис группы
get_group_service() {
    local config_path="$1"
    local dir_name=$(basename "$config_path")
    echo "${dir_name}.service"
}

# Получить хэш группы
get_group_hash() {
    local config_path="$1"
    local identity_file="$config_path/identity"
    
    if [ -f "$identity_file" ]; then
        "$VENV_PATH/bin/python3" -c "
import RNS
identity = RNS.Identity.from_file('$identity_file')
h = RNS.Destination.hash(identity, 'lxmf', 'delivery')
print(h.hex())
" 2>/dev/null
    fi
}

# Проверить приватная ли группа
is_group_private() {
    local config_path="$1"
    local data_file="$config_path/data.cfg"
    
    if [ -f "$data_file" ]; then
        grep -q "auto_add_user_type = wait" "$data_file" 2>/dev/null && return 0
    fi
    return 1
}

# Меню всех групп (только lxmf_group_*, без SURGUT GROUP)
menu_all_groups() {
    local DEF=""
    while true; do
        local groups_arr=()
        local items=()
        local groups_active=0
        local i=1

        # Только lxmf_group_* — без lxmf_distribution_group_extended (SURGUT GROUP)
        for dir in /root/.config/lxmf_group_*; do
            if [ -d "$dir" ] && [ -f "$dir/identity" ]; then
                groups_arr+=("$dir")
                local name=$(get_group_display_name "$dir")
                local service=$(get_group_service "$dir")
                local status=$(get_service_status "$service")
                local lock=""
                is_group_private "$dir" && lock=" \Z3[private]\Zn"

                if [ "$status" = "active" ]; then
                    items+=( "$i" "\Z2●\Zn ${name}${lock}" )
                    ((groups_active++))
                else
                    items+=( "$i" "\Z1○\Zn ${name}${lock}" )
                fi
                ((i++))
            fi
        done

        # Статус в шапку
        local STATUS
        if [ ${#groups_arr[@]} -eq 0 ]; then
            STATUS="\Z3Групп не найдено\Zn\nСоздай через бота: /newgroup <название>"
        else
            if [ $groups_active -eq ${#groups_arr[@]} ]; then
                STATUS="\Z2Работает: ${groups_active}/${#groups_arr[@]}\Zn"
            elif [ $groups_active -eq 0 ]; then
                STATUS="\Z1Работает: ${groups_active}/${#groups_arr[@]}\Zn"
            else
                STATUS="\Z3Работает: ${groups_active}/${#groups_arr[@]}\Zn"
            fi
        fi

        # Добавляем действия (буквы как в оригинале)
        items+=( "a" "${C_START}Запустить ВСЕ группы\Zn" )
        items+=( "s" "${C_STOP}Остановить ВСЕ группы\Zn" )
        items+=( "r" "${C_RESTART}Перезапустить ВСЕ группы\Zn" )

        dlg_menu "УПРАВЛЕНИЕ ГРУППАМИ" "$STATUS" "$DEF" "${items[@]}"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"
        local choice="$DLG_CHOICE"

        clear
        case "$choice" in
            [1-9]|[1-9][0-9])
                local idx=$((choice - 1))
                if [ $idx -lt ${#groups_arr[@]} ]; then
                    menu_single_group_full "${groups_arr[$idx]}"
                fi
                ;;
            a)
                echo ""
                echo -e "${YELLOW}Запускаю все группы...${NC}"
                for dir in "${groups_arr[@]}"; do
                    local service=$(get_group_service "$dir")
                    start_service "$service"
                done
                press_enter
                ;;
            s)
                if verify_pin "остановить ВСЕ группы"; then
                    echo ""
                    echo -e "${YELLOW}Останавливаю все группы...${NC}"
                    for dir in "${groups_arr[@]}"; do
                        local service=$(get_group_service "$dir")
                        stop_service "$service"
                    done
                    press_enter
                fi
                ;;
            r)
                echo ""
                echo -e "${YELLOW}Перезапускаю все группы...${NC}"
                for dir in "${groups_arr[@]}"; do
                    local service=$(get_group_service "$dir")
                    restart_service "$service"
                done
                press_enter
                ;;
            *) ;;
        esac
    done
}

# Полное меню для одной группы
menu_single_group_full() {
    local config_path="$1"
    local DEF=""

    while true; do
        # Динамически читаем имя/сервис/хеш (вдруг переименовали)
        local name=$(get_group_display_name "$config_path")
        local service=$(get_group_service "$config_path")
        local group_hash=$(get_group_hash "$config_path")
        local lock=""
        is_group_private "$config_path" && lock=" \Z3[private]\Zn"

        # Статус в шапку
        local st=$(get_service_status "$service")
        local STATUS
        if [ "$st" = "active" ]; then
            STATUS="\Z2● ${name}${lock} \Z2[работает]\Zn\n"
        else
            STATUS="\Z1● ${name}${lock} \Z1[остановлен]\Zn\n"
        fi
        STATUS="${STATUS}\Z7LXMF:\Zn ${group_hash}\n\Z7Путь:\Zn ${config_path}"

        dlg_menu "$name" "$STATUS" "$DEF" \
            "1" "${C_START}Запустить\Zn" \
            "2" "${C_STOP}Остановить\Zn" \
            "3" "${C_RESTART}Перезапустить\Zn" \
            "4" "${C_MON}Показать логи\Zn" \
            "5" "${C_NOMADNET}Подробный статус\Zn" \
            "6" "${C_GROUP}Участники\Zn" \
            "7" "${C_BOARD}Ожидающие (wait)\Zn" \
            "8" "${C_ENV}Статистика\Zn" \
            "d" "${C_STOP}Редактировать data.cfg\Zn" \
            "c" "${C_GROUP}Редактировать config.cfg\Zn" \
            "o" "${C_RESTART}Редактировать config.cfg.owr\Zn" \
            "n" "${C_ANNOUNCE}Анонсировать\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) start_service "$service"; press_enter ;;
            2) 
                if verify_pin "остановить $name"; then
                    stop_service "$service"
                    press_enter
                fi
                ;;
            3) restart_service "$service"; press_enter ;;
            4)
                echo ""
                echo -e "${CYAN}═══ ЛОГИ: $name (Ctrl+C для выхода) ═══${NC}"
                sudo journalctl -u "$service" -f --no-pager -n 50
                ;;
            5)
                echo ""
                sudo systemctl status "$service"
                press_enter
                ;;
            6) show_group_members_generic "$config_path" ;;
            7) show_group_wait_list "$config_path" ;;
            8) show_group_stats_generic "$config_path" "$service" ;;
            d)
                if verify_pin "редактировать data.cfg"; then
                    edit_group_file_generic "$config_path/data.cfg" "data.cfg"
                fi
                ;;
            c)
                if verify_pin "редактировать config.cfg"; then
                    edit_group_file_generic "$config_path/config.cfg" "config.cfg"
                fi
                ;;
            o)
                if verify_pin "редактировать config.cfg.owr"; then
                    edit_group_file_generic "$config_path/config.cfg.owr" "config.cfg.owr"
                fi
                ;;
            n)
                echo ""
                echo -e "${YELLOW}Отправляю анонс...${NC}"
                local svc=$(get_group_service "$config_path")
                # Включаем announce_startup
                sed -i 's/announce_startup = No/announce_startup = Yes/' "$config_path/config.cfg"
                sed -i 's/announce_startup = No/announce_startup = Yes/' "$config_path/config.cfg.owr" 2>/dev/null
                # Перезапускаем группу
                sudo systemctl restart "$svc"
                sleep 3
                # Возвращаем обратно
                sed -i 's/announce_startup = Yes/announce_startup = No/' "$config_path/config.cfg"
                sed -i 's/announce_startup = Yes/announce_startup = No/' "$config_path/config.cfg.owr" 2>/dev/null
                echo -e "${GREEN}✓ Анонс отправлен!${NC}"
                press_enter
                ;;
            *) ;;
        esac
    done
}

# Редактирование файла группы (универсальная функция)
edit_group_file_generic() {
    local file_path="$1"
    local file_name="$2"
    
    echo ""
    echo -e "${CYAN}═══ РЕДАКТИРОВАНИЕ: $file_name ═══${NC}"
    echo ""
    
    if [ -f "$file_path" ]; then
        local lines=$(wc -l < "$file_path")
        local size=$(du -h "$file_path" | cut -f1)
        echo -e "  📄 Файл: ${WHITE}$file_path${NC}"
        echo -e "  📊 Строк: ${WHITE}$lines${NC}  Размер: ${WHITE}$size${NC}"
        echo ""
    else
        echo -e "  ${RED}✗ Файл не найден!${NC}"
        press_enter
        return
    fi
    
    echo -e "${GRAY}Открываю nano для редактирования...${NC}"
    echo -e "${GRAY}(Ctrl+O сохранить, Ctrl+X выход)${NC}"
    sleep 1
    
    sudo nano "$file_path"
    
    echo ""
    echo -e "${GREEN}✓ Редактирование завершено${NC}"
    echo -e "${YELLOW}Не забудь перезапустить группу для применения изменений!${NC}"
    press_enter
}

# Участники группы (универсальная функция)
show_group_members_generic() {
    local config_path="$1"
    local data_file="$config_path/data.cfg"
    local name=$(get_group_display_name "$config_path")
    
    echo ""
    echo -e "${CYAN}═══ УЧАСТНИКИ: $name ═══${NC}"
    echo ""
    
    if [ -f "$data_file" ]; then
        "$VENV_PATH/bin/python3" << PYEOF
import configparser

data_file = "$data_file"
config = configparser.ConfigParser()
config.read(data_file)

total = 0

if 'admin' in config.sections():
    admins = dict(config['admin'])
    if admins:
        print("  \033[1;31m👑 АДМИНЫ:\033[0m")
        for hash_addr, nick in admins.items():
            nick = nick.strip() if nick.strip() else hash_addr[:16]
            print(f"     \033[1;37m{nick}\033[0m")
            print(f"     \033[0;90m{hash_addr}\033[0m")
            total += 1
        print()

if 'mod' in config.sections():
    mods = dict(config['mod'])
    if mods:
        print("  \033[1;35m🛡️ МОДЕРАТОРЫ:\033[0m")
        for hash_addr, nick in mods.items():
            nick = nick.strip() if nick.strip() else hash_addr[:16]
            print(f"     \033[1;37m{nick}\033[0m")
            print(f"     \033[0;90m{hash_addr}\033[0m")
            total += 1
        print()

if 'user' in config.sections():
    users = dict(config['user'])
    if users:
        print("  \033[1;32m👤 ПОЛЬЗОВАТЕЛИ:\033[0m")
        for hash_addr, nick in users.items():
            nick = nick.strip() if nick.strip() else hash_addr[:16]
            print(f"     \033[1;37m{nick}\033[0m \033[0;90m[{hash_addr[:16]}...]\033[0m")
            total += 1
        print()

if 'guest' in config.sections():
    guests = dict(config['guest'])
    if guests:
        print("  \033[1;36m👁️ ГОСТИ (только чтение):\033[0m")
        for hash_addr, nick in guests.items():
            nick = nick.strip() if nick.strip() else hash_addr[:16]
            print(f"     \033[0;90m{nick} [{hash_addr[:16]}...]\033[0m")
            total += 1
        print()

for section in ['block_admin', 'block_mod', 'block_user', 'block_guest', 'block_wait']:
    if section in config.sections():
        blocked = dict(config[section])
        if blocked:
            print("  \033[0;31m🚫 ЗАБЛОКИРОВАНЫ:\033[0m")
            for hash_addr, nick in blocked.items():
                nick = nick.strip() if nick.strip() else hash_addr[:16]
                print(f"     \033[0;90m{nick} [{hash_addr[:16]}...]\033[0m")
            print()
            break

print(f"  \033[1;37mВсего участников: {total}\033[0m")
PYEOF
    else
        echo -e "  ${RED}Файл данных не найден${NC}"
    fi
    
    press_enter
}

# Список ожидающих (wait)
show_group_wait_list() {
    local config_path="$1"
    local data_file="$config_path/data.cfg"
    local name=$(get_group_display_name "$config_path")
    
    echo ""
    echo -e "${CYAN}═══ ОЖИДАЮЩИЕ ОДОБРЕНИЯ: $name ═══${NC}"
    echo ""
    
    if [ -f "$data_file" ]; then
        "$VENV_PATH/bin/python3" << PYEOF
import configparser

data_file = "$data_file"
config = configparser.ConfigParser()
config.read(data_file)

if 'wait' in config.sections():
    wait_list = dict(config['wait'])
    if wait_list:
        print("  \033[1;33m⏳ ОЖИДАЮТ ОДОБРЕНИЯ:\033[0m")
        print()
        for i, (hash_addr, nick) in enumerate(wait_list.items(), 1):
            nick = nick.strip() if nick.strip() else "Без имени"
            print(f"  {i}. \033[1;37m{nick}\033[0m")
            print(f"     \033[0;90m{hash_addr}\033[0m")
            print()
        print(f"  \033[0;33mВсего ожидают: {len(wait_list)}\033[0m")
        print()
        print("  \033[0;90mДля одобрения в группе: /allow <hash>\033[0m")
        print("  \033[0;90mДля отклонения: /deny <hash>\033[0m")
    else:
        print("  \033[0;32m✓ Нет ожидающих\033[0m")
else:
    print("  \033[0;32m✓ Нет ожидающих\033[0m")
PYEOF
    else
        echo -e "  ${RED}Файл данных не найден${NC}"
    fi
    
    press_enter
}

# Статистика группы (универсальная)
show_group_stats_generic() {
    local config_path="$1"
    local service="$2"
    local name=$(get_group_display_name "$config_path")
    local data_file="$config_path/data.cfg"
    local stat_file="$config_path/statistic.cfg"
    
    echo ""
    echo -e "${CYAN}═══ СТАТИСТИКА: $name ═══${NC}"
    echo ""
    
    local group_hash=$(get_group_hash "$config_path")
    echo -e "  ${WHITE}📛 Название:${NC} $name"
    echo -e "  ${WHITE}🔗 LXMF:${NC} $group_hash"
    
    if is_group_private "$config_path"; then
        echo -e "  ${WHITE}🔒 Тип:${NC} Приватная (wait)"
    else
        echo -e "  ${WHITE}🌐 Тип:${NC} Публичная"
    fi
    echo ""
    
    if [ -f "$data_file" ]; then
        "$VENV_PATH/bin/python3" << PYEOF
import configparser

data_file = "$data_file"
config = configparser.ConfigParser()
config.read(data_file)

admins = len(dict(config['admin'])) if 'admin' in config.sections() else 0
mods = len(dict(config['mod'])) if 'mod' in config.sections() else 0
users = len(dict(config['user'])) if 'user' in config.sections() else 0
guests = len(dict(config['guest'])) if 'guest' in config.sections() else 0
wait = len(dict(config['wait'])) if 'wait' in config.sections() else 0

print(f"  👑 Админов: {admins}")
print(f"  🛡️ Модераторов: {mods}")
print(f"  👤 Пользователей: {users}")
print(f"  👁️ Гостей: {guests}")
print(f"  ⏳ Ожидают: {wait}")
print(f"  ─────────────────")
print(f"  📊 Всего: {admins + mods + users + guests}")
PYEOF
    fi
    
    echo ""
    
    if [ -f "$stat_file" ]; then
        echo -e "  ${WHITE}📨 Статистика сообщений:${NC}"
        "$VENV_PATH/bin/python3" << PYEOF
import configparser

stat_file = "$stat_file"
config = configparser.ConfigParser()
config.read(stat_file)

if 'main' in config.sections():
    main = config['main']
    rx = main.get('rx_count', '0')
    tx = main.get('tx_count', '0')
    print(f"     Получено: {rx}")
    print(f"     Отправлено: {tx}")
PYEOF
    fi
    
    echo ""
    
    local pid=$(systemctl show -p MainPID "$service" 2>/dev/null | cut -d= -f2)
    if [ "$pid" != "0" ] && [ -n "$pid" ]; then
        echo -e "  ${GRAY}Ресурсы (PID: $pid):${NC}"
        ps -p "$pid" -o %cpu,%mem,rss --no-headers 2>/dev/null | \
            awk '{printf "  CPU: %s%%  MEM: %s%%  RAM: %.1f MB\n", $1, $2, $3/1024}'
    fi
    
    press_enter
}

# Удаление сообщения с доски
delete_board_message() {
    echo ""
    echo -e "${CYAN}═══ УДАЛЕНИЕ СООБЩЕНИЯ ═══${NC}"
    echo ""
    
    if [ ! -f "$BOARD_PATH" ]; then
        echo -e "${RED}Файл доски не найден${NC}"
        press_enter
        return
    fi
    
    # Показываем сообщения с номерами
    "$VENV_PATH/bin/python3" << 'PYEOF'
import RNS.vendor.umsgpack as msgpack

board_path = "/root/.nomadmb/storage/board"

try:
    with open(board_path, 'rb') as f:
        messages = msgpack.unpack(f)
    
    if not messages:
        print("Доска пуста")
    else:
        print(f"Всего сообщений: {len(messages)}\n")
        for i, msg in enumerate(messages, 1):
            clean = msg.replace('`F888', '').replace('`Fddd', '').replace('`Fd8f', '').replace('`f', '')
            preview = clean[:80] + "..." if len(clean) > 80 else clean
            print(f"  [{i}] {preview}")
except Exception as e:
    print(f"Ошибка: {e}")
PYEOF

    echo ""
    echo -ne "${WHITE}Номер сообщения для удаления (0 = отмена): ${NC}"
    read msg_num
    
    if [ "$msg_num" == "0" ] || [ -z "$msg_num" ]; then
        echo -e "${GRAY}Отменено${NC}"
        press_enter
        return
    fi
    
    # Удаляем сообщение
    "$VENV_PATH/bin/python3" << PYEOF
import RNS.vendor.umsgpack as msgpack

board_path = "/root/.nomadmb/storage/board"
msg_num = $msg_num

try:
    with open(board_path, 'rb') as f:
        messages = msgpack.unpack(f)
    
    if msg_num < 1 or msg_num > len(messages):
        print(f"\033[0;31mНеверный номер. Доступно: 1-{len(messages)}\033[0m")
    else:
        deleted = messages.pop(msg_num - 1)
        with open(board_path, 'wb') as f:
            msgpack.pack(messages, f)
        clean = deleted.replace('`F888', '').replace('`Fddd', '')[:50]
        print(f"\033[0;32m✓ Сообщение #{msg_num} удалено: {clean}...\033[0m")
except Exception as e:
    print(f"\033[0;31mОшибка: {e}\033[0m")
PYEOF
    
    press_enter
}

# Экспорт доски (бэкап сообщений в файл)
export_board() {
    echo ""
    echo -e "${CYAN}═══ ЭКСПОРТ ДОСКИ ═══${NC}"
    echo ""

    if [ ! -f "$BOARD_PATH" ]; then
        echo -e "${YELLOW}Доска пуста — экспортировать нечего${NC}"
        press_enter
        return
    fi

    local count
    count=$("$VENV_PATH/bin/python3" -c "
import RNS.vendor.umsgpack as msgpack
with open('$BOARD_PATH', 'rb') as f:
    print(len(msgpack.unpack(f)))
" 2>/dev/null || echo "?")

    local backup_dir
    backup_dir="$(dirname "$(dirname "$BOARD_PATH")")/backups"
    local default_file="$backup_dir/board_backup_$(date +%Y%m%d_%H%M%S).msgpack"

    echo -e "  Сообщений на доске: ${WHITE}$count${NC}"
    echo ""
    echo -e "${GRAY}Куда сохранить (Enter = по умолчанию):${NC}"
    echo -e "${GRAY}  $default_file${NC}"
    echo -ne "${WHITE}Путь: ${NC}"
    read -r dest
    dest="${dest/#\~/$HOME}"
    [ -z "$dest" ] && dest="$default_file"

    mkdir -p "$(dirname "$dest")" 2>/dev/null
    if cp "$BOARD_PATH" "$dest" 2>/dev/null; then
        echo ""
        echo -e "${GREEN}✓ Доска сохранена:${NC}"
        echo -e "  ${WHITE}$dest${NC}"
        echo ""
        echo -e "${GRAY}Скопируй файл на флешку или другую машину, например:${NC}"
        echo -e "${GRAY}  scp '$dest' user@newhost:~/${NC}"
    else
        echo -e "${RED}✗ Не удалось сохранить в: $dest${NC}"
    fi
    press_enter
}

# Импорт доски (восстановление сообщений из файла)
import_board() {
    echo ""
    echo -e "${CYAN}═══ ИМПОРТ ДОСКИ ═══${NC}"
    echo ""
    echo -e "${YELLOW}⚠ Импорт ЗАМЕНИТ текущую доску содержимым бэкапа.${NC}"
    echo -e "${GRAY}  Текущая доска будет сохранена в .bak перед заменой.${NC}"
    echo ""

    local backup_dir
    backup_dir="$(dirname "$(dirname "$BOARD_PATH")")/backups"

    # Собираем доступные бэкапы (новые сверху)
    local files=()
    if [ -d "$backup_dir" ]; then
        while IFS= read -r f; do
            [ -n "$f" ] && files+=("$f")
        done < <(ls -1t "$backup_dir"/*.msgpack 2>/dev/null)
    fi

    local src=""
    if [ ${#files[@]} -gt 0 ]; then
        echo -e "${WHITE}Найденные бэкапы в $backup_dir:${NC}"
        echo ""
        local i=1
        for f in "${files[@]}"; do
            local cnt sz mt
            cnt=$("$VENV_PATH/bin/python3" -c "
import RNS.vendor.umsgpack as msgpack
with open('$f','rb') as fh: print(len(msgpack.unpack(fh)))
" 2>/dev/null || echo "?")
            sz=$(du -h "$f" 2>/dev/null | cut -f1)
            mt=$(date -r "$f" '+%Y-%m-%d %H:%M' 2>/dev/null)
            echo -e "  ${LIGHT_GREEN}[$i]${NC} $(basename "$f")"
            echo -e "      ${GRAY}$mt · $sz · сообщений: $cnt${NC}"
            i=$((i+1))
        done
        echo ""
        echo -e "${GRAY}Введи номер бэкапа, либо свой путь к файлу (0 = отмена):${NC}"
        echo -ne "${WHITE}Выбор: ${NC}"
        read -r pick
        pick="${pick/#\~/$HOME}"

        if [ "$pick" == "0" ] || [ -z "$pick" ]; then
            echo -e "${GRAY}Отменено${NC}"
            press_enter
            return
        fi
        if [[ "$pick" =~ ^[0-9]+$ ]] && [ "$pick" -ge 1 ] && [ "$pick" -le ${#files[@]} ]; then
            src="${files[$((pick-1))]}"
        else
            src="$pick"
        fi
    else
        echo -e "${GRAY}В $backup_dir бэкапов не найдено.${NC}"
        echo -ne "${WHITE}Путь к файлу бэкапа (0 = отмена): ${NC}"
        read -r src
        src="${src/#\~/$HOME}"
        if [ "$src" == "0" ] || [ -z "$src" ]; then
            echo -e "${GRAY}Отменено${NC}"
            press_enter
            return
        fi
    fi

    if [ ! -f "$src" ]; then
        echo -e "${RED}Файл не найден: $src${NC}"
        press_enter
        return
    fi

    # Валидация: это читаемая msgpack-доска (список)?
    local count
    count=$("$VENV_PATH/bin/python3" -c "
import RNS.vendor.umsgpack as msgpack, sys
try:
    with open('$src', 'rb') as f:
        data = msgpack.unpack(f)
    if not isinstance(data, list):
        sys.exit(1)
    print(len(data))
except Exception:
    sys.exit(1)
" 2>/dev/null)
    if [ -z "$count" ]; then
        echo -e "${RED}✗ Файл не похож на доску (повреждён или неверный формат)${NC}"
        press_enter
        return
    fi

    echo ""
    echo -e "  Сообщений в бэкапе: ${WHITE}$count${NC}"
    echo -ne "${WHITE}Восстановить эту доску? (y/n): ${NC}"
    read -r confirm
    if [[ ! "$confirm" =~ ^[YyДд]$ ]]; then
        echo -e "${GRAY}Отменено${NC}"
        press_enter
        return
    fi

    mkdir -p "$(dirname "$BOARD_PATH")" 2>/dev/null
    if [ -f "$BOARD_PATH" ]; then
        local bak="${BOARD_PATH}.bak.$(date +%Y%m%d_%H%M%S)"
        cp "$BOARD_PATH" "$bak" && echo -e "${GRAY}Текущая доска сохранена: $bak${NC}"
    fi

    if cp "$src" "$BOARD_PATH"; then
        echo -e "${GREEN}✓ Доска восстановлена ($count сообщений)${NC}"
        echo -e "${GRAY}Перезапуск messageboard для применения...${NC}"
        restart_service "messageboard.service"
    else
        echo -e "${RED}✗ Ошибка восстановления${NC}"
    fi
    press_enter
}

# ══════════════════════════════════════════════════════════════════
# ПОДМЕНЮ: ДОСКА ОБЪЯВЛЕНИЙ
# ══════════════════════════════════════════════════════════════════

menu_messageboard() {
    local DEF=""
    while true; do
        # Статус сервиса доски в шапку
        local st=$(get_service_status "messageboard.service")
        local STATUS
        if [ "$st" = "active" ]; then
            STATUS="\Z2● messageboard [работает]\Zn"
        else
            STATUS="\Z1● messageboard [остановлен]\Zn"
        fi

        dlg_menu "ДОСКА ОБЪЯВЛЕНИЙ" "$STATUS" "$DEF" \
            "1"  "${C_START}Запустить\Zn" \
            "2"  "${C_STOP}Остановить\Zn" \
            "3"  "${C_RESTART}Перезапустить\Zn" \
            "4"  "${C_MON}Показать логи\Zn" \
            "5"  "${C_NOMADNET}Просмотреть сообщения\Zn" \
            "6"  "${C_GROUP}Статистика\Zn" \
            "7"  "${C_STOP}Удалить сообщение\Zn" \
            "8"  "${C_GROUPS}Принудительный анонс\Zn" \
            "9"  "${C_STOP}Block адрес\Zn" \
            "u"  "${C_START}Unblock адрес\Zn" \
            "e"  "${C_BOARD}Экспорт доски (бэкап)\Zn" \
            "i"  "${C_NOMADNET}Импорт доски (восстановить)\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1)
                start_service "messageboard.service"
                press_enter
                ;;
            2)
                if verify_pin "остановить messageboard"; then
                    stop_service "messageboard.service"
                    press_enter
                fi
                ;;
            3)
                restart_service "messageboard.service"
                press_enter
                ;;
            4)
                echo ""
                echo -e "${CYAN}═══ ЛОГИ ДОСКИ (Ctrl+C для выхода) ═══${NC}"
                echo ""
                sudo journalctl -u messageboard.service -f --no-pager -n 50
                ;;
            5)
                echo ""
                echo -e "${CYAN}═══ СООБЩЕНИЯ НА ДОСКЕ ═══${NC}"
                echo ""
                if [ -f "$BOARD_PATH" ]; then
                    "$VENV_PATH/bin/python3" -c "
import RNS.vendor.umsgpack as msgpack
try:
    with open('$BOARD_PATH', 'rb') as f:
        messages = msgpack.unpack(f)
    if messages:
        print(f'Всего сообщений: {len(messages)}\n')
        for i, msg in enumerate(messages[-10:], 1):
            clean = msg.replace('\`F888', '').replace('\`Fddd', '').replace('\`Fd8f', '').replace('\`f', '')
            print(f'{i}. {clean[:100]}...' if len(clean) > 100 else f'{i}. {clean}')
    else:
        print('Доска пуста')
except Exception as e:
    print(f'Ошибка чтения: {e}')
" 2>/dev/null || echo "Не удалось прочитать доску"
                else
                    echo -e "${GRAY}Доска пуста — сообщений пока нет${NC}"
                fi
                press_enter
                ;;
            6)
                echo ""
                echo -e "${CYAN}═══ СТАТИСТИКА ДОСКИ ═══${NC}"
                echo ""
                local pid=$(systemctl show -p MainPID messageboard.service 2>/dev/null | cut -d= -f2)
                if [ "$pid" != "0" ] && [ -n "$pid" ]; then
                    echo -e "${WHITE}Доска объявлений (PID: $pid)${NC}"
                    ps -p "$pid" -o %cpu,%mem,rss --no-headers 2>/dev/null | \
                        awk '{printf "  CPU: %s%%  MEM: %s%%  RSS: %.1f MB\n", $1, $2, $3/1024}'
                    echo ""
                fi
                if [ -f "$BOARD_PATH" ]; then
                    local msg_count=$("$VENV_PATH/bin/python3" -c "
import RNS.vendor.umsgpack as msgpack
with open('$BOARD_PATH', 'rb') as f:
    print(len(msgpack.unpack(f)))
" 2>/dev/null || echo "0")
                    echo -e "  Сообщений на доске: ${WHITE}$msg_count${NC}"
                    local board_size=$(du -h "$BOARD_PATH" 2>/dev/null | cut -f1)
                    echo -e "  Размер файла: ${WHITE}$board_size${NC}"
                fi
                press_enter
                ;;
            7)
                if verify_pin "удалить сообщение"; then
                    delete_board_message
                fi
                ;;
            8)
                echo ""
                echo -e "${CYAN}Принудительный анонс доски...${NC}"
                rm -f ~/.nomadmb/storage/last_announce
                restart_service "messageboard.service"
                echo -e "${GREEN}✓ Анонс выполнен!${NC}"
                press_enter
                ;;
            9)
                if verify_pin "block"; then
                    local block_hash
                    block_hash=$(dialog --colors \
                        --backtitle "RETICULUM CONTROL" \
                        --title " БЛОКИРОВКА АДРЕСА " \
                        --inputbox "\nВведите LXMF адрес для блокировки (32 hex):" 10 56 \
                        3>&1 1>&2 2>&3)
                    local rc=$?
                    clear
                    [ $rc -ne 0 ] && continue
                    block_hash=$(echo "$block_hash" | tr -d "[:space:]" | sed "s/lxmf@//")
                    if [ ${#block_hash} -eq 32 ]; then
                        if grep -qx "$block_hash" ~/.nomadmb/storage/blocklist 2>/dev/null; then
                            dlg_msg "\n\Z3⚠ Адрес уже в блок-листе\Zn"
                        else
                            echo "$block_hash" >> ~/.nomadmb/storage/blocklist
                            dlg_msg "\n\Z2✓ Заблокирован:\Zn\n${block_hash}"
                        fi
                    elif [ -z "$block_hash" ]; then
                        : # отмена
                    else
                        dlg_msg "\n\Z1Неверный адрес (нужно 32 hex)\Zn"
                    fi
                fi
                ;;
            u)
                echo ""
                echo -e "${CYAN}═══ ЗАБЛОКИРОВАННЫЕ ═══${NC}"
                if [ -f ~/.nomadmb/storage/blocklist ]; then
                    cat -n ~/.nomadmb/storage/blocklist
                    echo ""
                    echo -ne "${CYAN}Номер строки для разблокировки (0 = отмена): ${NC}"
                    local line_num=$(read_number_or_esc)
                    echo ""
                    if [ "$line_num" != "0" ] && [ "$line_num" != "ESC" ] && [ -n "$line_num" ]; then
                        if verify_pin "unblock"; then
                            sed -i "${line_num}d" ~/.nomadmb/storage/blocklist
                            echo -e "${GREEN}✓ Разблокировано!${NC}"
                        fi
                    fi
                else
                    echo -e "${GRAY}Блок-лист пуст${NC}"
                fi
                press_enter
                ;;
            e)
                export_board
                ;;
            i)
                if verify_pin "импортировать доску"; then
                    import_board
                fi
                ;;
            *) ;;
        esac
    done
}

# ══════════════════════════════════════════════════════════════════
# ГЛАВНОЕ МЕНЮ
# ══════════════════════════════════════════════════════════════════

main_menu() {
    # Проверяем PIN только если запущен не из f2b
    if [[ "$1" != "--skip-pin" ]]; then
        if ! check_pin_exists; then
            echo ""
            echo -e "${YELLOW}PIN-код не установлен.${NC}"
            echo -ne "${WHITE}Установить сейчас? (y/n): ${NC}"
            read -r setup_now
            if [[ "$setup_now" =~ ^[YyДд]$ ]]; then
                setup_pin
            fi
        fi
    fi
    
    local DEF_MAIN=""
    while true; do
        # Полный статус как в оригинале (без эмодзи, с \Z-цветами)
        local active=0
        for service in "${SERVICES[@]}"; do
            [ "$(get_service_status "$service")" = "active" ] && ((active++))
        done
        local total=${#SERVICES[@]}

        local STATUS=""
        if [ $active -eq $total ]; then
            STATUS="\Z2● Все сервисы работают (${active}/${total})\Zn\n"
        elif [ $active -eq 0 ]; then
            STATUS="\Z1● Все сервисы остановлены\Zn\n"
        else
            STATUS="\Z3● Работает ${active}/${total} сервисов\Zn\n"
        fi

        # Статус групп (lxmf_group_*)
        local groups_total=0
        local groups_active=0
        for dir in /root/.config/lxmf_group_*; do
            if [ -d "$dir" ] && [ -f "$dir/identity" ]; then
                ((groups_total++))
                local svc=$(basename "$dir").service
                [ "$(get_service_status "$svc")" = "active" ] && ((groups_active++))
            fi
        done
        if [ $groups_total -gt 0 ]; then
            if [ $groups_active -eq $groups_total ]; then
                STATUS="${STATUS}\Z2● Группы: ${groups_active}/${groups_total}\Zn\n"
            elif [ $groups_active -eq 0 ]; then
                STATUS="${STATUS}\Z1● Группы: ${groups_active}/${groups_total}\Zn\n"
            else
                STATUS="${STATUS}\Z3● Группы: ${groups_active}/${groups_total}\Zn\n"
            fi
        fi

        # Статус PIN
        if check_pin_exists; then
            STATUS="${STATUS}PIN активен\n"
        fi

        local BOT_NAME="$(get_bot_name)"

        dlg_menu "ГЛАВНОЕ МЕНЮ" "$STATUS" "$DEF_MAIN" \
            "1" "${C_START}Быстрый старт (запустить всё)\Zn" \
            "2" "${C_RETICULUM}Сервисы Reticulum\Zn" \
            "3" "${C_BOT}${BOT_NAME}\Zn" \
            "4" "${C_ENV}Окружение и настройки\Zn" \
            "5" "${C_MON}Мониторинг\Zn" \
            "6" "${C_RESTART}Перезапустить ВСЁ\Zn" \
            "7" "${C_STOP}Остановить ВСЁ\Zn" \
            "8" "Настройка PIN" \
            "9" "${C_F2B}Fail2ban Manager (f2b)\Zn"

        # Пусто = Назад/Esc = выход
        if [ -z "$DLG_CHOICE" ]; then
            clear
            echo -e "\n${CYAN}Скрипт завершён.${NC}\n"
            exit 0
        fi
        DEF_MAIN="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) start_all ;;
            2) menu_services ;;
            3) menu_bot ;;
            4) menu_environment ;;
            5) menu_monitoring ;;
            6) restart_all ;;
            7) 
                if verify_pin "остановить ВСЁ"; then
                    stop_all
                fi
                ;;
            8) menu_pin ;;
            9) exec /usr/local/bin/f2b ;;
            *) ;;
        esac
    done
}

# Меню настройки PIN
menu_pin() {
    local DEF=""
    while true; do
        local STATUS
        if check_pin_exists; then
            STATUS="\Z2● PIN установлен\Zn"
        else
            STATUS="\Z3● PIN не установлен\Zn"
        fi

        dlg_menu "НАСТРОЙКА PIN" "$STATUS" "$DEF" \
            "1" "${C_START}Установить/Изменить PIN\Zn" \
            "2" "${C_STOP}Удалить PIN\Zn"

        [ -z "$DLG_CHOICE" ] && return
        DEF="$DLG_CHOICE"

        clear
        case "$DLG_CHOICE" in
            1) change_pin ;;
            2) reset_pin ;;
            *) ;;
        esac
    done
}

# ══════════════════════════════════════════════════════════════════
# БЫСТРЫЕ КОМАНДЫ (аргументы командной строки)
# ══════════════════════════════════════════════════════════════════

show_help() {
    echo ""
    echo -e "${CYAN}Reticulum Control${NC}"
    echo ""
    echo "Использование: rn [команда]"
    echo ""
    echo "Команды:"
    echo "  (без аргументов)  Интерактивное меню"
    echo "  status            Показать статус всех сервисов"
    echo "  start             Запустить все сервисы"
    echo "  stop              Остановить все сервисы"
    echo "  restart           Перезапустить все сервисы"
    echo "  logs              Показать логи (live)"
    echo "  help              Эта справка"
    echo ""
}

# ══════════════════════════════════════════════════════════════════
# ТОЧКА ВХОДА
# ══════════════════════════════════════════════════════════════════

# Конвертируем аргумент если на русском
arg=$(convert_ru_to_en "${1:-}")

case "$arg" in
    status)
        for service in "${SERVICES[@]}"; do
            print_service_status "$service"
        done
        ;;
    start)
        start_all
        ;;
    stop)
        stop_all
        ;;
    restart)
        restart_all
        ;;
    logs)
        sudo journalctl -u reticulum.service -u nomadnet.service -u surgutbot86.service -u "$GROUP_SERVICE" -u messageboard.service -f --no-pager
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        main_menu "$1"
        ;;
esac
