# Статистика ноды
show_node_stats() {
    echo ""
    echo -e "${CYAN}${L[nns_hdr]}${NC}"
    echo ""
    
    # Парсим peersettings через Python (msgpack формат)
    NNS_NAME="${L[nns_name]}" NNS_CONNECTS="${L[nns_connects]}" \
    NNS_PAGE_REQ="${L[nns_page_req]}" NNS_FILE_REQ="${L[nns_file_req]}" \
    NNS_LAST_ANNOUNCE="${L[nns_last_announce]}" \
    "$VENV_PATH/bin/python3" -c "
import RNS.vendor.umsgpack as msgpack
import os
from datetime import datetime

L_NAME = os.environ.get('NNS_NAME', 'Name:')
L_CONN = os.environ.get('NNS_CONNECTS', 'Connections:')
L_PAGE = os.environ.get('NNS_PAGE_REQ', 'Page requests:')
L_FILE = os.environ.get('NNS_FILE_REQ', 'File requests:')
L_ANN  = os.environ.get('NNS_LAST_ANNOUNCE', 'Last announce:')

peers_file = '/root/.nomadnetwork/storage/peersettings'
if os.path.exists(peers_file):
    with open(peers_file, 'rb') as f:
        data = msgpack.unpack(f)
    
    print(f'  📛 {L_NAME} ${WHITE}{data.get(\"display_name\", \"N/A\")}${NC}')
    print(f'  🔗 {L_CONN} ${WHITE}{data.get(\"node_connects\", 0)}${NC}')
    print(f'  📄 {L_PAGE} ${WHITE}{data.get(\"served_page_requests\", 0)}${NC}')
    print(f'  📁 {L_FILE} ${WHITE}{data.get(\"served_file_requests\", 0)}${NC}')
    
    # Последний анонс
    last_announce = data.get('last_announce', 0)
    if last_announce:
        try:
            dt = datetime.fromtimestamp(last_announce)
            print(f'  📢 {L_ANN} ${WHITE}{dt.strftime(\"%Y-%m-%d %H:%M:%S\")}${NC}')
        except:
            pass
" 2>/dev/null
    
    echo ""
    
    # Счётчики посещений страниц
    local counter_dir="/root/.nomadnetwork/storage/counters"
    if [ -d "$counter_dir" ]; then
        echo -e "  ${WHITE}${L[nns_page_visits]}${NC}"
        local index_count=$(cat "$counter_dir/index.txt" 2>/dev/null || echo "0")
        local board_count=$(cat "$counter_dir/board.txt" 2>/dev/null || echo "0")
        local guide_count=$(cat "$counter_dir/guide.txt" 2>/dev/null || echo "0")
        echo -e "    📄 index.mu:  ${WHITE}$index_count${NC}"
        echo -e "    📋 board.mu:  ${WHITE}$board_count${NC}"
        echo -e "    📖 guide.mu:  ${WHITE}$guide_count${NC}"
        local total=$((index_count + board_count + guide_count))
        echo -e "    ─────────────────"
        echo -e "    📊 ${L[nns_total]}     ${WHITE}$total${NC}"
        echo ""
    fi
    
    # LXMF Storage
    local lxmf_dir="/root/.nomadnetwork/storage/lxmf"
    if [ -d "$lxmf_dir" ]; then
        local storage_size=$(du -sh "$lxmf_dir" 2>/dev/null | cut -f1)
        echo -e "  💾 ${L[nns_lxmf_storage]} ${WHITE}$storage_size${NC}"
        
        local msg_count=$(ls -1 "$lxmf_dir/messagestore" 2>/dev/null | wc -l)
        echo -e "  📨 ${L[nns_msgs_stored]} ${WHITE}$msg_count${NC}"
    fi
    
    echo ""
    
    # Ресурсы
    local pid=$(systemctl show -p MainPID nomadnet.service 2>/dev/null | cut -d= -f2)
    if [ "$pid" != "0" ] && [ -n "$pid" ]; then
        echo -e "  ${GRAY}$(printf "${L[nns_resources]}" "$pid")${NC}"
        ps -p "$pid" -o %cpu,%mem,rss --no-headers 2>/dev/null | \
            awk '{printf "  CPU: %s%%  MEM: %s%%  RAM: %.1f MB\n", $1, $2, $3/1024}'
    fi
    
    press_enter
}

# ══════════════════════════════════════════════════════════════════
# ПОДМЕНЮ: SURGUT GROUP
# ══════════════════════════════════════════════════════════════════

# Редактирование данных группы (название, описание, участники)
edit_group_config() {
    local config_file="/root/.config/lxmf_distribution_group_extended/data.cfg"
    
    echo ""
    echo -e "${CYAN}${L[cfg_data_hdr]}${NC}"
    echo ""
    
    if [ -f "$config_file" ]; then
        local lines=$(wc -l < "$config_file")
        local size=$(du -h "$config_file" | cut -f1)
        echo -e "  📄 ${L[cfg_file]} ${WHITE}$config_file${NC}"
        echo -e "  📊 $(printf "${L[cfg_lines_size]}" "$lines" "$size")"
        echo ""
    else
        echo -e "  ${RED}${L[cfg_notfound]}${NC}"
        press_enter
        return
    fi
    
    echo -e "${YELLOW}${L[cfg_data_warn]}${NC}"
    echo -e "${GRAY}${L[cfg_opening_nano]}${NC}"
    echo -e "${GRAY}${L[cfg_nano_keys]}${NC}"
    sleep 1
    
    sudo nano "$config_file"
    
    echo ""
    echo -e "${GREEN}${L[cfg_edit_done]}${NC}"
    echo -e "${YELLOW}${L[cfg_restart_group]}${NC}"
    press_enter
}

# Редактирование настроек группы (display_name, интервал анонса)
edit_group_settings() {
    local config_file="/root/.config/lxmf_distribution_group_extended/config.cfg.owr"
    
    echo ""
    echo -e "${CYAN}${L[cfg_owr_hdr]}${NC}"
    echo ""
    
    if [ -f "$config_file" ]; then
        local lines=$(wc -l < "$config_file")
        local size=$(du -h "$config_file" | cut -f1)
        echo -e "  📄 ${L[cfg_file]} ${WHITE}$config_file${NC}"
        echo -e "  📊 $(printf "${L[cfg_lines_size]}" "$lines" "$size")"
        echo ""
        
        # Показываем текущие важные настройки
        local display_name=$(grep "^display_name" "$config_file" | head -1 | cut -d'=' -f2 | tr -d ' ')
        local announce_interval=$(grep "^announce_interval" "$config_file" | cut -d'=' -f2 | tr -d ' ')
        echo -e "  📛 ${L[cfg_owr_name]} ${WHITE}$display_name${NC}"
        echo -e "  📢 $(printf "${L[cfg_owr_interval]}" "${announce_interval}")"
        echo ""
    else
        echo -e "  ${RED}${L[cfg_notfound]}${NC}"
        press_enter
        return
    fi
    
    echo -e "${YELLOW}${L[cfg_owr_warn]}${NC}"
    echo -e "${GRAY}${L[cfg_opening_nano]}${NC}"
    echo -e "${GRAY}${L[cfg_nano_keys]}${NC}"
    sleep 1
    
    sudo nano "$config_file"
    
    echo ""
    echo -e "${GREEN}${L[cfg_edit_done]}${NC}"
    echo -e "${YELLOW}${L[cfg_restart_group]}${NC}"
    press_enter
}

