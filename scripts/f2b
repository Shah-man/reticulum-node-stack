DLG_CHOICE=""
dlg_menu() {
    local title="$1"; shift
    local status="$1"; shift
    local default="$1"; shift
    local items=("$@")
    local def=()
    [ -n "$default" ] && def=(--default-item "$default")
    DLG_CHOICE=$(dialog --colors \
        --backtitle "FAIL2BAN MANAGER" \
        --title " $title " \
        --ok-label "${L[btn_open]}" --cancel-label "${L[btn_back]}" \
        "${def[@]}" \
        --menu "$status" 0 0 0 \
        "${items[@]}" \
        3>&1 1>&2 2>&3)
}
dlg_msg() { dialog --colors --msgbox "$1" 0 0; }

# ══════════════════════════════════════════════════════════════════
# ЧТЕНИЕ КЛАВИШ (с поддержкой ESC)
# ══════════════════════════════════════════════════════════════════

read_key() {
  local key=""
  IFS= read -rsn1 key
  
  if [[ "$key" == $'\e' ]]; then
    read -rsn2 -t 0.1 extra
    if [ -z "$extra" ]; then
      echo "ESC"
      return
    fi
  fi
  
  echo "$key"
}

# ══════════════════════════════════════════════════════════════════
# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
# ══════════════════════════════════════════════════════════════════

check_password() {
  if [ ! -f "$F2B_PASS_FILE" ]; then
    echo -e "  ${RED}$(printf "${L[pass_notfound]}" "$F2B_PASS_FILE")${NC}"
    echo -e "  ${YELLOW}$(printf "${L[pass_create]}" "$F2B_PASS_FILE" "$F2B_PASS_FILE")${NC}"
    sleep 2
    return 1
  fi
  F2B_PASSWORD=$(cat "$F2B_PASS_FILE")
  echo ""
  echo -e "  ${GRAY}${L[esc_cancel]}${NC}"
  echo -e -n "  ${YELLOW}${L[enter_pass]}${NC}"
  
  local INPUT_PASS=""
  local char=""
  
  while true; do
    IFS= read -rsn1 char
    
    # ESC
    if [[ "$char" == $'\e' ]]; then
      read -rsn2 -t 0.1 extra
      if [ -z "$extra" ]; then
        echo ""
        echo -e "  ${GRAY}${L[cancelled]}${NC}"
        sleep 0.5
        return 1
      fi
    fi
    
    # Enter
    if [[ "$char" == "" ]]; then
      echo ""
      break
    fi
    
    # Backspace
    if [[ "$char" == $'\x7f' ]]; then
      if [ -n "$INPUT_PASS" ]; then
        INPUT_PASS="${INPUT_PASS%?}"
        echo -ne "\b \b"
      fi
      continue
    fi
    
    INPUT_PASS+="$char"
    echo -n "*"
  done
  
  if [ "$INPUT_PASS" != "$F2B_PASSWORD" ]; then
    echo -e "  ${RED}${L[wrong_pass]}${NC}"
    sleep 1
    return 1
  fi
  return 0
}

header() {
  clear
  echo ""
  echo -e "${CYAN}────────────────────────────────────────${NC}"
  echo -e "${WHITE}${BOLD}  🛡️  ${L[title]} | $(hostname)${NC}"
  echo -e "${CYAN}────────────────────────────────────────${NC}"
  echo ""
}

status_line() {
  local STATUS=$(systemctl is-active fail2ban)
  if [ "$STATUS" = "active" ]; then
    echo -e "  ${L[status_label]} ${GREEN}${L[st_active]}${NC}"
  else
    echo -e "  ${L[status_label]} ${RED}${L[st_inactive]}${NC}"
  fi
  echo ""
}

press_enter() {
  echo ""
  echo -e -n "  ${GRAY}${L[press_enter]}${NC}"
  read
}

format_time() {
  local seconds=$1
  if [ "$seconds" -ge 86400 ]; then
    local days=$((seconds / 86400))
    local hours=$(((seconds % 86400) / 3600))
    echo "${days}${L[d_days]} ${hours}${L[d_hours]}"
  elif [ "$seconds" -ge 3600 ]; then
    local hours=$((seconds / 3600))
    local mins=$(((seconds % 3600) / 60))
    echo "${hours}${L[d_hours]} ${mins}${L[d_min]}"
  elif [ "$seconds" -ge 60 ]; then
    local mins=$((seconds / 60))
    echo "${mins}${L[d_min]}"
  else
    echo "${seconds}${L[d_sec]}"
  fi
}

# ══════════════════════════════════════════════════════════════════
# СТАТУС
# ══════════════════════════════════════════════════════════════════

show_status() {
  header
  echo -e "${BOLD}${BLUE}${L[status_hdr]}${NC}"
  echo -e "${GRAY}────────────────────────────────────────${NC}"
  status_line

  # Текущие данные из fail2ban-client
  local BANNED=$(sudo fail2ban-client status sshd 2>/dev/null | grep "Currently banned" | awk '{print $NF}')
  local FAILED=$(sudo fail2ban-client status sshd 2>/dev/null | grep "Currently failed" | awk '{print $NF}')
  
  # Исторические данные из базы
  local TOTAL_SSHD=$(sudo sqlite3 /var/lib/fail2ban/fail2ban.sqlite3 "SELECT COUNT(*) FROM bans WHERE jail='sshd'" 2>/dev/null)
  local TOTAL_FAILED=$(sudo sqlite3 /var/lib/fail2ban/fail2ban.sqlite3 "SELECT COUNT(DISTINCT ip) FROM bans WHERE jail='sshd'" 2>/dev/null)

  echo -e "  ${WHITE}${L[ssh_jail]}${NC}"
  echo -e "  ├─ ${L[now_banned_ip]} ${RED}${BOLD}${BANNED:-0}${NC}"
  echo -e "  ├─ ${L[now_failed]} ${YELLOW}${FAILED:-0}${NC}"
  echo -e "  ├─ ${L[total_bans_db]}    ${RED}${TOTAL_SSHD:-0}${NC}"
  echo -e "  └─ ${L[unique_banned]}   ${YELLOW}${TOTAL_FAILED:-0}${NC}"
  echo ""

  # Recidive данные
  local REC_BANNED=$(sudo fail2ban-client status recidive 2>/dev/null | grep "Currently banned" | awk '{print $NF}')
  local REC_FAILED=$(sudo fail2ban-client status recidive 2>/dev/null | grep "Currently failed" | awk '{print $NF}')
  local TOTAL_REC=$(sudo sqlite3 /var/lib/fail2ban/fail2ban.sqlite3 "SELECT COUNT(*) FROM bans WHERE jail='recidive'" 2>/dev/null)
  local RECIDIVISTS=$(sudo sqlite3 /var/lib/fail2ban/fail2ban.sqlite3 "SELECT COUNT(*) FROM (SELECT ip FROM bans WHERE jail='sshd' GROUP BY ip HAVING COUNT(*) >= 2)" 2>/dev/null)

  echo -e "  ${WHITE}${L[rec_jail]}${NC}"
  echo -e "  ├─ ${L[now_banned_ip]} ${RED}${BOLD}${REC_BANNED:-0}${NC}"
  echo -e "  ├─ ${L[on_watch_2]}   ${YELLOW}${RECIDIVISTS:-0}${NC}"
  echo -e "  └─ ${L[total_bans_db]}    ${RED}${TOTAL_REC:-0}${NC}"
  echo ""

  press_enter
}

# ══════════════════════════════════════════════════════════════════
# СПИСОК ЗАБАНЕННЫХ С ТАЙМЕРАМИ
# ══════════════════════════════════════════════════════════════════

show_banned_details() {
  header
  echo -e "${BOLD}${BLUE}${L[banned_timers_hdr]}${NC}"
  echo -e "${GRAY}────────────────────────────────────────${NC}"
  echo ""

  local current_time=$(date +%s)

  # SSH Jail
  local SSHD_IPS=$(sudo fail2ban-client status sshd 2>/dev/null | grep "Banned IP list" | cut -d: -f2)
  if [ -n "$SSHD_IPS" ]; then
    echo -e "  ${WHITE}${L[ssh_jail_pin]}${NC}"
    for IP in $SSHD_IPS; do
      local expires=$(sudo sqlite3 /var/lib/fail2ban/fail2ban.sqlite3 "SELECT timeofban + 3600 FROM bans WHERE jail='sshd' AND ip='$IP' ORDER BY timeofban DESC LIMIT 1" 2>/dev/null)
      if [ -n "$expires" ]; then
        local remaining=$((expires - current_time))
        if [ "$remaining" -gt 0 ]; then
          echo -e "    ${RED}🚫 $IP${NC} ${L[remaining_t]} ${YELLOW}$(format_time $remaining)${NC}"
        else
          echo -e "    ${RED}🚫 $IP${NC} — ${GREEN}${L[unban_soon]}${NC}"
        fi
      else
        echo -e "    ${RED}🚫 $IP${NC}"
      fi
    done
    echo ""
  fi

  # Recidive Jail
  local REC_IPS=$(sudo fail2ban-client status recidive 2>/dev/null | grep "Banned IP list" | cut -d: -f2)
  if [ -n "$REC_IPS" ]; then
    echo -e "  ${WHITE}${L[rec_jail_fire]}${NC}"
    for IP in $REC_IPS; do
      local expires=$(sudo sqlite3 /var/lib/fail2ban/fail2ban.sqlite3 "SELECT timeofban + 604800 FROM bans WHERE jail='recidive' AND ip='$IP' ORDER BY timeofban DESC LIMIT 1" 2>/dev/null)
      if [ -n "$expires" ]; then
        local remaining=$((expires - current_time))
        if [ "$remaining" -gt 0 ]; then
          echo -e "    ${RED}🔥 $IP${NC} ${L[remaining_t]} ${YELLOW}$(format_time $remaining)${NC}"
        else
          echo -e "    ${RED}🔥 $IP${NC} — ${GREEN}${L[unban_soon]}${NC}"
        fi
      else
        echo -e "    ${RED}🔥 $IP${NC}"
      fi
    done
    echo ""
  fi

  # На карандаше
  local REC_FAILED=$(sudo fail2ban-client status recidive 2>/dev/null | grep "Currently failed" | awk '{print $NF}')
  if [ "${REC_FAILED:-0}" -gt 0 ]; then
    echo -e "  ${WHITE}${L[watch_hdr]}${NC}"
    sudo sqlite3 /var/lib/fail2ban/fail2ban.sqlite3 "SELECT ip, COUNT(*) as cnt FROM bans WHERE jail='sshd' GROUP BY ip HAVING cnt >= 2 ORDER BY cnt DESC LIMIT 10" 2>/dev/null | \
      while IFS='|' read IP COUNT; do
        echo -e "    ${YELLOW}⚠️  $IP${NC} — ${WHITE}$COUNT${NC} ${L[ban_count]}"
      done
    echo ""
  fi

  if [ -z "$SSHD_IPS" ] && [ -z "$REC_IPS" ]; then
    echo -e "  ${GREEN}${L[no_banned_ok]}${NC}"
    echo ""
  fi

  press_enter
}

# ══════════════════════════════════════════════════════════════════
# ЛОГИ
# ══════════════════════════════════════════════════════════════════

show_log() {
  header
  echo -e "${BOLD}${BLUE}${L[log_30_hdr]}${NC}"
  echo -e "${GRAY}────────────────────────────────────────${NC}"
  echo ""
  sudo tail -n 30 /var/log/fail2ban.log | while IFS= read -r line; do
    if echo "$line" | grep -q "\[recidive\] Ban"; then
      echo -e "${MAGENTA}${BOLD}$line${NC}"
    elif echo "$line" | grep -q "Ban"; then
      echo -e "${RED}$line${NC}"
    elif echo "$line" | grep -q "Unban"; then
      echo -e "${GREEN}$line${NC}"
    elif echo "$line" | grep -q "\[recidive\] Found"; then
      echo -e "${MAGENTA}$line${NC}"
    elif echo "$line" | grep -q "WARNING\|Found"; then
      echo -e "${YELLOW}$line${NC}"
    elif echo "$line" | grep -q "ERROR"; then
      echo -e "${RED}${BOLD}$line${NC}"
    else
      echo -e "${GRAY}$line${NC}"
    fi
  done
  echo ""
  press_enter
}

# ══════════════════════════════════════════════════════════════════
# СТАТИСТИКА АТАК
# ══════════════════════════════════════════════════════════════════

show_attacks() {
  header
  echo -e "${BOLD}${BLUE}${L[attacks_top_hdr]}${NC}"
  echo -e "${GRAY}────────────────────────────────────────${NC}"
  echo ""
  echo -e "  ${WHITE}${L[most_active]}${NC}"
  echo ""
  
  local RESULT=$(sudo sqlite3 /var/lib/fail2ban/fail2ban.sqlite3 "SELECT ip, COUNT(*) as cnt FROM bans WHERE jail='sshd' GROUP BY ip ORDER BY cnt DESC LIMIT 15" 2>/dev/null)
  
  if [ -n "$RESULT" ]; then
    echo "$RESULT" | while IFS='|' read IP COUNT; do
      if [ "$COUNT" -ge 3 ]; then
        echo -e "    ${RED}🔥 $COUNT ${L[bans_word]}${NC} — ${YELLOW}$IP${NC} ${RED}${L[recidivist]}${NC}"
      elif [ "$COUNT" -ge 2 ]; then
        echo -e "    ${YELLOW}⚠️  $COUNT ${L[bans_word]}${NC} — ${YELLOW}$IP${NC}"
      else
        echo -e "    ${GRAY}   $COUNT ${L[bans_word]}${NC} — ${GRAY}$IP${NC}"
      fi
    done
  else
    echo -e "  ${GRAY}${L[db_empty]}${NC}"
  fi
  
  echo ""
  echo -e "${GRAY}────────────────────────────────────────${NC}"
  
  # Статистика за всё время
  local TOTAL_BANS=$(sudo sqlite3 /var/lib/fail2ban/fail2ban.sqlite3 "SELECT COUNT(*) FROM bans" 2>/dev/null)
  local UNIQUE_IPS=$(sudo sqlite3 /var/lib/fail2ban/fail2ban.sqlite3 "SELECT COUNT(DISTINCT ip) FROM bans" 2>/dev/null)
  local RECIDIVISTS=$(sudo sqlite3 /var/lib/fail2ban/fail2ban.sqlite3 "SELECT COUNT(*) FROM (SELECT ip FROM bans WHERE jail='sshd' GROUP BY ip HAVING COUNT(*) >= 2)" 2>/dev/null)
  
  echo -e "  ${WHITE}${L[total_alltime]}${NC}"
  echo -e "     ${L[bans_label]} ${RED}${TOTAL_BANS:-0}${NC}"
  echo -e "     ${L[unique_ips]} ${YELLOW}${UNIQUE_IPS:-0}${NC}"
  echo -e "     ${L[recidivists_label]} ${RED}${RECIDIVISTS:-0}${NC}"
  echo ""
  
  press_enter
}

# ══════════════════════════════════════════════════════════════════
# БЛОКИРОВКА/РАЗБЛОКИРОВКА
# ══════════════════════════════════════════════════════════════════

unban_ip() {
  header
  echo -e "${BOLD}${BLUE}${L[unban_hdr2]}${NC}"
  echo -e "${GRAY}────────────────────────────────────────${NC}"
  check_password || return
  echo -e "${GRAY}────────────────────────────────────────${NC}"
  echo ""
  
  local SSHD_IPS=$(sudo fail2ban-client status sshd 2>/dev/null | grep "Banned IP list" | cut -d: -f2)
  local REC_IPS=$(sudo fail2ban-client status recidive 2>/dev/null | grep "Banned IP list" | cut -d: -f2)
  
  if [ -z "$SSHD_IPS" ] && [ -z "$REC_IPS" ]; then
    echo -e "  ${GREEN}${L[no_banned2]}${NC}"
  else
    if [ -n "$SSHD_IPS" ]; then
      echo -e "  ${WHITE}SSH Jail:${NC}"
      for IP in $SSHD_IPS; do
        echo -e "    ${RED}🚫 $IP${NC}"
      done
    fi
    if [ -n "$REC_IPS" ]; then
      echo -e "  ${WHITE}Recidive Jail:${NC}"
      for IP in $REC_IPS; do
        echo -e "    ${RED}🔥 $IP${NC}"
      done
    fi
    echo ""
    echo -e -n "  ${WHITE}${L[enter_ip_unban2]}${NC}"
    read TARGET_IP
    if [ -n "$TARGET_IP" ]; then
      sudo fail2ban-client set sshd unbanip "$TARGET_IP" 2>/dev/null
      sudo fail2ban-client set recidive unbanip "$TARGET_IP" 2>/dev/null
      echo -e "  ${GREEN}$(printf "${L[unbanned_ok2]}" "$TARGET_IP")${NC}"
    fi
  fi
  echo ""
  press_enter
}

ban_ip() {
  header
  echo -e "${BOLD}${BLUE}${L[ban_hdr2]}${NC}"
  echo -e "${GRAY}────────────────────────────────────────${NC}"
  check_password || return
  echo -e "${GRAY}────────────────────────────────────────${NC}"
  echo ""
  echo -e -n "  ${WHITE}${L[enter_ip_ban2]}${NC}"
  read TARGET_IP
  if [ -n "$TARGET_IP" ]; then
    echo -e "  ${WHITE}${L[which_jail]}${NC}"
    echo -e "  ${GREEN}${L[jail_sshd_1h]}${NC}"
    echo -e "  ${RED}${L[jail_rec_1w]}${NC}"
    echo -e -n "  ${CYAN}${L[choice]} ${NC}"
    local choice=$(read_key)
    echo "$choice"
    case $choice in
      1) 
        sudo fail2ban-client set sshd banip "$TARGET_IP" 2>/dev/null
        echo -e "  ${RED}$(printf "${L[banned_1h]}" "$TARGET_IP")${NC}"
        ;;
      2)
        sudo fail2ban-client set recidive banip "$TARGET_IP" 2>/dev/null
        echo -e "  ${RED}$(printf "${L[banned_1w]}" "$TARGET_IP")${NC}"
        ;;
      *)
        echo -e "  ${YELLOW}${L[cancelled]}${NC}"
        ;;
    esac
  fi
  echo ""
  press_enter
}

# ══════════════════════════════════════════════════════════════════
# ПЕРЕЗАПУСК
# ══════════════════════════════════════════════════════════════════

restart_f2b() {
  header
  echo -e "${BOLD}${BLUE}${L[restart_hdr]}${NC}"
  echo -e "${GRAY}────────────────────────────────────────${NC}"
  check_password || return
  echo -e "${GRAY}────────────────────────────────────────${NC}"
  echo ""
  echo -e "  ${YELLOW}${L[restart_now]}${NC}"
  sudo systemctl restart fail2ban
  sleep 2
  local STATUS=$(systemctl is-active fail2ban)
  if [ "$STATUS" = "active" ]; then
    echo -e "  ${GREEN}${L[restart_ok]}${NC}"
  else
    echo -e "  ${RED}${L[restart_err]}${NC}"
  fi
  echo ""
  press_enter
}

edit_config() {
  header
  echo -e "${BOLD}${BLUE}${L[edit_cfg_hdr]}${NC}"
  echo -e "${GRAY}────────────────────────────────────────${NC}"
  check_password || return
  echo -e "${GRAY}────────────────────────────────────────${NC}"
  echo ""
  sudo nano /etc/fail2ban/jail.local
  echo ""
  echo -e "  ${YELLOW}${L[restart_apply_q]}${NC}"
  echo -e -n "  ${CYAN}${L[choice]} ${NC}"
  local choice=$(read_key)
  echo "$choice"
  if [[ "$choice" == "y" ]] || [[ "$choice" == "Y" ]] || [[ "$choice" == "д" ]] || [[ "$choice" == "Д" ]]; then
    sudo systemctl restart fail2ban
    sleep 2
    if systemctl is-active --quiet fail2ban; then
      echo -e "  ${GREEN}${L[cfg_restarted]}${NC}"
    else
      echo -e "  ${RED}${L[cfg_err]}${NC}"
    fi
    press_enter
  fi
}

# ══════════════════════════════════════════════════════════════════
# ГЛАВНОЕ МЕНЮ
# ══════════════════════════════════════════════════════════════════

main_menu() {
  local DEF=""
  while true; do
    # Статус fail2ban + счётчики в шапку окошка
    local F2B_STATE=$(systemctl is-active fail2ban)
    local st_color st_text
    if [ "$F2B_STATE" = "active" ]; then
      st_color="\Z2"; st_text="${L[st_active]}"
    else
      st_color="\Z1"; st_text="${L[st_inactive]}"
    fi

    local SSHD_BANNED=$(sudo fail2ban-client status sshd 2>/dev/null | grep "Currently banned" | awk '{print $NF}')
    local REC_BANNED=$(sudo fail2ban-client status recidive 2>/dev/null | grep "Currently banned" | awk '{print $NF}')
    local REC_FAILED=$(sudo sqlite3 /var/lib/fail2ban/fail2ban.sqlite3 "SELECT COUNT(*) FROM (SELECT ip FROM bans WHERE jail='sshd' GROUP BY ip HAVING COUNT(*) >= 2)" 2>/dev/null)

    local STATUS="${st_color}${st_text}\Zn  ($(hostname))\n"
    STATUS="${STATUS}\Z7${L[now_label]}\Zn \Z1${SSHD_BANNED:-0}\Zn ${L[in_sshd2]} \Z1${REC_BANNED:-0}\Zn ${L[in_recidive2]}\n"
    STATUS="${STATUS}       \Z3${REC_FAILED:-0}\Zn ${L[on_watch3]}"

    # Пункт перехода в rn — только если rn установлен
    local rn_item=()
    if [ -x /usr/local/bin/rn ]; then
      rn_item=( "9" "\Z6${L[mm_goto_rn]}\Zn" )
    fi

    dlg_menu "${L[title]}" "$STATUS" "$DEF" \
      "1" "\Z2${L[mm_status]}\Zn" \
      "2" "\Z1${L[mm_banned]}\Zn" \
      "3" "\Z3${L[mm_events]}\Zn" \
      "4" "\Z5${L[mm_attacks]}\Zn" \
      "5" "\Z1${L[mm_ban]}\Zn" \
      "6" "\Z2${L[mm_unban]}\Zn" \
      "7" "\Z3${L[mm_restart]}\Zn" \
      "8" "\Z4${L[mm_config]}\Zn" \
      "${rn_item[@]}"

    # Пусто = Back/Esc = выход
    if [ -z "$DLG_CHOICE" ]; then
      clear
      echo -e "\n  ${CYAN}${L[session_end]}${NC}\n"
      exit 0
    fi
    DEF="$DLG_CHOICE"

    clear
    case $DLG_CHOICE in
      1) show_status ;;
      2) show_banned_details ;;
      3) show_log ;;
      4) show_attacks ;;
      5) ban_ip ;;
      6) unban_ip ;;
      7) restart_f2b ;;
      8) edit_config ;;
      9) 
        if [ -x "/usr/local/bin/rn" ]; then
          exec /usr/local/bin/rn --skip-pin
        else
          dlg_msg "\n\Z1${L[rn_notfound2]}\Zn"
        fi
        ;;
      *) ;;
    esac
  done
}

main_menu
